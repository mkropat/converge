#!/usr/bin/env bash
# review-panel: run a panel of reviewer agents once over the live working
# tree, merge the duplicate findings through a separate merge agent, and
# report. The reviewers file code bugs and spec bugs into the shared bug
# tracker of the run directory; the controller records the coverage the
# panel read, reports the retained findings, and exits. It does not run a
# converge loop.
#
# See docs/review-panel-requirements.md for the required behavior.
set -uo pipefail

# Defer a parent stop during startup until the controller state exists.
EARLY_USR1=0
EARLY_INT=0
on_early_usr1() { EARLY_USR1=1; }
trap on_early_usr1 USR1
on_early_int() { EARLY_INT=1; }
trap on_early_int INT

# The script uses bash 4.3 syntax: parse_profile_list needs the nameref of
# `local -n`. macOS supplies bash 3.2. This test must stay above the first
# use of that syntax, because bash parses a script as it runs.
if ((BASH_VERSINFO[0] < 4)) || \
  ((BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3)); then
  echo "review-panel: bash ${BASH_VERSION} is too old; bash 4.3 or later is needed" >&2
  echo "review-panel: on macOS, run 'brew install bash'" >&2
  exit 2
fi

TIMEOUT=3600
HELP_REQUESTED=0
SELF="$(cd "$(dirname "$0")" && pwd)/${0##*/}"
# bin/cbugs lives beside this script. Every agent needs it on its PATH, and
# the controller calls it by path, so that no PATH change of the operator
# moves the bug tracker away from the panel.
BIN_DIR="$(dirname "$SELF")"

usage() {
  cat >&2 <<'EOF'
Usage: review-panel [options] [scope ...]

Options:
  --timeout <seconds>     Maximum duration of one reviewer or merge-agent
                          invocation. Default: 3600.

A positional argument names a requirements document file or a directory of
them. This is the scope: the reviewers judge the requirements in those
paths only. With no positional argument, each reviewer finds the
requirements documents under the run directory itself.

The panel reviews the live working tree, with every uncommitted change and
every relevant untracked file in it. Each configured reviewer runs once,
and the reviewers run at the same time. A separate merge agent combines
the duplicate findings. The panel reports the result and exits; it does
not run a converge loop.

Profiles come from the environment only:

  CONVERGE_REVIEW_PANEL_PROFILE  Ordered, comma-separated list of reviewer
                                 profiles, of the form harness:model[:effort].
                                 Unset, the command uses
                                 CONVERGE_REVIEWER_PROFILE. Unset, that
                                 defaults to claude:opus.
  CONVERGE_REVIEW_PANEL_MERGE_PROFILE
                                 Ordered, comma-separated merge profiles.
                                 Unset, the command uses the first reviewer
                                 profile.

An explicitly empty variable is an error, not a request for the default.
Duplicate canonical reviewer profiles are rejected. Unknown options are
rejected and never reach a harness.
EOF
}

need_value() {
  if (($2 < 2)); then
    echo "review-panel: $1 needs a value" >&2
    exit 2
  fi
}

SCOPE=()
while (($#)); do
  case $1 in
    # The command accepts no passthrough: every argument after -- is
    # rejected by name, never sent to a harness (RP-INV-5).
    --)
      shift
      if (($#)); then
        for arg in "$@"; do
          echo "review-panel: unexpected argument '$arg' after --; review-panel accepts no passthrough" >&2
        done
        exit 2
      fi
      ;;
    --timeout) need_value "$1" $#; TIMEOUT=$2; shift 2 ;;
    --timeout=*) TIMEOUT=${1#*=}; shift ;;
    -h|--help)
      HELP_REQUESTED=1
      shift
      ;;
    # An option this script does not know is a typo: there is no passthrough
    # left for it to reach (RP-INV-5).
    -*)
      echo "review-panel: unknown option '$1'" >&2
      exit 2
      ;;
    # A positional argument names part of the requirements scope.
    *)
      SCOPE+=("$1")
      shift
      ;;
  esac
done

# is_number <text>   True when the text is a whole number.
is_number() {
  [[ $1 =~ ^[0-9]+$ ]]
}

# fits_bash_integer <text>   True when a whole number fits in bash arithmetic.
fits_bash_integer() {
  local value=$1
  while [[ ${value:0:1} == 0 && ${#value} -gt 1 ]]; do
    value=${value:1}
  done
  ((${#value} < 19)) || \
    { ((${#value} == 19)) && [[ $value < 9223372036854775808 ]]; }
}

# The scope paths and the timeout must hold before any agent starts
# (RP-INV-1, RP-PROF-5). A typo must not become a review that silently
# ignores the scope. The timeout follows the same validation as converge.
for scope_path in ${SCOPE[@]+"${SCOPE[@]}"}; do
  if [[ ! -e $scope_path ]]; then
    echo "review-panel: scope path '$scope_path' does not exist" >&2
    exit 2
  fi
done
if ! is_number "$TIMEOUT"; then
  echo "review-panel: --timeout needs a whole number, got '$TIMEOUT'" >&2
  exit 2
fi
if ! fits_bash_integer "$TIMEOUT"; then
  echo "review-panel: --timeout exceeds the supported integer range" >&2
  exit 2
fi
# A leading zero reads as octal in bash arithmetic. Normalize here, before
# any use of the value, so no leading zero ever reaches an arithmetic context.
TIMEOUT=$((10#$TIMEOUT))

# The run directory is the current working directory of the operator, as it
# is for converge (CV-INV-9). The script never changes its own working
# directory, so every relative path that follows, and the initial working
# directory of every agent, stays anchored there (RP-INV-6).
# Resolve the shell's logical PWD before asking git or deriving state. The
# shell may retain a symlink path when the operator entered through one, so
# cbugs and converge canonicalize it with pwd -P (CB-DB-2).
RUN_DIR="$(cd -P . && pwd -P)"
REPO=""
REPO=$(git -C "$RUN_DIR" rev-parse --show-toplevel 2>/dev/null) || REPO=""

# The state directory follows the same rule that converge and cbugs use for
# a run directory: the name of the repository, the path of the run directory
# within it, and a hash of the absolute path (RP-REL-3). The panel therefore
# reads and writes the same state, the same logs directory, and the same
# bug database that converge uses.
#
# The agents need the GNU timeout and the GNU setsid that converge uses,
# and Homebrew keeps them off the normal PATH on macOS. Put them on the PATH
# of this script and of the agents it starts, the same way converge does
# (CV-PLAT-4).
#
# This prepend happens before the panel derives the state directory name
# (CB-DB-2): the hash below prefers md5sum, and converge and cbugs run the
# prepend before their own hash, so the prepend order decides which hash one
# run directory gets. Doing it late makes the panel fall back to cksum on a
# plain macOS PATH while cbugs hashes with md5sum, and one run directory would
# then hold two state directories.
for brew_prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
  [[ -n $brew_prefix ]] || continue
  for bin_dir in "$brew_prefix/opt/coreutils/libexec/gnubin" \
                 "$brew_prefix/opt/util-linux/bin"; do
    [[ -d $bin_dir ]] && PATH="$bin_dir:$PATH"
  done
done
hash_path() {
  if command -v md5sum >/dev/null 2>&1; then
    printf '%s' "$1" | md5sum | cut -c1-12
  else
    printf '%s' "$1" | cksum | tr -d ' ' | cut -c1-12
  fi
}
STATE_REPO=${REPO:-$RUN_DIR}
if [[ -z $REPO || $RUN_DIR == "$STATE_REPO" ]]; then
  RUN_SUBPATH=""
else
  RUN_SUBPATH="${RUN_DIR#"$STATE_REPO"/}"
fi
if [[ -n $STATE_REPO ]]; then
  SLUG="${STATE_REPO##*/}${RUN_SUBPATH:+-${RUN_SUBPATH//\//-}}-$(hash_path "$RUN_DIR")"
else
  SLUG="$(hash_path "$RUN_DIR")"
fi
if [[ -z ${XDG_STATE_HOME:-} && -z ${HOME:-} ]]; then
  echo "review-panel: set HOME or XDG_STATE_HOME; review-panel keeps its state there" >&2
  exit 2
fi
OWN_STATE_DIR="${XDG_STATE_HOME:-${HOME:-}/.local/state}/converge/$SLUG"
if [[ -d $OWN_STATE_DIR ]]; then
  # Match cbugs: an existing state directory for this run takes precedence
  # over every ancestor, including the repository root (RP-REL-3, CB-DB-8).
  STATE_DIR=$OWN_STATE_DIR
elif [[ -n $REPO && $RUN_DIR == "$REPO" ]]; then
  STATE_DIR=$OWN_STATE_DIR
  WALK_ANCESTORS=0
  STATE_LIMIT=$RUN_DIR
else
  WALK_ANCESTORS=1
  STATE_LIMIT=${REPO:-/}
  STATE_DIR=""
  ancestor=${RUN_DIR%/*}
  [[ -n $ancestor ]] || ancestor=/
  while ((WALK_ANCESTORS)); do
    candidate_repo=$(git -C "$ancestor" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$ancestor")
    candidate_subpath=""
    [[ $ancestor == "$candidate_repo" ]] || candidate_subpath="${ancestor#"$candidate_repo"/}"
    candidate_slug="${candidate_repo##*/}${candidate_subpath:+-${candidate_subpath//\//-}}-$(hash_path "$ancestor")"
    candidate_state="${XDG_STATE_HOME:-${HOME:-}/.local/state}/converge/$candidate_slug"
    if [[ -d $candidate_state ]]; then
      STATE_DIR=$candidate_state
      break
    fi
    [[ $ancestor == "$STATE_LIMIT" ]] && break
    parent=${ancestor%/*}
    [[ -n $parent ]] || parent=/
    [[ $parent == "$ancestor" ]] && break
    ancestor=$parent
  done
  [[ -n $STATE_DIR ]] || STATE_DIR=$OWN_STATE_DIR
fi
LOG_DIR="$STATE_DIR/logs"
# The panel keeps its own event log, so that its lines and a running
# converge loop's lines never overwrite one another (RP-RUN-4).
# The temporary directory holds only what a running process needs now: the
# stream pipe of the merge agent, and the runtime record each reviewer
# invocation writes about itself. The system removes the directory, so a
# dead panel leaves nothing behind (CV-RUN-4).
RUNTIME_DIR="${TMPDIR:-/tmp}/converge/$SLUG"

if ! mkdir -p "$LOG_DIR" "$RUNTIME_DIR"; then
  echo "review-panel: cannot make the state directory or the runtime directory; check XDG_STATE_HOME, HOME, and TMPDIR" >&2
  exit 2
fi
chmod 700 "$RUNTIME_DIR" 2>/dev/null || true

# need_tool <command> [macOS Homebrew formula]
need_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "review-panel: '$1' is not on PATH" >&2
    if [[ -n ${2:-} ]]; then
      echo "review-panel: on macOS, run 'brew install $2'" >&2
    fi
    exit 2
  fi
}
for pair in jq:jq timeout:coreutils setsid:util-linux flock:util-linux tail:coreutils; do
  need_tool "${pair%%:*}" "${pair##*:}"
done
# The BSD tools of the same names accept none of the options the panel uses,
# so a name on the PATH is not enough; each tool proves itself (CV-PLAT-5).
if ! timeout --version >/dev/null 2>&1; then
  echo "review-panel: this 'timeout' is not GNU timeout" >&2
  echo "review-panel: on macOS, run 'brew install coreutils'" >&2
  exit 2
fi
if ! setsid --version >/dev/null 2>&1; then
  echo "review-panel: this 'setsid' is not GNU setsid" >&2
  echo "review-panel: on macOS, run 'brew install util-linux'" >&2
  exit 2
fi
if ! flock --version >/dev/null 2>&1; then
  echo "review-panel: this 'flock' is not GNU flock" >&2
  echo "review-panel: on macOS, run 'brew install util-linux'" >&2
  exit 2
fi
if ! tail --version >/dev/null 2>&1; then
  echo "review-panel: this 'tail' is not GNU tail" >&2
  echo "review-panel: on macOS, run 'brew install coreutils'" >&2
  exit 2
fi

# ----------------------------------------------------------------- appearance
#
# The panel always writes color and UTF-8 characters, the way converge does:
# its output belongs in a terminal (CV-OUT-9).

BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'
RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
BLUE=$'\033[34m'; MAGENTA=$'\033[35m'; CYAN=$'\033[36m'; WHITE=$'\033[97m'

G_TL="╭"; G_TR="╮"; G_BL="╰"; G_BR="╯"; G_H="─"; G_V="│"; G_RULE="━"
G_BAR="▌"; G_DOT="·"; G_ARROW="›"; G_ELL="…"
G_OK="✓"; G_ERR="✗"; G_WARN="▲"; G_CLOCK="◷"
G_WORKER="⚙"; G_COACH="◎"; G_REVIEW="◐"
G_GUT="┆"; G_READ="○"; G_EDIT="◆"; G_SHELL="❯"; G_SAY="▍"
E_OK="🏁"; E_WARN="▲"; E_STOP="🛑"

# width  Reports the usable width of the output, between 40 and 96 columns.
width() {
  local cols
  cols=$(tput cols 2>/dev/null) || cols=80
  is_number "$cols" || cols=80
  ((cols < 40)) && cols=40
  ((cols > 96)) && cols=96
  printf '%s' "$cols"
}
COLS="${CONVERGE_COLS:-$(width)}"
GUT_WIDTH=$((COLS - 6))

# repeat <character> <count>
repeat() {
  local out
  (($2 > 0)) || return 0
  printf -v out '%*s' "$2" ''
  printf '%s' "${out// /$1}"
}

# fit <width> <text>   Shortens text from the middle to the given width.
fit() {
  local max=$1 text=$2 head tail
  ((max < 8)) && max=8
  if ((${#text} <= max)); then
    printf '%s' "$text"
    return
  fi
  head=$(((max - 1) / 2))
  tail=$((max - 1 - head))
  printf '%s%s%s' "${text:0:head}" "$G_ELL" "${text: -tail}"
}

# home_relative <path>   Rewrites a path inside $HOME as a ~/ path.
home_relative() {
  local path=$1
  if [[ -n ${HOME:-} ]]; then
    if [[ $path == "$HOME" ]]; then
      printf '~'
      return
    elif [[ $path == "$HOME"/* ]]; then
      printf '%s/%s' '~' "${path#"$HOME"/}"
      return
    fi
  fi
  printf '%s' "$path"
}

# duration <seconds>   Formats a duration for a person: 4m 12s.
duration() {
  local total=$1 h m s
  h=$((total / 3600)); m=$(((total % 3600) / 60)); s=$((total % 60))
  if ((h > 0)); then printf '%dh %02dm %02ds' "$h" "$m" "$s"
  elif ((m > 0)); then printf '%dm %02ds' "$m" "$s"
  else printf '%ds' "$s"; fi
}

# panel <title> <label|value> ...   Draws the startup panel. A row whose
# label names something an operator reads — the run directory, a path, or
# the scope — prints its value whole, and runs past the border when it does
# not fit, the way converge draws its panel. Style must not remove
# information (CV-OUT-11).
panel() {
  local title=$1; shift
  local inner=0 row label value line pad dashes raw=0
  for row in "$@"; do
    label=${row%%|*}
    value=${row#*|}
    case $label in
      "run dir"|"run log"|"state dir"|"bug db"|logs|scope|reviewers|merge|source)
        if ((11 + ${#value} <= COLS - 17)); then
          printf -v line '%-10s %s' "$label" "$value"
          ((${#line} > inner)) && inner=${#line}
        fi
        ;;
      *)
        printf -v line '%-10s %s' "$label" "$(fit $((COLS - 17)) "$value")"
        ((${#line} > inner)) && inner=${#line}
        ;;
    esac
  done
  ((inner < ${#title} + 4)) && inner=$((${#title} + 4))

  dashes=$((inner - ${#title} - 1))
  printf '\n%s%s%s%s %s%s%s %s%s%s%s\n' \
    "$DIM" "$G_TL" "$G_H" "$OFF" \
    "$BOLD$CYAN" "$title" "$OFF" \
    "$DIM" "$(repeat "$G_H" "$dashes")" "$G_TR" "$OFF"
  for row in "$@"; do
    label=${row%%|*}
    value=${row#*|}
    raw=0
    case $label in "run dir"|"run log"|"state dir"|"bug db"|logs|scope|reviewers|merge|source) raw=1 ;; esac
    if ((raw)) && ((11 + ${#value} > inner)); then
      printf '%s%s%s %s%-10s%s %s\n' \
        "$DIM" "$G_V" "$OFF" \
        "$DIM" "$label" "$OFF" "$value"
      continue
    fi
    if ((raw)); then
      printf -v line '%-10s %s' "$label" "$value"
    else
      value=$(fit $((COLS - 17)) "$value")
      printf -v line '%-10s %s' "$label" "$value"
    fi
    pad=$((inner - ${#line}))
    printf '%s%s%s %s%-10s%s %s%s %s%s%s\n' \
      "$DIM" "$G_V" "$OFF" \
      "$DIM" "$label" "$OFF" "$value" "$(repeat ' ' "$pad")" \
      "$DIM" "$G_V" "$OFF"
  done
  printf '%s%s%s%s%s\n' "$DIM" "$G_BL" "$(repeat "$G_H" $((inner + 2)))" "$G_BR" "$OFF"
}

# heading <color> <text> <right text>   Draws a section rule.
heading() {
  local color=$1 text=$2 right=$3 dashes
  dashes=$((COLS - ${#text} - ${#right} - 6))
  ((dashes < 1)) && dashes=1
  printf '\n%s%s%s %s%s%s %s%s %s%s\n' \
    "$color" "$G_BAR" "$OFF" \
    "$BOLD" "$text" "$OFF" \
    "$DIM" "$(repeat "$G_H" "$dashes")" "$right" "$OFF"
}

# banner <color> <glyph> <text>   Draws the closing report.
banner() {
  local color=$1 glyph=$2 text=$3
  printf '\n%s%s%s\n' "$color$DIM" "$(repeat "$G_RULE" "$COLS")" "$OFF"
  printf ' %s  %s%s%s\n' "$glyph" "$BOLD$color" "$text" "$OFF"
  printf '%s%s%s\n\n' "$color$DIM" "$(repeat "$G_RULE" "$COLS")" "$OFF"
}

# plural <count> <word>   Adds an "s" to the word when the count is not one.
plural() {
  if (($1 == 1)); then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi
}

# scope_list   Renders the scope paths as the operator wrote them, for a
# prompt or the startup panel.
scope_list() {
  local out="" path
  for path in ${SCOPE[@]+"${SCOPE[@]}"}; do
    if [[ -z $out ]]; then out=$path; else out="$out, $path"; fi
  done
  printf '%s' "$out"
}

# join_list <item>...   Joins its arguments with ", ", for a profile list.
join_list() {
  local out="" item
  for item in ${@+"$@"}; do
    if [[ -z $out ]]; then out=$item; else out="$out, $item"; fi
  done
  printf '%s' "$out"
}

# wrap <width> <text>   Breaks text on spaces into lines of at most <width>.
wrap() {
  local width=$1 line="" word
  local -a words=()
  read -ra words <<<"$2"
  if ((${#words[@]} == 0)); then
    printf '\n'
    return
  fi
  for word in "${words[@]}"; do
    if [[ -z $line ]]; then
      line=$word
    elif ((${#line} + 1 + ${#word} <= width)); then
      line="$line $word"
    else
      printf '%s\n' "$line"
      line=$word
    fi
  done
  printf '%s\n' "$line"
}

# strip_style <text>   Removes the ANSI color codes that gutter embeds.
strip_style() {
  sed -E $'s/\x1b\\[[0-9;]*m//g' <<<"$1"
}

# STREAM_LABEL   The full text that names the concurrent invocation that
# the stream belongs to. It carries this run's id, reviewer position, and
# full canonical profile. format_stream sets it for its own subshell.
# STREAM_DISPLAY_LABEL carries the role and full profile for the terminal.
# It must not contain the run id or invocation id (RP-OUT-11). gutter prints
# it before every transcript line and tags the event log with the full label
# (RP-OUT-2, RP-OUT-9).
# The merge stream uses the merge role and profile.
STREAM_LABEL=""
STREAM_DISPLAY_LABEL=""

# gutter <color> <marker> <text> <tag>   Prints one transcript line, behind a
# rule, and writes the same line to the event log as plain text (CV-OUT-11).
# When STREAM_LABEL is set, the display carries STREAM_DISPLAY_LABEL before
# the line, and the event log tag carries STREAM_LABEL, so a reader can tell
# which invocation wrote the line (RP-OUT-2).
gutter() {
  local marker=$2 tag=${4:-} text=$3
  if [[ -z $marker && -z $3 ]]; then
    printf '  %s%s%s\n' "$DIM" "$G_GUT" "$OFF"
    return
  fi
  [[ -z $marker ]] && marker=" "
  if [[ -n $STREAM_LABEL ]]; then
    [[ -n $tag ]] && tag="$STREAM_LABEL $tag" || tag=$STREAM_LABEL
    printf '  %s%s%s %s%s%s %s%s%s %s%s\n' \
      "$DIM" "$G_GUT" "$OFF" "$1" "$marker" "$OFF" \
      "$DIM" "$STREAM_DISPLAY_LABEL" "$OFF" "$text" "$OFF"
  else
    printf '  %s%s%s %s%s%s %s%s\n' \
      "$DIM" "$G_GUT" "$OFF" "$1" "$marker" "$OFF" "$text" "$OFF"
  fi
  if [[ -n $tag ]]; then
    note "[$tag] $(strip_style "$3")"
  else
    note "$(strip_style "$3")"
  fi
}

# trim <text>   Strips leading and trailing whitespace.
trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

# ------------------------------------------------------------------- harness
#
# A profile is harness:model[:effort]. The rules of CV-HARN-9 and CV-HARN-10
# apply (RP-PROF-3). The explicit efforts that the claude harness accepts
# come from converge. opencode's --variant is provider-specific, so any
# syntactically valid field is accepted and passed through unvalidated.
CLAUDE_EFFORTS=(low medium high xhigh max)

# split_profile <canonical profile>   Splits a validated profile into
# SPLIT_HARNESS, SPLIT_MODEL, and SPLIT_EFFORT (empty when omitted).
split_profile() {
  local -a fields=()
  IFS=':' read -ra fields <<<"$1"
  SPLIT_HARNESS=${fields[0]}
  SPLIT_MODEL=${fields[1]}
  SPLIT_EFFORT=${fields[2]:-}
}

# parse_profile_list <role> <raw value> <array name>
# Splits a comma-separated profile list, trims each entry, validates its
# harness:model[:effort] form and its effort against the selected harness,
# and rejects a duplicate canonical profile within the role (RP-PROF-3).
# Writes the trimmed, validated entries into the named array.
parse_profile_list() {
  local role=$1 raw=$2 arrname=$3
  local -n out=$arrname
  out=()
  local -a parts=()
  if [[ $raw == *$'\n'* || $raw == *$'\r'* ]]; then
    echo "review-panel: $role profile list must use commas between entries" >&2
    exit 2
  fi
  # A plain "IFS=','read -ra" silently drops a trailing empty entry, so
  # "claude:opus," would parse as the single entry "claude:opus" instead of
  # being rejected for its empty trailing entry. Splitting on newlines with
  # mapfile keeps that trailing empty entry.
  mapfile -t parts <<<"${raw//,/$'\n'}"
  local -A seen=()
  local entry harness model effort e ok
  for entry in "${parts[@]}"; do
    entry=$(trim "$entry")
    if [[ ! $entry =~ ^(claude|opencode|codex):[^:,[:space:]]+(:[^:,[:space:]]+)?$ ]]; then
      echo "review-panel: $role profile '$entry' must be claude:model[:effort], opencode:model[:effort], or codex:model[:effort], with nonempty fields and no colon, comma, or whitespace" >&2
      exit 2
    fi
    split_profile "$entry"
    harness=$SPLIT_HARNESS model=$SPLIT_MODEL effort=$SPLIT_EFFORT
    if [[ -n $effort && $harness == claude ]]; then
      ok=0
      for e in "${CLAUDE_EFFORTS[@]}"; do [[ $e == "$effort" ]] && { ok=1; break; }; done
      ((ok)) || {
        echo "review-panel: $role profile '$entry' has an effort claude does not support; use one of: ${CLAUDE_EFFORTS[*]}" >&2
        exit 2
      }
    fi
    if [[ -n ${seen[$entry]:-} ]]; then
      echo "review-panel: $role profile list repeats '$entry'" >&2
      exit 2
    fi
    seen[$entry]=1
    out+=("$entry")
  done
}

# resolve_reviewer_env   CV-HARN-16 and RP-PROF-7: CONVERGE_REVIEW_PANEL_PROFILE
# selects the reviewer list; unset, the command uses CONVERGE_REVIEWER_PROFILE;
# unset, that defaults to the converge reviewer default, claude:opus (RP-PROF-2):
# an explicitly empty selected variable is an error, not a request for a
# fallback.
resolve_reviewer_env() {
  if [[ -n ${CONVERGE_REVIEW_PANEL_PROFILE+x} ]]; then
    if [[ -z $CONVERGE_REVIEW_PANEL_PROFILE ]]; then
      echo "review-panel: CONVERGE_REVIEW_PANEL_PROFILE is set but empty; give a comma-separated profile list" >&2
      exit 2
    fi
    REVIEWER_RAW=$CONVERGE_REVIEW_PANEL_PROFILE
  elif [[ -n ${CONVERGE_REVIEWER_PROFILE+x} ]]; then
    if [[ -z $CONVERGE_REVIEWER_PROFILE ]]; then
      echo "review-panel: CONVERGE_REVIEWER_PROFILE is set but empty; give a comma-separated profile list" >&2
      exit 2
    fi
    REVIEWER_RAW=$CONVERGE_REVIEWER_PROFILE
  else
    REVIEWER_RAW="claude:opus"
  fi
}

# resolve_merge_env <fallback>   RP-PROF-13: resolve the ordered merge
# profile list; unset, use the first resolved reviewer profile.
resolve_merge_env() {
  local fallback=$1
  if [[ -z ${CONVERGE_REVIEW_PANEL_MERGE_PROFILE+x} ]]; then
    MERGE_PROFILE_RAW=$fallback
  else
    if [[ -z $CONVERGE_REVIEW_PANEL_MERGE_PROFILE ]]; then
      echo "review-panel: CONVERGE_REVIEW_PANEL_MERGE_PROFILE is set but empty; give one or more profiles" >&2
      exit 2
    fi
    MERGE_PROFILE_RAW=$CONVERGE_REVIEW_PANEL_MERGE_PROFILE
  fi
}

# reject_retired_panel_env   RP-PROF-9, under CV-HARN-16: the panel takes its
# profiles from the CONVERGE variables alone. A set retired variable is an
# error that names its replacement, before any agent starts (RP-PROF-5).
reject_retired_panel_env() {
  if [[ -n ${REVIEW_PANEL_PROFILES+x} ]]; then
    echo "review-panel: REVIEW_PANEL_PROFILES is retired; use CONVERGE_REVIEW_PANEL_PROFILE" >&2
    exit 2
  fi
  if [[ -n ${REVIEW_PANEL_MERGE_PROFILE+x} ]]; then
    echo "review-panel: REVIEW_PANEL_MERGE_PROFILE is retired; use CONVERGE_REVIEW_PANEL_MERGE_PROFILE" >&2
    exit 2
  fi
}

# harness_argv <harness> <model> <effort> <prompt>
# Sets ARGV to the command that runs one non-interactive invocation, with
# permission prompts disabled, and with a message stream on stdout, the way
# converge starts its agents (RP-REL-4). An empty effort omits the flag, so
# the harness applies its own default (CV-HARN-10). No check tests that the
# harness command is on PATH, so a missing harness fails its invocation
# itself (CV-OOS-32).
harness_argv() {
  local harness=$1 model=$2 effort=$3 prompt=$4
  case $harness in
    claude)
      ARGV=(claude --print --output-format stream-json --verbose
        --model "$model" --dangerously-skip-permissions)
      [[ -z $effort ]] || ARGV+=(--effort "$effort")
      ARGV+=("$prompt")
      ;;
    opencode)
      ARGV=(opencode run --format json --model "$model" --auto)
      [[ -z $effort ]] || ARGV+=(--variant "$effort")
      ARGV+=("$prompt")
      ;;
    codex)
      ARGV=(codex exec --json --ephemeral
        --dangerously-bypass-approvals-and-sandbox --cd "$PWD" --model "$model")
      [[ -z $effort ]] || ARGV+=(--config "model_reasoning_effort=\"$effort\"")
      ARGV+=("$prompt")
      ;;
  esac
}

# ---------------------------------------------------------------------- logs
#
# The panel keeps one event log beside the bug database, one transcript per
# invocation in the logs directory, and the prompt of each invocation beside
# its transcript. The names carry the panel run id, so that two panel runs
# and a converge loop never overwrite one another's files (RP-RUN-4).

# The id is needed by the run log path too; resolve it before selecting any
# per-run log files. The timestamp, PID, and random suffix distinguish
# overlapping invocations, including calls started in the same second.
PANEL_ID="panel-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
LOOKUP_FILE="$STATE_DIR/$PANEL_ID.requirements-lookup.txt"
LOOKUP_RESULT="$STATE_DIR/$PANEL_ID.discovery.result"
LOOKUP_TEXT=""

# decode_tsv_field <value>   Undo jq @tsv escaping without interpreting
# ordinary backslashes as printf %b escape sequences.
decode_tsv_field() {
  local value=$1 output='' char next i=0
  while ((i < ${#value})); do
    char=${value:i:1}
    if [[ $char == \\ && $((i + 1)) -lt ${#value} ]]; then
      ((i++))
      next=${value:i:1}
      case $next in
        \\) output+='\\' ;;
        t) output+=$'\t' ;;
        n) output+=$'\n' ;;
        r) output+=$'\r' ;;
        *) output+="\\$next" ;;
      esac
    else
      output+=$char
    fi
    ((i++))
  done
  REPLY=$output
}
RUN_LOG="$STATE_DIR/review-panel-$PANEL_ID.log"
RUN_START=$SECONDS
SEQ=0

# note <message>  Records in the panel event log only. Each line carries the
# panel run id, so a reader of a shared state directory knows which run
# wrote the line (RP-OUT-9). Include the session's selected canonical
# profiles in each event, so the event log remains self-describing even
# when read without the terminal startup panel (RP-OUT-9).
note() {
  # Signals can arrive after the traps are installed but before profile
  # resolution. Keep early stop reporting safe under nounset.
  local -a note_reviewers=()
  if declare -p REVIEWER_PROFILES >/dev/null 2>&1; then
    note_reviewers=("${REVIEWER_PROFILES[@]+${REVIEWER_PROFILES[@]}}")
  fi
  local note_merge=${MERGE_PROFILE:-unresolved}
  printf '%s %s reviewers=%s merge=%s %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PANEL_ID" \
    "$(join_list "${note_reviewers[@]}")" "$note_merge" "$1" >>"$RUN_LOG"
}
info() {
  printf '  %s%s%s %s\n' "$DIM" "$G_DOT" "$OFF" "$1"
  note "$1"
}
good() {
  printf '  %s%s%s %s\n' "$GREEN" "$G_OK" "$OFF" "$1"
  note "$1"
}
warn() {
  printf '  %s%s %s%s\n' "$YELLOW" "$G_WARN" "$1" "$OFF" >&2
  note "$1"
}
bad() {
  printf '  %s%s %s%s\n' "$RED" "$G_ERR" "$1" "$OFF" >&2
  note "$1"
}

# invocation_event <role> <profile> <harness> <model> <effort> <file>
# Writes the event record that opens a transcript, so a reader of the .jsonl
# file alone can tell the panel run, the role, and the full canonical
# profile that produced it (RP-OUT-2, RP-OUT-9).
invocation_event() {
  local role=$1 profile=$2 harness=$3 model=$4 effort=$5 file=$6
  jq -nc --arg run "$PANEL_ID" --arg role "$role" --arg profile "$profile" \
    --arg harness "$harness" --arg model "$model" --arg effort "$effort" \
    '{type:"review_panel_event",event:"invocation",run:$run,role:$role,
      profile:$profile,harness:$harness,model:$model,
      effort:(if $effort == "" then null else $effort end)}' \
    >"$file"
}

# wait_child <pid>   Waits for a background process to exit, and returns its
# exit status. A trapped signal makes wait return early, so this retries
# until the process is truly gone.
wait_child() {
  local pid=$1 status
  wait "$pid" 2>/dev/null; status=$?
  while ((status >= 128)) && kill -0 "$pid" 2>/dev/null; do
    wait "$pid" 2>/dev/null; status=$?
  done
  return "$status"
}

# show_stderr <log-file stem>
# Shows the last lines that an invocation wrote to stderr. A failure with
# no messages puts its cause there (CV-OUT-8).
show_stderr() {
  local invocation=$2
  local line
  [[ -s "$1.err" ]] || return 0
  while IFS= read -r line; do
    [[ -z ${line// } ]] && continue
    printf '  %s%s %s: %s%s\n' "$RED" "$G_GUT" "$invocation" "$(fit "$GUT_WIDTH" "$line")" "$OFF" >&2
    note "$invocation stderr: $line"
  done < <(tail -n 3 "$1.err")
}

# --------------------------------------------------------------------- scope
#
# The scope follows the rules of the converge scope section (RP-REL-2, RP-INV-2):
# a scoped reviewer judges the requirements in the given paths only, and a
# path that is a directory names every requirements document under it. An
# unscoped reviewer finds the requirements documents itself.

reviewer_scope_line() {
  if ((${#SCOPE[@]})); then
    printf 'You judge them against these requirements documents only, and no other: %s. A path that is a directory names every requirements document under it. A change that contradicts a requirements document outside this scope is still a spec bug, not a code bug.' "$(scope_list)"
  else
    printf 'Use the accepted lookup instructions below to read current requirements. Do not repeat discovery or select replacement sources.'
  fi
}

reviewer_prompt() {
  local scope_line
  scope_line=$(reviewer_scope_line)
  cat <<EOF
You are a reviewer in a review panel for this repository. The panel starts
every reviewer it has at the same time, and each reviewer runs once. You
check the code against the requirements and file bugs. Another reviewer
works beside you; what they find has no effect on what you report.

This review judges the live working tree, not a commit range: judge the
code as it stands now, including uncommitted changes and relevant untracked
files. The tree can move while you work; judge what you read, and never
assume another reviewer examined identical content.

1. Read the code relevant to the requirements, and the requirements they
   belong to. ${scope_line}
2. Run \`cbugs search <text>\` before you log anything. Log nothing that an
   open bug already names.
3. For each defect in the code (behavior that contradicts a requirement, an
   unhandled case, or a regression), log
   \`cbugs add --kind code --title <text>\` with \`--cite <path>[:<id>]\` or \`--cite <uri>\`
   naming the requirement the code violates. If you cannot name the
   requirement, you have found no code defect; consider whether you have
   found a spec bug instead.
4. When the code reveals a requirement that is ambiguous, absent, or in
   conflict with another, log \`cbugs add --kind spec --title <text>\`,
   cite each document and requirement that raised the question with
   \`--cite <path>[:<id>]\` or \`--cite <uri>\`, and say in the note what you could not decide
   and why the code raised it.
5. Log nothing when you find nothing. Finding no defect is a normal result,
   and an invented defect costs a worker a whole iteration.

Rules: file your findings directly with \`cbugs\`, and nothing else. Do not
fix code, edit requirements or guidance files, close or dismiss a bug, log
a task (the command refuses it from an agent), or create a commit.
EOF
  if ((${#SCOPE[@]} == 0)) && [[ -n $LOOKUP_TEXT ]]; then
    printf '\nResolved requirements lookup instructions for this panel run:\n\n%s\n' "$LOOKUP_TEXT"
  fi
  printf '\nRead current source content during this review.\n'
  printf 'If a required source is unavailable, report an incomplete review.\n'
  printf 'Do not choose a replacement source.\n'
  printf 'Cite the original local path or source URI for each code bug.\n'
}

merge_prompt() {
  local findings=$1 self_list=${2:-0}
  if ((self_list)); then
    cat <<EOF
You are the merge agent of a review panel for this repository. The panel's
reviewer agents have finished and filed their findings directly into the
bug tracker. You combine the duplicates. You are not a reviewer: you do not
read the code, and you file no finding.

The panel run is $PANEL_ID. The controller could not read the bugs that
this panel run created, so no list of them is given here, and the first
step below collects it. A bug belongs to this panel run when the first
revision of the bug records this run as its creator, and
\`cbugs list --panel-run $PANEL_ID\` shows exactly those bugs, one line
per bug in the form id, kind, status, title.

1. Collect the bugs of this panel run now, with
   \`cbugs list --panel-run $PANEL_ID\`. If the command answers with
   nothing, this panel run created no bug, and your work is done.
2. Read each bug of the list with \`cbugs show <id>\`. Then read the bugs
   that could overlap with them, with \`cbugs list\` and
   \`cbugs search <text>\`. The tracker holds bugs of other panel runs and
   of converge runs too.
3. Combine two bugs only when they describe the same defect. Preserve every
   distinct finding.
4. For each duplicate set, choose the visible bug with the smallest numeric
   id as the retained bug. Use the same choice even when another run created
   it; do not dismiss that bug. This deterministic choice keeps overlapping
   merge agents from dismissing each other's retained findings. Keep exactly
   one retained bug for each duplicate set, and keep the
   retained bug in the status it holds: a bug that is still open stays
   open. For each duplicate, write
   \`cbugs dismiss <id> --note <text>\`
   where the note names the id of the retained bug and explains the
   duplicate relationship. You may dismiss only bugs this panel run
   created: never dismiss or close a bug that a different run created.
5. When a duplicate held evidence, note text, or requirement citations
   that the retained bug lacks, write
   \`cbugs note <retained-id> <text> --cite <path>[:<id>]\` or \`--cite <uri>\`
   on the retained bug, so that the unique part of the duplicate survives
   where readers look.
 6. Before you change a bug, read it again with \`cbugs show <id>\`. Other
    agents write the same database at the same time. Judge the bug as it is
    now, and write your revision below whatever a concurrent writer wrote.

Visibility: the normal \`cbugs list\` and \`cbugs search\` output shows
the bugs that are visible at the repository HEAD, and each row holds the
bug's current state. The command \`cbugs list --panel-run $PANEL_ID\`
returns every bug of this panel run and marks the hidden ones with a
hidden mark. You may inspect hidden history with \`cbugs list
--visibility all\` and \`cbugs show <id>\`, but a bug that is hidden now
does not read as a current duplicate. If the retained bug of a duplicate
set is hidden, move the retained finding onto a bug that is visible, or
leave the finding on a visible bug of your own choosing; do not leave
this panel run's finding represented only by a bug that remains hidden.

Rules: change bug records and nothing else. Do not fix code, do not edit
requirements or guidance files, do not file a new bug, do not run
\`cbugs close\` (a closure records that the defect is gone, and you did no
such work), and do not log a task (the command refuses it from an agent).
A duplicate set must still hold one retained bug when you are done.
EOF
    return
  fi
  cat <<EOF
You are the merge agent of a review panel for this repository. The panel's
reviewer agents have finished and filed their findings directly into the
bug tracker. You combine the duplicates. You are not a reviewer: you do not
read the code, and you file no finding.

Panel run: $PANEL_ID. Every bug below was created by this panel run. Each
line gives its id, its kind, and its current status:

$findings

1. Read each bug above with \`cbugs show <id>\`. Then read the bugs that
   could overlap with them, with \`cbugs list\` and \`cbugs search <text>\`.
   The tracker holds bugs of other panel runs and of converge runs too.
2. Combine two bugs only when they describe the same defect. Preserve every
   distinct finding.
3. For each duplicate set, choose the visible bug with the smallest numeric
   id as the retained bug. Use the same choice even when another run created
   it; do not dismiss that bug. This deterministic choice keeps overlapping
   merge agents from dismissing each other's retained findings. Keep exactly
   one retained bug for each duplicate set, and keep the
   retained bug in the status it holds: a bug that is still open stays
   open. For each duplicate, write
   \`cbugs dismiss <id> --note <text>\`
   where the note names the id of the retained bug and explains the
   duplicate relationship. You may dismiss only bugs this panel run
   created: never dismiss or close a bug that a different run created.
4. When a duplicate held evidence, note text, or requirement citations
   that the retained bug lacks, write
   \`cbugs note <retained-id> <text> --cite <path>[:<id>]\` or \`--cite <uri>\`
   on the retained bug, so that the unique part of the duplicate survives
   where readers look.
 5. Before you change a bug, read it again with \`cbugs show <id>\`. Other
    agents write the same database at the same time. Judge the bug as it is
    now, and write your revision below whatever a concurrent writer wrote.

Visibility: the normal \`cbugs list\` and \`cbugs search\` output shows
the bugs that are visible at the repository HEAD, and each row holds the
