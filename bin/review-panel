does not read as a current duplicate. If the retained bug of a duplicate
set is hidden, move the retained finding onto a bug that is visible, or
leave the finding on a visible bug of your own choosing; do not leave
this panel run's finding represented only by a bug that remains hidden.

Rules: change bug records and nothing else. Do not fix code, do not edit
requirements or guidance files, do not file a new bug, do not run
\`cbugs close\` (a closure records that the defect is gone, and you did no
such work), and do not log a task (the command refuses it from an agent).
A duplicate set must still hold one retained bug when you are done.
EOF
}

# --------------------------------------------------------------- transcript
#
# The merge agent writes its transcript while it works, the way a converge
# invocation does (RP-OUT-2). The reviewers run at the same time, so their
# transcripts stay whole in their own log files: several live streams in
# one terminal could not keep every line attributable to its source.
#
# The message stream of a harness gives one JSON object per line. A filter
# turns each object into one tab-separated record, and the reader below
# turns each record into one line for the operator. Text that a filter
# cannot parse is dropped, so a partial line cannot stop the transcript.

TRANSCRIPT_ACCENT=$CYAN
FINAL_DRAWN=0

# say_text <text>   Writes one line that the agent wrote.
say_text() {
  local line
  [[ -z ${1// } ]] && return 0
  while IFS= read -r line; do
    gutter "$DIM" "" "$DIM$line$OFF" "text"
  done < <(wrap "$GUT_WIDTH" "$1")
}

# say_final <color> <text>   Writes one line of the final message.
say_final() {
  local line
  [[ -z ${2// } ]] && return 0
  while IFS= read -r line; do
    gutter "$1" "$G_SAY" "$BOLD$line$OFF" "final"
  done < <(wrap $((GUT_WIDTH - 2)) "$2")
}

# say_stats <turns> <seconds> <cost>   Writes the totals of an invocation.
# An empty <cost> means the agent reported no cost, so the line shows nothing
# where it cannot show a cost (CV-COST-1: absent is not a recorded zero).
say_stats() {
  local text
  text="$(plural "$1" turn) $G_DOT $(duration "$2")"
  [[ -n $3 ]] && text="$text $G_DOT $(fmt_usd "$3")"
  gutter "$DIM" "" "$DIM$text$OFF" "stats"
}

# render_tool <name> <argument> <lines>   Writes one line for a tool call.
# When the transcript shortens a shell command that had more than one line,
# the shortened text can hide the break, so the line names the count.
render_tool() {
  local name=$1 arg=$2 lines=${3:-1} budget suffix=""
  is_number "$lines" || lines=1
  # The repository prefix is only shortened for the tools whose main argument
  # is a path. A shell command reaches the operator as the agent wrote it:
  # shortening it wordlessly, even by a prefix, would hide text (CV-OUT-3.2).
  if [[ ${name,,} != bash ]]; then
    arg=${arg#"$REPO"/}
  fi
  budget=$((GUT_WIDTH - ${#name} - 1))
  if [[ ${name,,} == bash && $lines -gt 1 && ${#arg} -gt $budget ]]; then
    suffix=" ($lines lines)"
    budget=$((budget - ${#suffix}))
  fi
  arg=$(fit "$budget" "$arg")$suffix
  # Each harness names its tools in its own case.
  case ${name,,} in
    write|edit|multiedit|notebookedit|patch)
      gutter "$YELLOW" "$G_EDIT" "$YELLOW$name$OFF $arg" "tool" ;;
    bash)
      gutter "$CYAN" "$G_SHELL" "$arg" "tool" ;;
    *)
      gutter "$DIM" "$G_READ" "$DIM$name $arg$OFF" "tool" ;;
  esac
}

# render_fail <cause>   Writes one line for a tool call that failed.
render_fail() {
  gutter "$RED" "$G_ERR" "$RED$(fit "$GUT_WIDTH" "$1")$OFF" "fail"
}

# dispatch_held <held item> <finalize 0|1>
# Renders one item that was held to keep its place in the order (opencode
# only): text, tagged "text", a tool call, tagged "tool", or a failed tool
# call, tagged "fail". Only text can be the final message, so a finalize
# draws the separator once, ahead of the first final line.
dispatch_held() {
  local held=$1 finalize=$2 sub body name arg lines body2
  sub=${held%%$'\t'*}
  body=${held#*$'\t'}
  [[ $body == "$held" ]] && body=""
  case $sub in
    tool)
      name=${body%%$'\t'*}
      body2=${body#*$'\t'}
      [[ $body2 == "$body" ]] && body2=""
      lines=${body2%%$'\t'*}
      arg=${body2#*$'\t'}
      [[ $arg == "$body2" ]] && arg=""
      render_tool "$name" "$arg" "$lines"
      ;;
    fail)
      render_fail "$body"
      ;;
    *)
      if ((finalize)); then
        if ((FINAL_DRAWN == 0)); then
          FINAL_DRAWN=1
          gutter "$DIM" "" ""
        fi
        say_final "$TRANSCRIPT_ACCENT" "$body"
      else
        say_text "$body"
      fi
      ;;
  esac
}

# add <a> <b>   Adds two costs. The shell has no arithmetic for fractions.
add() {
  awk -v a="$1" -v b="$2" 'BEGIN { printf "%.10f", a + b }'
}

# fmt_usd <cost>   Prints a cost in USD. Six decimals, so that a small
# nonzero cost stays distinct from zero (CV-COST-8), the way converge
# renders every recorded cost (RP-REL-4).
fmt_usd() {
  printf '$%.6f' "$1"
}

# DECIMAL_RE   The shape of a recorded cost. An absent cost stays absent:
# a value that is not a decimal names no cost, and never shows as zero,
# the same way converge treats a harness that reports none (CV-COST-1).
DECIMAL_RE='^-?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$'

CLAUDE_FILTER='
def clean: gsub("[\\t\\r]"; " ");
def firstline: split("\n")[0] // "";
def tool_arg:
  if (.command != null) then
    (.command | tostring | split("\n")) as $ls
    | {text: ($ls | map(clean) | join(" ↵ ")), lines: ($ls | length)}
  else
    {text: ((.file_path // .pattern // .path // .url // .query // .description // "")
            | tostring | firstline | clean), lines: 1}
  end;
fromjson? // empty
| if (.type == "system") and (.subtype == "init") then
    "init\tsession \((.session_id // "unknown")[0:8])"
  elif .type == "assistant" then
    ((.message.content // []) | if type == "array" then .[] else empty end)
    | if .type == "text" then
        ((.text // "") | split("\n")[] | "text\t" + clean)
      elif .type == "tool_use" then
        (((.input // {}) | tool_arg) as $a
         | "tool\t\(.name // "tool")\t\($a.lines)\t\($a.text)")
      else empty end
  elif .type == "user" then
    ((.message.content // []) | if type == "array" then .[] else empty end)
    | select((.type == "tool_result") and (.is_error == true))
    | ((.content // "") | if type == "array" then (map(.text // "") | join(" ")) else tostring end)
    | firstline | "fail\t" + clean
  elif .type == "result" then
    ((if (.result // "") == "" then empty
      else (.result | split("\n")[] | "final\t" + clean) end),
     (if .total_cost_usd == null
      then "stats\t\(.num_turns // 0)\t\(.duration_ms // 0)"
      else "stats\t\(.num_turns // 0)\t\(.duration_ms // 0)\t\(.total_cost_usd)" end))
  else empty end
'

# opencode ends a message with a step_finish, whose reason tells the reader
# whether the text of the step was the final message, so the reader holds
# the text until then. A tool call can happen between two held lines of
# text, so it is held too, tagged with its own kind.
OPENCODE_FILTER='
def clean: gsub("[\\t\\r]"; " ");
def firstline: split("\n")[0] // "";
def tool_arg:
  if (.command != null) then
    (.command | tostring | split("\n")) as $ls
    | {text: ($ls | map(clean) | join(" ↵ ")), lines: ($ls | length)}
  else
    {text: ((.filePath // .pattern // .path // .url // .query // .description // "")
            | tostring | firstline | clean), lines: 1}
  end;
fromjson? // empty
| if .type == "step_start" then
    "init\tsession \((.sessionID // "unknown")[0:8])"
  elif .type == "text" then
    ((.part.text // "") | split("\n")[] | "hold\ttext\t" + clean)
  elif .type == "tool_use" then
    (.part.state // {}) as $state
    | select(($state.status == "completed") or ($state.status == "error"))
    | ((($state.input // {}) | tool_arg) as $a
       | "hold\ttool\t\(.part.tool // "tool")\t\($a.lines)\t\($a.text)"),
      (select($state.status == "error")
       | (($state.error // "tool error") | tostring | firstline
          | "hold\tfail\t" + clean))
  elif .type == "step_finish" then
    "tally\t\(.part.cost // "")",
    (if (.part.reason // "") == "stop" then "release\tfinal"
     else "release\ttext" end)
  else empty end
'

# Codex emits one JSON event per line. Keep its emitted stream in the log and
# normalize completed messages, command results, and file changes for display.
CODEX_FILTER='
def clean: gsub("[\\t\\r]"; " ");
def firstline: split("\n")[0] // "";
fromjson? // empty
| if .type == "thread.started" then
    "init\tsession \((.thread_id // "unknown")[0:8])"
  elif .type == "item.completed" and .item.type == "agent_message" then
    "hold\ttext\t" + ((.item.text // "") | tojson)
  elif .type == "item.completed" and .item.type == "command_execution" then
    ((.item.command // "") | split("\n")) as $command
    | "tool\tbash\t\($command | length)\t\($command | map(clean) | join(" ↵ "))",
    (if ((.item.exit_code // 0) != 0)
     then "fail\tcommand exited \(.item.exit_code): \((.item.aggregated_output // "") | firstline | clean)"
     else empty end)
  elif .type == "item.completed" and .item.type == "file_change" then
    (.item.changes // [])[]
    | "tool\t\((.kind // "file_change") | tostring)\t1\t\(.path // "")"
  elif .type == "item.completed" and .item.type == "error" then
    "fail\t" + ((.item.message // "Codex error") | tostring | firstline | clean)
  elif .type == "error" or .type == "turn.failed" then
    "fail\t" + ((.message // .error.message // "Codex turn failed") | tostring | firstline | clean)
  elif .type == "turn.completed" then "tally\t", "release\tfinal"
  else empty end
'

# stream_filter   Reports the filter of the harness of the running agent.
stream_filter() {
  case $INVOCATION_HARNESS in
    claude) printf '%s' "$CLAUDE_FILTER" ;;
    opencode) printf '%s' "$OPENCODE_FILTER" ;;
    codex) printf '%s' "$CODEX_FILTER" ;;
  esac
}

# format_stream <color>
# Reads a message stream on stdin. Writes a transcript for the operator.
format_stream() {
  local accent=$1 cost_log=${2:-}
  jq --unbuffered -R -r "$(stream_filter)" 2>/dev/null | {
    local record kind rest rest2 name arg lines line turns ms cost
    local as_final started=-1 first=1 counted=0 sum=0 reported=0 stream_cost=0
    local reported_cost='' cost_out
    local -a hold=()
    while IFS= read -r record; do
      ((started < 0)) && started=$SECONDS
      kind=${record%%$'\t'*}
      rest=${record#*$'\t'}
      [[ $rest == "$record" ]] && rest=""
      case $kind in
        init)
          # A harness that reports no start reports one for each step instead.
          ((first)) || continue
          first=0
          gutter "$DIM" "" "$DIM$rest$OFF" "init"
          ;;
        text)
          say_text "$rest"
          ;;
        hold)
          if [[ $INVOCATION_HARNESS == codex ]]; then
            local held_text
            held_text=$(jq -nr --arg encoded "${rest#*$'\t'}" '$encoded | fromjson')
            hold+=("text"$'\t'"$held_text")
          else
            hold+=("$rest")
          fi
          ;;
        release)
          as_final=0
          [[ $rest == final ]] && as_final=1
          if ((as_final)) && [[ $INVOCATION_HARNESS == codex ]] && ((${#hold[@]})); then
            for ((i=0; i<${#hold[@]}-1; i++)); do
              dispatch_held "${hold[i]}" 0
            done
            dispatch_held "${hold[${#hold[@]}-1]}" 1
          else
            for line in ${hold[@]+"${hold[@]}"}; do
              dispatch_held "$line" "$as_final"
            done
          fi
          hold=()
          ;;
        tally)
          ((++counted))
          # A step that carries no cost leaves the sum alone (CV-COST-1).
          if [[ $rest =~ $DECIMAL_RE ]]; then
            stream_cost=1
            sum=$(add "$sum" "$rest")
          fi
          ;;
        tool)
          name=${rest%%$'\t'*}
          rest2=${rest#*$'\t'}
          [[ $rest2 == "$rest" ]] && rest2=""
          lines=${rest2%%$'\t'*}
          arg=${rest2#*$'\t'}
          [[ $arg == "$rest2" ]] && arg=""
          render_tool "$name" "$arg" "$lines"
          ;;
        fail)
          render_fail "$rest"
          ;;
        final)
          if ((FINAL_DRAWN == 0)); then
            FINAL_DRAWN=1
            gutter "$DIM" "" ""
          fi
          say_final "$accent" "$rest"
          ;;
        stats)
          IFS=$'\t' read -r turns ms cost <<<"$rest"
          is_number "$ms" || ms=0
          is_number "$turns" || turns=0
          reported=1
          # A cost column that is absent, empty, or not a decimal names no
          # harness total, and shows nothing (CV-COST-1).
          if [[ $cost =~ $DECIMAL_RE ]]; then
            reported_cost=$cost
          else
            reported_cost=""
          fi
          say_stats "$turns" $((ms / 1000)) "$reported_cost"
          ;;
      esac
    done
    # A harness that reports no totals leaves them to the reader. The stream
    # ends when the agent ends, so the time here is the time of the agent.
    for line in ${hold[@]+"${hold[@]}"}; do
      dispatch_held "$line" 0
    done
    if ((reported == 0 && counted > 0)); then
      # The sum is a recorded cost only if at least one step carried one.
      if ((stream_cost)); then
        say_stats "$counted" $((SECONDS - started)) "$sum"
      else
        say_stats "$counted" $((SECONDS - started)) ""
      fi
    fi
    # CV-COST-10: with a log given, the recorded cost of this invocation is
    # appended to it as the last converge_event line, so the controller
    # reads it back when the invocation ends and writes the cost to the
    # shared ledger. A value that is not a decimal lands as an empty
    # record: absent cost is a record with no cost data, and never a
    # recorded zero (CV-COST-1).
    if ((reported)); then
      cost_out=$reported_cost
    elif ((stream_cost)); then
      cost_out=$sum
    else
      cost_out=""
    fi
    if [[ -n ${cost_log:-} ]]; then
      [[ $cost_out =~ $DECIMAL_RE ]] || cost_out=""
      printf '{"type":"converge_event","event":"cost_record","record":"%s"}\n' \
        "$cost_out" >>"$cost_log" 2>/dev/null
    fi
  }
}

# ------------------------------------------------------------------- signals
#
# The panel follows the applicable converge stop conventions (RP-OUT-8): the
# first Ctrl-C, or a graceful USR1 request of the parent loop (CV-FAIL-13),
# lets the running agents finish and starts nothing further; a second
# Ctrl-C stops the panel and its own agents at once, with status 130; a
# SIGTERM stops the panel with status 143. An interrupted panel must not
# claim completion (RP-OUT-6). The cleanup touches only the processes this
# panel started, each of which leads its own process group, so another run
# keeps working (RP-RUN-4).

STOP_REQUESTED=0
HARD_STOP=0
SIGNAL_STATUS=130
REVIEWED_PID=0
FORMATTER=0
AGENT_PIDS=()
# A graceful stop may arrive between the final launch check and registering
# the child in AGENT_PIDS. Defer traps only across that small launch window,
# then deliver the pending stop before any subsequent invocation can start.
LAUNCH_CRITICAL=0
PENDING_INT=0
PENDING_USR1=0
PENDING_TERM=0

kill_agents() {
  local pid
  # Include live background jobs as well as registered agent PIDs. Bash may
  # run a signal trap between launching a child and appending $! above.
  local -a owned_pids=()
  owned_pids+=("${AGENT_PIDS[@]+${AGENT_PIDS[@]}}")
  while IFS= read -r pid; do owned_pids+=("$pid"); done < <(jobs -pr)
  for pid in ${owned_pids[@]+"${owned_pids[@]}"}; do
    kill -0 "$pid" 2>/dev/null || continue
    # The setsid child leads its own process group, so one signal reaches
    # its timeout and every agent under it. The plain kill is the fallback
    # for a child whose group lead already exited.
    kill -TERM -"$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  done
  # Transcript readers are owned descendants too. A reader may be waiting
  # for a FIFO writer at open time, so pair TERM with a short-lived writer
  # before removing each registered FIFO.
  for pid in ${FORMATTERS[@]+"${FORMATTERS[@]}"}; do
    [[ $pid =~ ^[0-9]+$ ]] && ((pid > 0)) || continue
    local fifo=${FORMATTER_FIFOS[$pid]:-}
    [[ -n $fifo ]] && ( : >"$fifo" ) 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  done
  if [[ ${FORMATTER:-0} =~ ^[0-9]+$ ]] && ((FORMATTER > 0)); then
    local fifo="$RUNTIME_DIR/panel-stream-$PANEL_ID"
    [[ -p $fifo ]] && ( : >"$fifo" ) 2>/dev/null || true
    kill -TERM "$FORMATTER" 2>/dev/null || true
  fi
}

on_int() {
  if ((LAUNCH_CRITICAL)); then
    ((PENDING_INT == 0)) && PENDING_INT=1 || PENDING_INT=2
    return
  fi
  if ((STOP_REQUESTED == 0)); then
    STOP_REQUESTED=1
    warn "stop requested; the running agents finish, and no further invocation starts; press Ctrl-C again to stop at once"
    # Coverage is not an agent invocation. Stop an in-flight writer so an
    # interrupted run cannot leave a committed reviewed record (RP-COV-5).
    if [[ $REVIEWED_PID =~ ^[0-9]+$ ]] && ((REVIEWED_PID > 0)); then
      kill -TERM -"$REVIEWED_PID" 2>/dev/null || kill -TERM "$REVIEWED_PID" 2>/dev/null || true
    fi
    return
  fi
  HARD_STOP=1
  SIGNAL_STATUS=130
  kill_agents
}
on_usr1() {
  if ((LAUNCH_CRITICAL)); then
    PENDING_USR1=1
    return
  fi
  if ((STOP_REQUESTED == 0)); then
    STOP_REQUESTED=1
    warn "parent stop requested; the running agents finish, and no further invocation starts"
    # Coverage is not an agent invocation: it is an in-flight database
    # transaction. Stop its process group so SQLite rolls back an unfinished
    # reviewed-add transaction before the controller exits (RP-COV-5).
    if [[ $REVIEWED_PID =~ ^[0-9]+$ ]] && ((REVIEWED_PID > 0)); then
      kill -TERM -"$REVIEWED_PID" 2>/dev/null || kill -TERM "$REVIEWED_PID" 2>/dev/null || true
    fi
  fi
}
on_term() {
  if ((LAUNCH_CRITICAL)); then
    PENDING_TERM=1
    return
  fi
  if ((HARD_STOP == 0)); then
    HARD_STOP=1
    SIGNAL_STATUS=143
    warn "received SIGTERM; stopping at once"
    kill_agents
    # Coverage is a controller-owned child too. Stop its process group so an
    # interrupted reviewed-add transaction cannot commit after this run stops.
    if [[ $REVIEWED_PID =~ ^[0-9]+$ ]] && ((REVIEWED_PID > 0)); then
      kill -TERM -"$REVIEWED_PID" 2>/dev/null || kill -TERM "$REVIEWED_PID" 2>/dev/null || true
    fi
  fi
}

trap on_int INT
trap on_usr1 USR1
trap on_term TERM
if ((EARLY_INT)); then on_int; fi
if ((EARLY_USR1)); then on_usr1; fi

finish_launch_critical() {
  LAUNCH_CRITICAL=0
  if ((PENDING_TERM)); then
    PENDING_TERM=0
    on_term
  elif ((PENDING_INT == 2)); then
    PENDING_INT=0
    STOP_REQUESTED=1
    on_int
  elif ((PENDING_INT == 1)); then
    PENDING_INT=0
    on_int
  elif ((PENDING_USR1)); then
    PENDING_USR1=0
    on_usr1
  fi
}

# ------------------------------------------------------------------ coverage
#
# The controller records the coverage that the panel read, and no agent
# records one: a call of reviewed add from an agent of the panel stops with
# an error (CB-RVW-7, RP-COV-2). The controller calls the tool outside the
# role environment that agents get, and keeps CONVERGE_RUN_DIR anchored to
# the run directory (RP-INV-6). The commit list that the capture read at
# startup is the commit list the panel records, whatever HEAD does later
# (RP-COV-4).

# record_reviewed <profile> <completed-at>   Appends one coverage record per
# captured commit, under the profile of one successful reviewer (RP-COV-3).
record_reviewed() {
  local profile=$1 completed_at=$2 status=0 out_file="$RUNTIME_DIR/coverage-$PANEL_ID.out"
  printf '%s\n' "${PENDING_HASHES[@]:-}" |
    setsid env -u CONVERGE_ROLE -u CONVERGE_ITERATION \
      CONVERGE_RUN_DIR="$RUN_DIR" \
      "$BIN_DIR/cbugs" reviewed add \
      --profile "$profile" --completed-at "$completed_at" >"$out_file" &
  REVIEWED_PID=$!
  wait "$REVIEWED_PID" || status=$?
  REVIEWED_PID=0
  out=$(cat "$out_file" 2>/dev/null || true)
  rm -f "$out_file"
  if ((STOP_REQUESTED || HARD_STOP)); then
    warn "coverage recording stopped for profile $profile after an operator stop"
    return 1
  fi
  if ((status != 0)); then
    warn "cbugs reviewed add failed for profile $profile; the panel recorded no coverage for it"
    return 1
  fi
  note "coverage recorded: profile=$profile $out"
  return 0
}

# record_invocation_cost <role> <profile> <log>   Appends one line for one
# reviewer or merge invocation to the cost ledger (CV-COST-10). The
# parent loop passes its existing CONVERGE_SESSION and an explicit absolute
# CONVERGE_COST_LEDGER path; with no parent context, a standalone panel
# records under its own cost session and state-directory ledger
# (RP-COST-4), which the startup cost-context setup provides. The row uses the
# converge ledger fields: session, role, canonical profile, cost. Panel
# reviewers use the reviewer cost role, and merge calls use the distinct
# merge cost role. The append holds the shared ledger lock. An absent cost
# is a record with no cost data, and never a recorded zero (CV-COST-1);
# unknown costs stay absent, not zero.
record_invocation_cost() {
  [[ -n $COST_SESSION && -n $COST_LEDGER ]] || return 0
  local role=$1 profile=$2 log=$3 cost_record
  cost_record=""
  if [[ -s $log ]]; then
    cost_record=$(jq -Rsr 'split("\n") | map(fromjson? // empty)
      | map(select(.type == "converge_event" and .event == "cost_record")
        | (.record // ""))
      | last // ""' "$log" 2>/dev/null) || cost_record=""
  fi
  [[ $cost_record =~ $DECIMAL_RE ]] || cost_record=""
  if ! {
    flock -x 9 &&
      printf '%s\t%s\t%s\t%s\n' "$COST_SESSION" "$role" "$profile" "$cost_record" >>"$COST_LEDGER"
  } 9>>"$COST_LEDGER" 2>/dev/null; then
    warn "cannot append to the cost ledger $COST_LEDGER; this invocation's cost stays out of the summaries"
    note "cost record failed: role=$role profile=$profile"
    COST_RECORD_FAILED=1
    return 1
  fi
  note "cost recorded: role=$role profile=$profile cost=${cost_record:-absent}"
}

# run_discovery <profile> selects requirements once and records the call.
run_discovery() {
  local profile=$1 started=$SECONDS stem fifo
  split_profile "$profile"
  local harness=$SPLIT_HARNESS model=$SPLIT_MODEL effort=$SPLIT_EFFORT
  printf -v seq '%04d' $((++SEQ))
  stem="$PANEL_ID-$seq-discovery"
  DISCOVERY_LOG="$LOG_DIR/$stem.jsonl"
  local prompt
  prompt=$(cat <<EOF
Follow the applicable project instructions to locate the requirements for this repository. If those instructions give no discovery rule, find requirements documents under the run directory. Sources can be local documents or external sources that this harness can read.

Write specific lookup instructions to this file only when you can identify usable sources: $LOOKUP_FILE

The instructions must name the selected sources and explain how to read their current requirements. Resolve choices such as issue identities from branch names. State how to follow linked sources. Resolve every path against the run directory. The output must contain lookup instructions only. Do not write a requirements summary, implementation plan, or instruction to repeat general discovery.

Do not change anything except the supplied output file. Do not edit repository files, requirements, project instructions, or guidance. Do not commit. Do not write bugs. If you cannot identify usable sources, leave the output file absent and explain the failure in your final message.
EOF
)
  harness_argv "$harness" "$model" "$effort" "$prompt"
  INVOCATION_HARNESS=$harness
  invocation_event discovery "$profile" "$harness" "$model" "$effort" "$DISCOVERY_LOG"
  printf '%s\n' "$prompt" >"$LOG_DIR/$stem.prompt.md"
  note "discovery start: profile=$profile log=$DISCOVERY_LOG prompt=$LOG_DIR/$stem.prompt.md"
  print_start_line "$G_REVIEW" "discovery" "$profile" "$DISCOVERY_LOG"
  if ((STOP_REQUESTED || HARD_STOP)); then
    DISCOVERY_STATUS=$SIGNAL_STATUS
    return 0
  fi

  fifo="$RUNTIME_DIR/panel-stream-$PANEL_ID-$stem"
  rm -f "$fifo"
  if ! mkfifo "$fifo" 2>/dev/null; then
    DISCOVERY_STATUS=1
    warn "discovery $profile cannot create the stream pipe"
    return 0
  fi
  STREAM_LABEL="panel $PANEL_ID requirements discovery profile $profile invocation $stem"
  STREAM_DISPLAY_LABEL="discovery $profile"
  ( trap - INT TERM; tee -a "$DISCOVERY_LOG" <"$fifo" | format_stream "$CYAN" "$DISCOVERY_LOG" ) &
  FORMATTER=$!
  FORMATTERS+=("$FORMATTER")
  FORMATTER_FIFOS[$FORMATTER]=$fifo
  LAUNCH_CRITICAL=1
  (
    trap '' INT
    exec setsid env -u CONVERGE_ITERATION -u CONVERGE_SESSION \
      -u CONVERGE_DAEMON -u CONVERGE_COST_LEDGER \
      CONVERGE_ROLE=discovery CONVERGE_RUN_DIR="$RUN_DIR" \
      REVIEW_PANEL_RUN="$PANEL_ID" REVIEW_PANEL_PROFILE="$profile" \
      REVIEW_PANEL_INVOCATION="$stem" PATH="$AGENT_PATH" \
      timeout --foreground -k 10 "$TIMEOUT" "${ARGV[@]}"
  ) >"$fifo" 2>>"$LOG_DIR/$stem.err" </dev/null &
  DISCOVERY_PID=$!
  AGENT_PIDS+=("$DISCOVERY_PID")
  finish_launch_critical
  DISCOVERY_STATUS=0
  wait_child "$DISCOVERY_PID" || DISCOVERY_STATUS=$?
  wait_child "$FORMATTER" 2>/dev/null || true
  unset 'FORMATTER_FIFOS[$FORMATTER]'
  FORMATTERS=()
  FORMATTER=0
  STREAM_LABEL=""
  STREAM_DISPLAY_LABEL=""
  rm -f "$fifo"
  DISCOVERY_SECONDS=$((SECONDS - started))
  if ((DISCOVERY_STATUS == 124 || DISCOVERY_STATUS == 137)); then
    warn "discovery $profile exceeded the ${TIMEOUT}s timeout; killed it"
    show_stderr "$LOG_DIR/$stem" "discovery $profile"
    printf '{"type":"review_panel_event","event":"timeout","run":"%s","seconds":%s}\n' "$PANEL_ID" "$TIMEOUT" >>"$DISCOVERY_LOG"
  elif ((DISCOVERY_STATUS != 0)); then
    warn "discovery $profile exited with status $DISCOVERY_STATUS after $(duration "$DISCOVERY_SECONDS")"
    show_stderr "$LOG_DIR/$stem" "discovery $profile"
    printf '{"type":"review_panel_event","event":"error","run":"%s","status":%s}\n' "$PANEL_ID" "$DISCOVERY_STATUS" >>"$DISCOVERY_LOG"
  else
    good "discovery $profile finished in $(duration "$DISCOVERY_SECONDS")"
  fi
  note "discovery end: profile=$profile status=$DISCOVERY_STATUS seconds=$DISCOVERY_SECONDS"
  record_invocation_cost discovery "$profile" "$DISCOVERY_LOG" || true
}

# run_discovery_chain <profiles...>
# Start with the first worker profile. A nonzero exit starts the next entry.
# A timeout, success, or operator stop ends the chain.
run_discovery_chain() {
  local profile
  for profile in "$@"; do
    if ((STOP_REQUESTED || HARD_STOP)); then
      DISCOVERY_STATUS=$SIGNAL_STATUS
      return 0
    fi
    rm -f "$LOOKUP_FILE"
    DISCOVERY_PROFILE=$profile
    run_discovery "$profile"
    if ((DISCOVERY_STATUS == 0 || DISCOVERY_STATUS == 124 || DISCOVERY_STATUS == 137 || STOP_REQUESTED || HARD_STOP)); then
      return 0
    fi
  done
}

# print_cost_summary   Reports this panel session and cumulative ledger costs
# on every graceful panel exit (CV-COST-6 through CV-COST-8).
print_cost_summary() {
  local kind key sn sv cn cv i
  local -A role_n=() role_v=() cum_n=() cum_v=()
  local -a profiles=() ps=() pv=() pc=() p_cv=() labels=() left=() right=()
  local total_sn=0 total_sv=0 total_cn=0 total_cv=0 lw=0 sw=7 cw=10
  [[ -n $COST_LEDGER ]] || return 0
  while IFS=$'\t' read -r kind key sn sv cn cv; do
    case $kind in
      ROLE) role_n[$key]=$sn; role_v[$key]=$sv; cum_n[$key]=$cn; cum_v[$key]=$cv ;;
      PROF) profiles+=("$key"); ps+=("$sn"); pv+=("$sv"); pc+=("$cn"); p_cv+=("$cv") ;;
      TOTAL) total_sn=$sn; total_sv=$sv; total_cn=$cn; total_cv=$cv ;;
    esac
  done < <(awk -F '\t' -v SESSION="$COST_SESSION" '
    { if (NF > 4 || (NF != 4 && $0 !~ "\t$")) next
      c=$4; if (c !~ /^-?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/) c=""
      r=$2; p=$3
      if ($1 == SESSION) { if (!(p in seen)) { pk[++np]=p; seen[p]=1 }
        if (c != "") { srn[r]++; srp[r]+=c; spn[p]++; spp[p]+=c; stn++; stp+=c } }
      if (c != "") { crn[r]++; crp[r]+=c; cpn[p]++; cpp[p]+=c; ctn++; ctp+=c }
    }
    END { OFS="\t"; split("worker reviewer coach discovery", roles, " ")
      for (i=1;i<=4;i++) { r=roles[i]; print "ROLE",r,srn[r]+0,(srn[r]?sprintf("%.6f",srp[r]/srn[r]):"0"),crn[r]+0,(crn[r]?sprintf("%.6f",crp[r]/crn[r]):"0") }
      for (i=1;i<=np;i++) { p=pk[i]; print "PROF",p,spn[p]+0,(spn[p]?sprintf("%.6f",spp[p]):"0"),cpn[p]+0,(cpn[p]?sprintf("%.6f",cpp[p]):"0") }
      print "TOTAL","total",stn+0,sprintf("%.6f",stp+0),ctn+0,sprintf("%.6f",ctp+0)
    }' "$COST_LEDGER" 2>/dev/null)
  cost_cell() { (($1 > 0)) && fmt_usd "$2" || printf '—'; }
  labels+=("Total spend"); left+=("$(cost_cell "$total_sn" "$total_sv")"); right+=("$(cost_cell "$total_cn" "$total_cv")")
  for key in worker reviewer coach discovery; do
    labels+=("Average per $key invocation")
    left+=("$(cost_cell "${role_n[$key]:-0}" "${role_v[$key]:-0}")")
    right+=("$(cost_cell "${cum_n[$key]:-0}" "${cum_v[$key]:-0}")")
  done
  for ((i=0;i<${#profiles[@]};i++)); do
    labels+=("${profiles[i]}"); left+=("$(cost_cell "${ps[i]}" "${pv[i]}")"); right+=("$(cost_cell "${pc[i]}" "${p_cv[i]}")")
  done
  for ((i=0;i<${#labels[@]};i++)); do
    ((${#labels[i]}>lw)) && lw=${#labels[i]}; ((${#left[i]}>sw)) && sw=${#left[i]}; ((${#right[i]}>cw)) && cw=${#right[i]}
  done
  info "cost summary (USD)"
  printf '  %-*s %*s %*s\n' "$lw" "" "$sw" session "$cw" cumulative
  note "cost summary columns: label / session / cumulative"
  for ((i=0;i<${#labels[@]};i++)); do
    printf '  %-*s %s%s%s %s%s%s\n' "$lw" "${labels[i]}" "$DIM" "$(printf '%*s' "$sw" "${left[i]}")" "$OFF" "$DIM" "$(printf '%*s' "$cw" "${right[i]}")" "$OFF"
    note "cost summary: ${labels[i]}: ${left[i]} / ${right[i]}"
  done
}

# ---------------------------------------------------------------- agent pass
#
# Each agent invocation gets one transcript file, one prompt file, and one
# stderr complement, and runs under its own session and the given timeout,
# like a converge invocation (RP-REL-4). The environment names the role of
# the caller, the run directory, the panel run, the canonical profile of
# that agent, and the one invocation of the panel run it belongs to, so
# the bug tracker can attribute every revision it writes down to the
# invocation (RP-RUN-2, RP-RUN-5). The iteration variable of the converge
# loop is removed: a panel agent records no worker iteration. The
# assignment form of env keeps every value whole, however its path is
# spelled.

# print_start_line <glyph> <label> <profile> <log path>
print_start_line() {
  local glyph=$1 label=$2 profile=$3 log=$4
  if [[ -z $log ]]; then
    printf '  %s%s%s  %s%s%s %s%s %s%s\n' \
      "$BLUE" "$glyph" "$OFF" "$BOLD" "$label" "$OFF" \
      "$DIM" "$G_DOT" "$profile" "$OFF"
  else
    printf '  %s%s%s  %s%s%s %s%s %s %s %s%s\n' \
      "$BLUE" "$glyph" "$OFF" "$BOLD" "$label" "$OFF" \
      "$DIM" "$G_DOT" "$profile" "$G_ARROW" "${log##*/}" "$OFF"
  fi
}

# run_reviewer <index> <count> <profile>
# Starts one reviewer invocation in the background, in a session of its
# own, without waiting for another (RP-REV-1). The message stream goes
# through a per-invocation named pipe to two readers: the transcript file
# keeps every message, and a formatter shows the work as it happens, the
# way converge renders one invocation. Every transcript line carries the
# reviewer label, so the interleaved streams of concurrent reviewers stay
# attributable to their source (RP-OUT-2). The transcript opens with the
# invocation event, so a reader of the file alone knows the role and the
# full canonical profile (RP-OUT-2, RP-OUT-9).
#
# The index is 1-based and names the reviewer to the operator only. The
# controller keeps RUN_REVIEWS, INV_STARTS, and FORMATTERS at the 0-based
# position of AGENT_PIDS and REVIEW_STATUSES, which the wait loop below
# reads back, so every closing event, stderr read, duration, and transcript
# drain belongs to its own invocation (RP-OUT-2, RP-OUT-9).
#
# A transient failure to make the pipe runs the reviewer without a live
# transcript, exactly as the merge path judges such an invocation by its
# exit status.
#
# The environment names the one invocation of this panel run that the agent
# belongs to, so the bug tracker can tell two invocations of one run apart
# in the revisions they write, whatever the concurrent writers do
# (RP-RUN-2).
run_reviewer() {
  local index=$1 count=$2 profile=$3
  split_profile "$profile"
  local harness=$SPLIT_HARNESS model=$SPLIT_MODEL effort=$SPLIT_EFFORT
  # The formatter of this invocation renders the stream of this harness
  # (RP-OUT-2): stream_filter reads INVOCATION_HARNESS of the forked
  # subshell, so the variable must hold this reviewer's harness.
  INVOCATION_HARNESS=$harness
  printf -v seq '%04d' $((++SEQ))
  local stem="$PANEL_ID-$seq-reviewer" end_file fallback_stream
  LOG="$LOG_DIR/$stem.jsonl"
  RUN_REVIEWS[$((index - 1))]=$stem
  INV_STARTS[$((index - 1))]=$SECONDS

  harness_argv "$harness" "$model" "$effort" "$PANEL_PROMPT"
  # The controller reaps the reviewers one after another, so the reap time
  # of one reviewer can name a later wall time than the time it exited: a
  # reviewer that ended while an earlier one was still being reaped would
  # otherwise read as running until its own reap turn (RP-OUT-9). The
  # invocation therefore measures its own runtime: the harness runs inside
  # a small wrapper, and the wrapper, when the harness exits, writes the
  # seconds its own SECONDS clock has counted. The wait loop below prefers
  # that record and keeps the reap arithmetic only as the fallback, which
  # is what an invocation that was stopped, or whose record failed to be
  # written, leaves behind.
  end_file="$RUNTIME_DIR/$stem.end"
  rm -f "$end_file"
# The harness runs under its own setsid, so it and every child it spawns
# form one inner process group of their own: the trap then TERMs the whole
# group, not only the direct child. A grandchild that survives its direct
# ancestor would otherwise inherit this stream pipe's write end and hold
# tee open forever, and the controller would never drain the formatter nor
# finish the reap: the invocation would outlive --timeout indefinitely
# (RP-REV-6, RP-RUN-4). The plain kill is the fallback for a child whose
# group is already gone.
ARGV=(bash -c 'end="$1"; shift; setsid "$@" & child=$!; trap "kill -TERM -$child 2>/dev/null; kill -TERM $child 2>/dev/null; wait $child; exit 124" TERM INT; wait "$child"; rc=$?; printf "%s\n" "$SECONDS" >"$end"; exit "$rc"' \
     _ "$end_file" "${ARGV[@]}")
  invocation_event reviewer "$profile" "$harness" "$model" "$effort" "$LOG"
  printf '%s\n' "$PANEL_PROMPT" >"$LOG_DIR/$stem.prompt.md"
  note "reviewer $index/$count start: profile=$profile stem=$stem log=$LOG"
  print_start_line "$G_REVIEW" "reviewer $index/$count" "$profile" "$LOG"

  # Setup above can take long enough for the operator to request a stop.
  if ((STOP_REQUESTED || HARD_STOP)); then
    unset 'RUN_REVIEWS[index - 1]' 'INV_STARTS[index - 1]'
    return 0
  fi

  # The writer (the harness) opens the pipe for writing, and tee holds the
  # read end, so the two ends connect without a race. The pipe name carries
  # the panel run id and the invocation stem, so concurrent agents of this
  # run and of another never share one pipe (RP-RUN-4).
  TRANSCRIPT_ACCENT=$BLUE
  FINAL_DRAWN=0
  STREAM_LABEL="panel $PANEL_ID reviewer $index/$count profile $profile invocation $stem"
  STREAM_DISPLAY_LABEL="reviewer $index/$count $profile"
  local fifo="$RUNTIME_DIR/panel-stream-$PANEL_ID-$stem" fifo_ok=0
  rm -f "$fifo"
  if mkfifo "$fifo" 2>/dev/null; then
    fifo_ok=1
    ( trap - INT TERM; tee -a "$LOG" <"$fifo" | format_stream "$BLUE" "$LOG" ) &
    FORMATTERS[$((index - 1))]=$!
    FORMATTER_FIFOS[${FORMATTERS[$((index - 1))]}]=$fifo
    if ((STOP_REQUESTED || HARD_STOP)); then
      # The formatter may still be blocked opening the FIFO. Open a
      # temporary writer first so it can observe EOF, then reap it.
      ( : >"$fifo" ) 2>/dev/null || true
      kill -TERM "${FORMATTERS[$((index - 1))]}" 2>/dev/null || true
      wait "${FORMATTERS[$((index - 1))]}" 2>/dev/null || true
      unset 'FORMATTER_FIFOS[${FORMATTERS[$((index - 1))]}]'
      FORMATTERS[$((index - 1))]=0
      rm -f "$fifo"
      unset 'RUN_REVIEWS[index - 1]' 'INV_STARTS[index - 1]'
      return 0
    fi
    LAUNCH_CRITICAL=1
    (
      trap '' INT
      exec setsid env \
        -u CONVERGE_ITERATION \
        -u CONVERGE_SESSION \
        -u CONVERGE_DAEMON \
        -u REVIEW_PANEL_RUN \
        -u REVIEW_PANEL_PROFILE \
        -u REVIEW_PANEL_INVOCATION \
        CONVERGE_ROLE=reviewer \
        CONVERGE_RUN_DIR="$RUN_DIR" \
        REVIEW_PANEL_RUN="$PANEL_ID" \
        REVIEW_PANEL_PROFILE="$profile" \
        REVIEW_PANEL_INVOCATION="$stem" \
        PATH="$AGENT_PATH" \
        timeout --foreground -k 10 "$TIMEOUT" "${ARGV[@]}"
    ) >"$fifo" 2>>"$LOG_DIR/$stem.err" </dev/null &
    AGENT_PIDS+=("$!")
    finish_launch_critical
  else
    FORMATTERS[$((index - 1))]=0
    warn "reviewer $index/$count $profile cannot create the stream pipe; it runs without a live transcript"
    fallback_stream="$RUNTIME_DIR/$stem.stream"
    if ((STOP_REQUESTED || HARD_STOP)); then
      unset 'RUN_REVIEWS[index - 1]' 'INV_STARTS[index - 1]'
      return 0
    fi
    LAUNCH_CRITICAL=1
    (
      trap '' INT
      exec setsid env \
        -u CONVERGE_ITERATION \
        -u CONVERGE_SESSION \
        -u CONVERGE_DAEMON \
        -u REVIEW_PANEL_RUN \
        -u REVIEW_PANEL_PROFILE \
        -u REVIEW_PANEL_INVOCATION \
        CONVERGE_ROLE=reviewer \
        CONVERGE_RUN_DIR="$RUN_DIR" \
        REVIEW_PANEL_RUN="$PANEL_ID" \
        REVIEW_PANEL_PROFILE="$profile" \
        REVIEW_PANEL_INVOCATION="$stem" \
        PATH="$AGENT_PATH" \
        timeout --foreground -k 10 "$TIMEOUT" "${ARGV[@]}"
    ) >"$fallback_stream" 2>>"$LOG_DIR/$stem.err" </dev/null &
    AGENT_PIDS+=("$!")
    finish_launch_critical
    FALLBACK_STREAMS[$((index - 1))]=$fallback_stream
  fi
  STREAM_LABEL=""
  STREAM_DISPLAY_LABEL=""
}

# run_merge_agent <prompt> <profile>
# Runs one merge-agent invocation: live transcript on the terminal,
# every message in the log file. Its transcript shows the merge role and
# profile. Sets
# MERGE_STATUS and MERGE_SECONDS.
run_merge_agent() {
  local prompt=$1 profile=$2 fallback_stream=""
  TRANSCRIPT_ACCENT=$MAGENTA
  FINAL_DRAWN=0
  split_profile "$profile"
  local harness=$SPLIT_HARNESS model=$SPLIT_MODEL effort=$SPLIT_EFFORT
  local started=$SECONDS
  printf -v seq '%04d' $((++SEQ))
  MERGE_STEM="$PANEL_ID-$seq-merge"
  local LOG_FILE="$LOG_DIR/$MERGE_STEM.jsonl"
  INVOCATION_HARNESS=$harness

  harness_argv "$harness" "$model" "$effort" "$prompt"
  invocation_event merge "$profile" "$harness" "$model" "$effort" "$LOG_FILE"
  printf '%s\n' "$prompt" >"$LOG_DIR/$MERGE_STEM.prompt.md"
  # GNU timeout's --foreground mode does not manage COMMAND's descendants.
  # Keep the harness and its descendants in an inner process group and have
  # the wrapper terminate that group when timeout sends TERM (RP-INV-4,
  # RP-MERGE-7).
  local end_file="$RUNTIME_DIR/$MERGE_STEM.end"
  rm -f "$end_file"
  ARGV=(bash -c 'end="$1"; shift; setsid "$@" & child=$!; trap "kill -TERM -$child 2>/dev/null; kill -TERM $child 2>/dev/null; wait $child; exit 124" TERM INT; wait "$child"; rc=$?; printf "%s\n" "$SECONDS" >"$end"; exit "$rc"' \
       _ "$end_file" "${ARGV[@]}")
  note "merge start: profile=$profile log=$LOG_FILE"
  print_start_line "$G_COACH" "merge" "$profile" "$LOG_FILE"

  ((STOP_REQUESTED || HARD_STOP)) && { MERGE_STATUS=$SIGNAL_STATUS; return 0; }

  STREAM_LABEL="panel $PANEL_ID merge profile $profile invocation $MERGE_STEM"
  STREAM_DISPLAY_LABEL="merge $profile"

  # The message stream goes through a pipe to two readers: the log file
  # keeps every message, and the terminal shows the work as it happens,
  # the way converge renders one invocation. Another panel may run at the
  # same time in this run directory (RP-RUN-1), so the pipe name carries
  # the panel run id (RP-RUN-4). The startup probe proved that this
  # directory supports a named pipe; a transient failure here runs the
  # agent without a live transcript, and judges the result by the
  # exit status, as an invocation of no output is judged.
  fifo="$RUNTIME_DIR/panel-stream-$PANEL_ID"
  rm -f "$fifo"
  if mkfifo "$fifo" 2>/dev/null; then
    ( trap - INT TERM; tee -a "$LOG_FILE" <"$fifo" \
      | format_stream "$MAGENTA" "$LOG_FILE" "$LOG_FILE" ) &
    FORMATTER=$!
    FORMATTER_FIFOS[$FORMATTER]=$fifo
    if ((STOP_REQUESTED || HARD_STOP)); then
      ( : >"$fifo" ) 2>/dev/null || true
      kill -TERM "$FORMATTER" 2>/dev/null || true
      wait "$FORMATTER" 2>/dev/null || true
      unset 'FORMATTER_FIFOS[$FORMATTER]'
      FORMATTER=0
      rm -f "$fifo"
      STREAM_LABEL=""
      STREAM_DISPLAY_LABEL=""
      MERGE_STATUS=$SIGNAL_STATUS
      return 0
    fi
    # The agent writes its message stream into the pipe, the way converge
    # does; the tee reads it. The stdin of the agent stays the panel's.
    LAUNCH_CRITICAL=1
    (
      trap '' INT
      exec setsid env \
        -u CONVERGE_ITERATION \
        -u CONVERGE_SESSION \
        -u CONVERGE_DAEMON \
        -u REVIEW_PANEL_RUN \
        -u REVIEW_PANEL_PROFILE \
        -u REVIEW_PANEL_INVOCATION \
        CONVERGE_ROLE=merge \
        CONVERGE_RUN_DIR="$RUN_DIR" \
        REVIEW_PANEL_RUN="$PANEL_ID" \
        REVIEW_PANEL_PROFILE="$profile" \
        REVIEW_PANEL_INVOCATION="$MERGE_STEM" \
        PATH="$AGENT_PATH" \
        timeout --foreground -k 10 "$TIMEOUT" "${ARGV[@]}"
    ) >"$fifo" 2>>"$LOG_DIR/$MERGE_STEM.err" &
    MERGE_PID=$!
    AGENT_PIDS+=("$MERGE_PID")
    finish_launch_critical
  else
    FORMATTER=0
    warn "cannot create the stream pipe; the merge agent runs without a live transcript"
    fallback_stream="$RUNTIME_DIR/$MERGE_STEM.stream"
    if ((STOP_REQUESTED || HARD_STOP)); then MERGE_STATUS=$SIGNAL_STATUS; return 0; fi
    LAUNCH_CRITICAL=1
    (
      trap '' INT
      exec setsid env \
        -u CONVERGE_ITERATION \
        -u CONVERGE_SESSION \
        -u CONVERGE_DAEMON \
        -u REVIEW_PANEL_RUN \
        -u REVIEW_PANEL_PROFILE \
        -u REVIEW_PANEL_INVOCATION \
        CONVERGE_ROLE=merge \
        CONVERGE_RUN_DIR="$RUN_DIR" \
        REVIEW_PANEL_RUN="$PANEL_ID" \
        REVIEW_PANEL_PROFILE="$profile" \
        REVIEW_PANEL_INVOCATION="$MERGE_STEM" \
        PATH="$AGENT_PATH" \
        timeout --foreground -k 10 "$TIMEOUT" "${ARGV[@]}"
    ) </dev/null >"$fallback_stream" 2>>"$LOG_DIR/$MERGE_STEM.err" &
    MERGE_PID=$!
    AGENT_PIDS+=("$MERGE_PID")
    finish_launch_critical
  fi

  wait_child "$MERGE_PID"
  MERGE_STATUS=$?
  MERGE_SECONDS=$((SECONDS - started))
  if [[ -s $end_file ]]; then
    local recorded_seconds
    recorded_seconds=$(<"$end_file")
    is_number "$recorded_seconds" && MERGE_SECONDS=$recorded_seconds
  fi
  rm -f "$end_file"
  if ((FORMATTER)); then
    wait "$FORMATTER" 2>/dev/null
    unset 'FORMATTER_FIFOS[$FORMATTER]'
    FORMATTER=0
  fi
  if [[ -n $fallback_stream && -f $fallback_stream ]]; then
    cat "$fallback_stream" >>"$LOG_FILE"
    format_stream "$MAGENTA" "$LOG_FILE" <"$fallback_stream" >/dev/null
    rm -f "$fallback_stream"
  fi
  rm -f "$RUNTIME_DIR/panel-stream-$PANEL_ID"
  STREAM_LABEL=""
  STREAM_DISPLAY_LABEL=""

  if ((MERGE_STATUS == 124 || MERGE_STATUS == 137)); then
    warn "merge ($profile) exceeded the ${TIMEOUT}s timeout; killed it"
    show_stderr "$LOG_DIR/$MERGE_STEM" "merge ($profile)"
    printf '{"type":"review_panel_event","event":"timeout","run":"%s","seconds":%s}\n' \
      "$PANEL_ID" "$TIMEOUT" >>"$LOG_FILE"
  elif ((MERGE_STATUS != 0)); then
    bad "merge ($profile) exited with status $MERGE_STATUS after $(duration "$MERGE_SECONDS")"
    show_stderr "$LOG_DIR/$MERGE_STEM" "merge ($profile)"
    printf '{"type":"review_panel_event","event":"error","run":"%s","status":%s}\n' \
      "$PANEL_ID" "$MERGE_STATUS" >>"$LOG_FILE"
  else
    good "merge ($profile) finished in $(duration "$MERGE_SECONDS")"
  fi
  note "merge end: profile=$profile status=$MERGE_STATUS seconds=$MERGE_SECONDS"
  # CV-COST-10: the merge records its own line, under the distinct merge
  # cost role.
  record_invocation_cost merge "$profile" "$LOG_FILE" || true
}

# run_merge_chain <prompt>
# Try each configured merge profile once. A nonzero exit starts the next
# attempt at once. A timeout or an operator stop ends the chain.
run_merge_chain() {
  local prompt=$1 profile attempt_seconds total_seconds=0
  MERGE_STATUS=1
  MERGE_SECONDS=0
  MERGE_FAILURE_ROWS=()
  for profile in "${MERGE_PROFILES[@]}"; do
    if ((STOP_REQUESTED || HARD_STOP)); then
      MERGE_STATUS=$SIGNAL_STATUS
      return 0
    fi
    run_merge_agent "$prompt" "$profile"
    attempt_seconds=$MERGE_SECONDS
    ((total_seconds += attempt_seconds))
    MERGE_SECONDS=$total_seconds
    if ((MERGE_STATUS != 0)); then
      MERGE_FAILURE_ROWS+=("merge profile $profile: exit status $MERGE_STATUS")
    fi
    if ((MERGE_STATUS == 0 || MERGE_STATUS == 124 || MERGE_STATUS == 137 || STOP_REQUESTED || HARD_STOP)); then
      return 0
    fi
  done
}

# ---------------------------------------------------------------------- main

# The resolved profiles must hold before any agent starts (RP-PROF-5). The
# resolution happens once, here; the panel stores no profile selection for
# later runs (RP-PROF-6).
reject_retired_panel_env
resolve_reviewer_env
parse_profile_list reviewer "$REVIEWER_RAW" REVIEWER_PROFILES
REVIEWER_COUNT=${#REVIEWER_PROFILES[@]}
resolve_merge_env "${REVIEWER_PROFILES[0]:-}"
# The merge profile list must use the normal list syntax and reject
# duplicate canonical entries (RP-PROF-13).
parse_profile_list merge "$MERGE_PROFILE_RAW" MERGE_PROFILES
MERGE_PROFILE=$(join_list "${MERGE_PROFILES[@]}")

# CV-COST-10: the parent loop passes its existing CONVERGE_SESSION and an
# explicit absolute CONVERGE_COST_LEDGER path. With both present, the
# controller records one ledger line per reviewer and merge invocation,
# under the shared ledger lock, and creates neither a new cost session
# nor another ledger path. With no parent context, a standalone panel
# creates its own cost session and its own absolute ledger path, beside
# the bug database in the state directory (RP-COST-4). A partial context
# — one variable set without the other — or a relative ledger path is an
# error that the startup rejects before any agent starts (RP-COST-4). An
# explicitly empty pair is no parent cost context: then the panel stands
# alone.
if [[ ${CONVERGE_SESSION+x} && ${CONVERGE_COST_LEDGER+x} ]]; then
  if [[ -z $CONVERGE_SESSION && -z $CONVERGE_COST_LEDGER ]]; then
    COST_SESSION=$PANEL_ID
    COST_LEDGER="$STATE_DIR/cost-history.tsv"
    [[ $COST_LEDGER == /* ]] || COST_LEDGER="$(pwd -P)/$COST_LEDGER"
  else
    if [[ -z $CONVERGE_SESSION || -z $CONVERGE_COST_LEDGER ]]; then
      echo "review-panel: partial cost context: CONVERGE_SESSION and CONVERGE_COST_LEDGER must both be nonempty" >&2
      exit 2
    fi
    COST_SESSION=$CONVERGE_SESSION
    case $CONVERGE_COST_LEDGER in
      /*) COST_LEDGER=$CONVERGE_COST_LEDGER ;;
      *)
        echo "review-panel: CONVERGE_COST_LEDGER must be an absolute path, not '$CONVERGE_COST_LEDGER'" >&2
        exit 2
        ;;
    esac
  fi
elif [[ ${CONVERGE_SESSION+x} || ${CONVERGE_COST_LEDGER+x} ]]; then
  echo "review-panel: partial cost context: CONVERGE_SESSION and CONVERGE_COST_LEDGER must be set together" >&2
  exit 2
else
  COST_SESSION=$PANEL_ID
  COST_LEDGER="$STATE_DIR/cost-history.tsv"
  [[ $COST_LEDGER == /* ]] || COST_LEDGER="$(pwd -P)/$COST_LEDGER"
fi

if ((HELP_REQUESTED)); then
  usage
  exit 0
fi

# The message stream of the merge agent travels through a named pipe in the
# temporary directory. Test once, here, that the directory supports one: a
# failure discovered mid-run would leave no closing report; a failure
# discovered here, before any agent starts, is a start that never began.
fifo_probe="$RUNTIME_DIR/fifo_probe.$$"
rm -f "$fifo_probe"
if ! mkfifo "$fifo_probe" 2>/dev/null; then
  echo "review-panel: cannot create a named pipe in the temporary directory" >&2
  exit 2
fi
rm -f "$fifo_probe"

# The agents need cbugs on their PATH, whatever the operator's PATH holds
# (RP-INV-6).
AGENT_PATH="$BIN_DIR:$PATH"

# RP-OUT-1: the startup output shows the scope, the reviewer profiles, the
# merge profile, the timeout, and the state and log paths, and says that
# the panel reviews the live working tree.
if ((${#SCOPE[@]})); then
  SCOPE_SUMMARY=$(scope_list)
else
  SCOPE_SUMMARY="empty (the run directory)"
fi
PANEL_ROWS=(
  "run dir|$(home_relative "$RUN_DIR")"
  "state dir|$(home_relative "$STATE_DIR")"
  "bug db|$(home_relative "$STATE_DIR/cbugs.db")"
  "scope|$SCOPE_SUMMARY"
  "run log|$(home_relative "$RUN_LOG")"
  "logs|$(home_relative "$LOG_DIR")"
  "reviewers|$(join_list "${REVIEWER_PROFILES[@]}")"
  "merge|$MERGE_PROFILE"
  "timeout|${TIMEOUT}s for one invocation"
  "source|the live working tree, with every uncommitted change and relevant untracked file"
)
PANEL_TEXT=$(panel "$G_REVIEW review-panel" "${PANEL_ROWS[@]}")
printf '%s\n' "$PANEL_TEXT"
while IFS= read -r panel_line; do
  note "$(strip_style "$panel_line")"
done <<<"$PANEL_TEXT"
note "=== panel start ($PANEL_ID) ==="
for row in "${PANEL_ROWS[@]}"; do
  note "${row%%|*}: ${row#*|}"
done

# RP-COV-1: capture, at startup, the commits that pending review covers for
# the run directory, under the existing cbugs coverage rules. A failed read
# is not an empty backlog: it makes the required coverage recording
# impossible, and therefore the run incomplete (RP-COV-5).
pending_capture=""
if ! pending_capture=$(CONVERGE_RUN_DIR="$RUN_DIR" "$BIN_DIR/cbugs" reviewed pending 2>/dev/null); then
  warn "cbugs reviewed pending failed at startup; the panel cannot record coverage"
  note "cbugs reviewed pending failed at startup"
  PENDING_FAILED=1
  PENDING_HASHES=()
  PENDING_COUNT=0
else
  PENDING_FAILED=0
  PENDING_HASHES=()
  [[ -z $pending_capture ]] || mapfile -t PENDING_HASHES < <(awk 'NF { print $1 }' <<<"$pending_capture")
  PENDING_COUNT=${#PENDING_HASHES[@]}
  info "covers $(plural "$PENDING_COUNT" "unreviewed commit") at startup"
fi

# RP-DISC-2: accept the parent's session instructions or discover them once.
DISCOVERY_FAILED=0
DISCOVERY_STATUS=0
COST_RECORD_FAILED=0
FORMATTERS=()
FORMATTER_FIFOS=()
if (("${#SCOPE[@]}" == 0)); then
  if ((STOP_REQUESTED || HARD_STOP)); then
    printf 'status=stopped\n' >"$LOOKUP_RESULT"
  elif [[ ${CONVERGE_REQUIREMENTS_LOOKUP_REQUIRED:-} == 1 ]] &&
    [[ -z ${CONVERGE_REQUIREMENTS_LOOKUP_FILE+x} ]]; then
    DISCOVERY_FAILED=1
    DISCOVERY_STATUS=2
    printf 'status=failed\nphase=parent lookup validation\n' >"$LOOKUP_RESULT"
    bad "the parent did not provide its required requirements lookup instructions"
  elif [[ ${CONVERGE_REQUIREMENTS_LOOKUP_REQUIRED:-} == 1 ]] &&
    [[ -n ${CONVERGE_REQUIREMENTS_LOOKUP_FILE+x} ]]; then
    parent_lookup=$CONVERGE_REQUIREMENTS_LOOKUP_FILE
    if [[ -f $parent_lookup && ! -L $parent_lookup && -r $parent_lookup && -s $parent_lookup ]] &&
      grep -q '[^[:space:]]' "$parent_lookup" &&
      cp "$parent_lookup" "$LOOKUP_FILE" && [[ -s $LOOKUP_FILE ]]; then
      LOOKUP_TEXT=$(<"$LOOKUP_FILE")
      chmod 400 "$LOOKUP_FILE" 2>/dev/null || true
      printf 'status=inherited\nsource=%s\nlookup=%s\n' "$parent_lookup" "$LOOKUP_FILE" >"$LOOKUP_RESULT"
    else
      DISCOVERY_FAILED=1
      DISCOVERY_STATUS=2
      printf 'status=failed\nphase=parent lookup validation\nsource=%s\n' "$parent_lookup" >"$LOOKUP_RESULT"
      bad "the parent's requirements lookup instructions are missing or invalid"
    fi
  else
    worker_raw=${CONVERGE_WORKER_PROFILE-claude:sonnet}
    if [[ -z $worker_raw ]]; then
      DISCOVERY_FAILED=1
      DISCOVERY_STATUS=2
      printf 'status=failed\nphase=worker profile validation\n' >"$LOOKUP_RESULT"
      bad "CONVERGE_WORKER_PROFILE is set but empty; requirements discovery needs one worker profile"
    else
      WORKER_PROFILES=()
      parse_profile_list worker "$worker_raw" WORKER_PROFILES
      rm -f "$LOOKUP_FILE"
      run_discovery_chain "${WORKER_PROFILES[@]}"
      if ((STOP_REQUESTED || HARD_STOP)); then
        printf 'status=stopped\nprofile=%s\nlog=%s\n' "${DISCOVERY_PROFILE:-${WORKER_PROFILES[0]}}" "${DISCOVERY_LOG:-}" >"$LOOKUP_RESULT"
      elif ((DISCOVERY_STATUS == 0)) && [[ -f $LOOKUP_FILE && ! -L $LOOKUP_FILE && -r $LOOKUP_FILE && -s $LOOKUP_FILE ]] &&
        grep -q '[^[:space:]]' "$LOOKUP_FILE"; then
        LOOKUP_TEXT=$(<"$LOOKUP_FILE")
        chmod 400 "$LOOKUP_FILE" 2>/dev/null || true
        printf 'status=accepted\nprofile=%s\nlog=%s\nlookup=%s\n' \
          "$DISCOVERY_PROFILE" "$DISCOVERY_LOG" "$LOOKUP_FILE" >"$LOOKUP_RESULT"
      else
        DISCOVERY_FAILED=1
        DISCOVERY_STATUS=2
        printf 'status=failed\nprofile=%s\nlog=%s\nlookup=%s\n' \
          "${DISCOVERY_PROFILE:-${WORKER_PROFILES[0]}}" "${DISCOVERY_LOG:-}" "$LOOKUP_FILE" >"$LOOKUP_RESULT"
        bad "discovery ${DISCOVERY_PROFILE:-${WORKER_PROFILES[0]}} failed; no reviewer or merge agent will start"
      fi
    fi
  fi
  if ((DISCOVERY_FAILED == 0 && STOP_REQUESTED == 0 && HARD_STOP == 0)) && [[ -n $LOOKUP_TEXT ]]; then
    good "requirements lookup instructions $LOOKUP_FILE"
    cat "$LOOKUP_FILE"
    while IFS= read -r lookup_line; do note "requirements lookup: $lookup_line"; done <"$LOOKUP_FILE"
  fi
fi
AGENT_PIDS=()

PANEL_PROMPT=$(reviewer_prompt)
RUN_REVIEWS=()
INV_STARTS=()
REVIEW_STATUSES=()
FORMATTERS=()
FORMATTER_FIFOS=()
FALLBACK_STREAMS=()
REVIEW_FAILED=0
# The finding bookkeeping is defined from the start, so an operator stop
# that arrives at any point leaves the same honest report.
FINDINGS_COLLECT_FAILED=0
FINDINGS_JSON="[]"
NEW_LINES=""
NEW_COUNT=0

# One review invocation per configured reviewer profile, started without
# waiting for another (RP-REV-1). An operator stop that arrives during the
# launches prevents the invocations that have not started (RP-REV-1).
if ((DISCOVERY_FAILED == 0)); then
  for ((i = 0; i < REVIEWER_COUNT; i++)); do
    ((STOP_REQUESTED || HARD_STOP)) && break
    run_reviewer $((i + 1)) "$REVIEWER_COUNT" "${REVIEWER_PROFILES[$i]}"
  done
fi
RUN_STARTED=${#AGENT_PIDS[@]}
if ((RUN_STARTED < REVIEWER_COUNT)); then
  if ((STOP_REQUESTED || HARD_STOP)); then
    warn "started $(plural "$RUN_STARTED" reviewer) of $REVIEWER_COUNT; the operator stop prevented the rest"
    note "reviewers not started after the operator stop: $((REVIEWER_COUNT - RUN_STARTED))"
  elif ((DISCOVERY_FAILED)); then
    note "reviewers not started because requirements discovery failed"
  fi
fi

# The controller waits for every started reviewer, one after another, while
# the rest run on; the result of one reviewer changes nothing about what
# the others do (RP-REV-2, RP-REV-6). A failed or timed-out reviewer gets
# no retry and no fallback (RP-REV-6).
for ((i = 0; i < RUN_STARTED; i++)); do
  if wait_child "${AGENT_PIDS[$i]}"; then
    status=0
  else
    status=$?
  fi
  REVIEW_STATUSES[$i]=$status
  profile=${REVIEWER_PROFILES[$i]}
  stem=${RUN_REVIEWS[$i]:-}
  seconds=$((SECONDS - INV_STARTS[$i]))
  # The writer (the harness) closed the pipe. Let the reviewer's transcript
  # finish before the result line reports its outcome, so that the lines
  # stay in order and the drain belongs to this invocation's position
  # (RP-OUT-2, RP-OUT-9). The formatter of a reviewer that runs without a
  # pipe is 0, and a drain waits for nothing.
  if [[ -n $stem && -n ${FORMATTERS[$i]:-} && ${FORMATTERS[$i]} -ne 0 ]]; then
    wait_child "${FORMATTERS[$i]}" 2>/dev/null
    unset 'FORMATTER_FIFOS[${FORMATTERS[$i]}]'
    FORMATTERS[$i]=0
    rm -f "$RUNTIME_DIR/panel-stream-$PANEL_ID-$stem"
  fi
  if [[ -n ${FALLBACK_STREAMS[$i]:-} && -f ${FALLBACK_STREAMS[$i]} ]]; then
    cat "${FALLBACK_STREAMS[$i]}" >>"$LOG_DIR/$stem.jsonl"
    format_stream "$BLUE" "$LOG_DIR/$stem.jsonl" <"${FALLBACK_STREAMS[$i]}" >/dev/null
    rm -f "${FALLBACK_STREAMS[$i]}"
  fi
  # The invocation recorded its own runtime when the harness exited. The
  # controller reaps one reviewer after another, so the reap arithmetic
  # alone would report a late-exited reviewer as running until the reap of
  # an earlier one; this record outranks it (RP-OUT-9). The record goes
  # away after it is read.
  if [[ -n $stem ]]; then
    end_file="$RUNTIME_DIR/$stem.end"
    if [[ -s $end_file ]]; then
      recorded=$(<"$end_file")
      is_number "$recorded" && seconds=$recorded
    fi
    rm -f "$end_file"
  fi
  if ((status == 124 || status == 137)); then
    warn "reviewer $((i + 1))/$REVIEWER_COUNT $profile exceeded the ${TIMEOUT}s timeout; killed it"
    show_stderr "$LOG_DIR/$stem" "reviewer $((i + 1))/$REVIEWER_COUNT $profile"
    [[ -z $stem ]] || printf '{"type":"review_panel_event","event":"timeout","run":"%s","seconds":%s}\n' \
      "$PANEL_ID" "$TIMEOUT" >>"$LOG_DIR/$stem.jsonl"
  elif ((status != 0)); then
    warn "reviewer $((i + 1))/$REVIEWER_COUNT $profile exited with status $status after $(duration "$seconds")"
    show_stderr "$LOG_DIR/$stem" "reviewer $((i + 1))/$REVIEWER_COUNT $profile"
    [[ -z $stem ]] || printf '{"type":"review_panel_event","event":"error","run":"%s","status":%s}\n' \
      "$PANEL_ID" "$status" >>"$LOG_DIR/$stem.jsonl"
  else
    good "reviewer $((i + 1))/$REVIEWER_COUNT $profile finished in $(duration "$seconds")"
    [[ -z $stem ]] || printf '{"type":"review_panel_event","event":"result","run":"%s","status":0}\n' \
      "$PANEL_ID" >>"$LOG_DIR/$stem.jsonl"
  fi
  note "reviewer end: profile=$profile status=$status stem=$stem seconds=$seconds"
  # CV-COST-10: one ledger line per started invocation, as the stylesheet
  # that the converge loop uses appends its own. The read waits for the
  # formatter above, so the cost record is already the last line of the log.
  [[ -z $stem ]] || record_invocation_cost reviewer "$profile" "$LOG_DIR/$stem.jsonl" || true
  ((status == 0)) || REVIEW_FAILED=1
done

# RP-RUN-3: the findings of this run are selected by the attribution the
# bug tracker keeps, not by a database-wide count or a time interval. The
# read is a read: an operator stop does not prevent it, and the closing
# report of a stopped run stays able to show the available findings. A
# failed read leaves the collected list behind: the controller holds
# nothing, and the merge pass below decides what the failure means
# (RP-MERGE-1, RP-MERGE-2).
if ! findings_raw=$(CONVERGE_RUN_DIR="$RUN_DIR" "$BIN_DIR/cbugs" list --panel-run "$PANEL_ID" --json 2>/dev/null); then
  FINDINGS_COLLECT_FAILED=1
  warn "cbugs list --panel-run failed; the panel cannot report its findings"
else
  [[ -n $findings_raw ]] && FINDINGS_JSON=$findings_raw
  if [[ $(jq -r 'type' <<<"$FINDINGS_JSON" 2>/dev/null) != array ]]; then
    FINDINGS_COLLECT_FAILED=1
    warn "cbugs list --panel-run gave no array; the panel cannot report its findings"
  else
    NEW_LINES=""
    while IFS=$'\t' read -r id kind status title; do
      decode_tsv_field "$title"; title=$REPLY
      NEW_LINES+="#$id ($kind, $status): $title
"
    done < <(jq -r '.[] | [.id, .kind, .status, .title] | @tsv' <<<"$FINDINGS_JSON")
    NEW_COUNT=$(jq 'length' <<<"$FINDINGS_JSON")
  fi
fi

# The duplicate merge pass runs when the operator stop has not shut the
# panel down (RP-OUT-8). It still runs on a panel that a reviewer failure
# left incomplete (RP-MERGE-2).
#
# The required merge is one invocation whenever this panel created bugs
# (RP-MERGE-1), and the skip condition is "created no bugs", not "read no
# bugs". When the read of this run's findings failed, the controller cannot
# prove that the panel created no bug, so the merge must still be
# attempted, and it must run on the findings that are available
# (RP-MERGE-2): the merge agent collects the bugs of the run itself.
MERGE_FAILED=0
MERGE_RAN=0
if ((DISCOVERY_FAILED)); then
  note "merge skipped: requirements discovery failed"
elif ((STOP_REQUESTED || HARD_STOP)); then
  warn "operator stop: the merge agent and the coverage recording step do not start"
  note "merge skipped: operator stop"
elif ((FINDINGS_COLLECT_FAILED)); then
  heading "$MAGENTA" "merge duplicates" "$(date '+%H:%M:%S')"
  note "merge phase: the findings read failed before the merge, so the merge agent collects the bugs of this panel run itself"
  run_merge_chain "$(merge_prompt "" 1)"
  # A graceful stop lets an active merge finish. Its successful read-back is
  # still the known outcome for this incomplete report.
  MERGE_FAILED=1
  if ((MERGE_STATUS == 0)); then
    MERGE_FAILED=0
    ((HARD_STOP)) || MERGE_RAN=1
  fi
elif ((NEW_COUNT == 0)); then
  note "merge skipped: the panel created no bug"
else
  heading "$MAGENTA" "merge duplicates" "$(date '+%H:%M:%S')"
  note "merge phase: $(plural "$NEW_COUNT" "new bug") to reconcile"
  run_merge_chain "$(merge_prompt "$NEW_LINES")"
  # A graceful stop lets an active merge finish. Its successful read-back is
  # still the known outcome for this incomplete report.
  MERGE_FAILED=1
  if ((MERGE_STATUS == 0)); then
    MERGE_FAILED=0
    ((HARD_STOP)) || MERGE_RAN=1
  fi
fi

# The retained new bugs are the findings that the merge pass did not close
# as duplicates (RP-OUT-3). Another concurrent writer may have moved one of
# them to a terminal status too; the current status decides.
RETAINED_FAILED=0
RETAINED_JSON="[]"
if ! retained_raw=$(CONVERGE_RUN_DIR="$RUN_DIR" "$BIN_DIR/cbugs" list --panel-run "$PANEL_ID" --json 2>/dev/null); then
  RETAINED_FAILED=1
  warn "cbugs list --panel-run failed after the merge; the retained findings are unknown"
else
  [[ -n $retained_raw ]] && RETAINED_JSON=$retained_raw
  if [[ $(jq -r 'type' <<<"$RETAINED_JSON" 2>/dev/null) != array ]]; then
    RETAINED_FAILED=1
    warn "cbugs list --panel-run gave no array after the merge; the retained findings are unknown"
  elif ((FINDINGS_COLLECT_FAILED)); then
    # The read before the merge failed, so the read here is the only
    # collected list of the bugs that this run created: the report reads
    # the retained subset out of it. A bug of this run that the merge did
    # not hold open is no retained new bug.
    FINDINGS_JSON=$RETAINED_JSON
  fi
fi
RETAINED=$(jq -n --argjson prev "$FINDINGS_JSON" --argjson cur "$RETAINED_JSON" \
  '[$cur[] | select(.status == "open")
          | select(.id as $i | ([$prev[].id] | index($i)))]' 2>/dev/null) || RETAINED_FAILED=1
RETAINED_CODE_JSON=$(jq -c '[.[] | select(.kind == "code")]' <<<"$RETAINED" 2>/dev/null)
RETAINED_SPEC_JSON=$(jq -c '[.[] | select(.kind == "spec")]' <<<"$RETAINED" 2>/dev/null)
[[ $(jq -r 'type' <<<"$RETAINED_CODE_JSON" 2>/dev/null) == array ]] || RETAINED_CODE_JSON='[]'
[[ $(jq -r 'type' <<<"$RETAINED_SPEC_JSON" 2>/dev/null) == array ]] || RETAINED_SPEC_JSON='[]'
RETAINED_CODE=$(jq 'length' <<<"$RETAINED_CODE_JSON" 2>/dev/null)
RETAINED_SPEC=$(jq 'length' <<<"$RETAINED_SPEC_JSON" 2>/dev/null)
is_number "$RETAINED_CODE" || RETAINED_CODE=0
is_number "$RETAINED_SPEC" || RETAINED_SPEC=0

# The coverage recording follows a complete review and merge phase
# (RP-COV-2). A reviewer failure, a merge failure, an operator stop, a
# failed capture, or a failed read-back prevents it (RP-COV-5).
coverage_enabled=1
((DISCOVERY_FAILED)) && coverage_enabled=0
((STOP_REQUESTED || HARD_STOP)) && coverage_enabled=0
((RUN_STARTED < REVIEWER_COUNT)) && coverage_enabled=0
((REVIEW_FAILED)) && coverage_enabled=0
((MERGE_FAILED)) && coverage_enabled=0
((FINDINGS_COLLECT_FAILED)) && coverage_enabled=0
((RETAINED_FAILED)) && coverage_enabled=0
((PENDING_FAILED)) && coverage_enabled=0
COVERAGE_FAILED=0
if ((coverage_enabled)) && ((PENDING_COUNT > 0)); then
  completed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  coverage_status=0
  for ((i = 0; i < REVIEWER_COUNT; i++)); do
    # A stop can arrive while an earlier reviewer record is being written.
    # Recheck immediately before each write so the interrupted run records
    # no later coverage (RP-COV-5).
    if ((STOP_REQUESTED || HARD_STOP)); then
      coverage_enabled=0
      break
    fi
    [[ ${REVIEW_STATUSES[$i]:-1} == 0 ]] || continue
    record_reviewed "${REVIEWER_PROFILES[$i]}" "$completed_at" || coverage_status=1
  done
  if ((!coverage_enabled)); then
    info "coverage recording stopped after an operator stop"
  elif ((coverage_status)); then
    COVERAGE_FAILED=1
  else
    info "recorded coverage for $(plural "$PENDING_COUNT" commit) under each reviewer profile"
  fi
fi

# The ending: all phases decided. The exit status is 0 for a complete run
# with no retained new code bug, 1 with a retained new code bug, 2 for an
# invalid or incomplete run, and 130 or 143 for an operator stop. Errors
# take priority over finding counts (RP-OUT-7, RP-OUT-8).

TOTAL=$(duration $((SECONDS - RUN_START)))

# The failed profiles and phases, for an incomplete run (RP-OUT-6).
FAILED_ROWS=()
((STOP_REQUESTED || HARD_STOP)) && FAILED_ROWS+=("stopped on the request of the operator")
((DISCOVERY_FAILED)) && FAILED_ROWS+=("requirements discovery: phase failed with status $DISCOVERY_STATUS")
((PENDING_FAILED)) && FAILED_ROWS+=("coverage capture: cbugs reviewed pending failed at startup")
for ((i = 0; i < RUN_STARTED; i++)); do
  status=${REVIEW_STATUSES[$i]}
  [[ $status == 0 ]] || FAILED_ROWS+=("reviewer $((i + 1))/$REVIEWER_COUNT ${REVIEWER_PROFILES[$i]}: exit status $status")
done
if ((RUN_STARTED < REVIEWER_COUNT)); then
  if ((DISCOVERY_FAILED)); then
    FAILED_ROWS+=("reviewer: invocations not started because requirements discovery failed")
  else
    FAILED_ROWS+=("reviewer: invocations not started: $((REVIEWER_COUNT - RUN_STARTED))")
  fi
fi
if ((MERGE_FAILED)); then
  if ((${#MERGE_FAILURE_ROWS[@]})); then
    FAILED_ROWS+=("${MERGE_FAILURE_ROWS[@]}")
  else
    FAILED_ROWS+=("merge phase: no merge profile completed")
  fi
fi
((COVERAGE_FAILED)) && FAILED_ROWS+=("coverage recording: cbugs reviewed add failed")
((FINDINGS_COLLECT_FAILED)) && \
  FAILED_ROWS+=("findings: cbugs list --panel-run failed before the merge")
((RETAINED_FAILED)) && FAILED_ROWS+=("findings: cbugs list --panel-run failed after the merge")
((COST_RECORD_FAILED)) && FAILED_ROWS+=("cost ledger: one or more invocation records could not be written")

findings_block() {
  local json=$1 word=${2:-retained new} id kind status title hidden shown_title
  while IFS=$'\t' read -r id kind status title hidden; do
    # RP-OUT-10: every retained new bug of the panel reaches the closing
    # report, even when it is hidden at the closing query HEAD. A hidden
    # row names itself, and borrows the title of the revision that created
    # the bug; the panel never presents an unreachable revision as current.
    if [[ $hidden == 1 || $hidden == true ]]; then
      local shown_json
      shown_json=$(CONVERGE_RUN_DIR="$RUN_DIR" "$BIN_DIR/cbugs" show "$id" --json 2>/dev/null) || shown_json=
      shown_title=$(jq -r '.revisions[0].title // empty' <<<"$shown_json" 2>/dev/null)
      [[ -n $shown_title ]] || shown_title='[creation title unavailable]'
      printf '  %s%s%s %s\n' "$YELLOW" "$G_WARN" "$OFF" \
        "new $kind bug #$id (hidden): $shown_title"
      note "$word bug #$id ($kind, hidden): $shown_title"
    else
      decode_tsv_field "$title"; title=$REPLY
      printf '  %s%s%s %s\n' "$YELLOW" "$G_WARN" "$OFF" \
        "new $kind bug #$id: $title"
      note "$word bug #$id ($kind): $title"
    fi
  done < <(jq -r '.[] | [.id, .kind, .status, .title, (.hidden // false)] | @tsv' <<<"$json")
}

# The findings the panel gathered: FINDINGS_JSON holds the list that a read
# collected, which is the read before the merge, or, when that read failed,
# the read after the merge. When the merge succeeded, its read-back gives the
# known current outcome for every finding, including a run that remains
# incomplete because another phase failed (RP-OUT-6).
if ((MERGE_RAN)) && ((MERGE_FAILED == 0)) && ((RETAINED_FAILED == 0)); then
  FINDINGS_JSON=$RETAINED_JSON
fi
AVAILABLE_COUNT=$(jq -r 'length' <<<"$FINDINGS_JSON" 2>/dev/null)
is_number "$AVAILABLE_COUNT" || AVAILABLE_COUNT=0

STOPPED=0
((STOP_REQUESTED || HARD_STOP)) && STOPPED=1

COMPLETE=1
((STOPPED)) && COMPLETE=0
((${#FAILED_ROWS[@]} > 0)) && COMPLETE=0

# The findings of the closing report: separate counts for the retained new
# spec bugs and the retained new code bugs, with their ids and titles
# (RP-OUT-3). An incomplete run shows its available findings, and its
# stop or its failure names itself: no unqualified success (RP-OUT-6).
if ((RETAINED_CODE + RETAINED_SPEC > 0)); then
  heading "$YELLOW" "findings" "$(plural "$RETAINED_CODE" "retained new code bug"), $(plural "$RETAINED_SPEC" "retained new spec bug")"
  findings_block "$RETAINED_CODE_JSON"
  findings_block "$RETAINED_SPEC_JSON"
elif ((COMPLETE == 0)); then
  info "the panel knows of no retained new bug to show; its findings may be incomplete"
  if ((AVAILABLE_COUNT > 0)); then
    if ((FINDINGS_COLLECT_FAILED)) || { ((MERGE_RAN)) && ((MERGE_FAILED == 0)) && ((RETAINED_FAILED == 0)); }; then
      # The report holds a post-merge read, so the merge outcome of each bug
      # below is what its status says, and no line of the panel claims an
      # unknown fate.
      if ((FINDINGS_COLLECT_FAILED)); then
        heading "$YELLOW" "findings of this panel run" "read after the merge; the read before it failed"
      else
        heading "$YELLOW" "findings of this panel run" "read after the merge"
      fi
      findings_block "$FINDINGS_JSON" "known new"
    else
      heading "$YELLOW" "available findings" "the merge outcome for these is unknown"
      findings_block "$FINDINGS_JSON" "available new"
    fi
  fi
fi

print_cost_summary

if ((COMPLETE)); then
  if ((RETAINED_CODE > 0)); then
    banner "$RED" "$E_STOP" "review complete in $TOTAL; the code findings above are the work that remains"
    note "=== panel end: exit 1 ==="
    exit 1
  elif ((RETAINED_SPEC > 0)); then
    # A run that retains spec bugs shows them, and prints no success
    # message: a spec bug waits on a decision the human user makes
    # (RP-OUT-5). It is a complete run, and it exits 0.
    banner "$YELLOW" "$E_WARN" "review complete in $TOTAL; the spec findings above wait for a decision on the requirements"
    note "=== panel end: exit 0 ==="
    exit 0
  else
    banner "$GREEN" "$E_OK" "Review complete in $TOTAL. No new bugs found."
    note "=== panel end: exit 0 ==="
    exit 0
  fi
else
  for line in "${FAILED_ROWS[@]}"; do
    printf '  %s%s%s\n' "$RED" "$G_ERR" "$line$OFF" >&2
    note "failed: $line"
  done
  if ((STOPPED)); then
    banner "$YELLOW" "$E_STOP" "review stopped on the request of the operator in $TOTAL; the summary above is incomplete"
    note "=== panel end: exit $SIGNAL_STATUS ==="
    exit "$SIGNAL_STATUS"
  fi
  banner "$YELLOW" "$E_STOP" "review incomplete in $TOTAL; the summary above is incomplete"
  note "=== panel end: exit 2 ==="
  exit 2
fi
