#!/usr/bin/env bash
# Bug tracker for one converge project.
#
# See docs/cbugs-requirements.md for the required behavior and
# docs/cbugs-schema.sql for the data model that this script keeps in sync.
set -uo pipefail

# The script uses bash 4 syntax. macOS supplies bash 3.2. This test must stay
# above the first use of that syntax, because bash parses a script as it runs.
if ((BASH_VERSINFO[0] < 4)); then
  echo "cbugs: bash ${BASH_VERSION} is too old; bash 4 or later is needed" >&2
  echo "cbugs: on macOS, run 'brew install bash'" >&2
  exit 2
fi

usage() {
  cat >&2 <<'EOF'
Usage: cbugs <verb> [options]

Verbs:
  add      Log a new bug.
  list     List bugs.
  show     Show one bug in full, with its revisions.
  search   Find bugs by text in their titles or notes.
  note     Add a note to a bug, without changing its status.
  close    Mark a bug closed: the defect is gone.
  dismiss  Mark a bug wontfix: no one will act on it.
  reopen   Mark a bug open again.
  reviewed Record the commits that a review pass covered (add), or print
           the commits that no pass has recorded yet (pending).

Run 'cbugs <verb> --help' for the options of one verb.
Every verb accepts --json.

'cbugs <id>' is the same as 'cbugs show <id>'.
Run 'cbugs' with no argument for a summary of the open bugs.
EOF
}

usage_add() {
  cat >&2 <<'EOF'
Usage: cbugs add --kind code|spec|task --title <text> [--note <text>]
                  [--cite <path>[:<id>]]... [--commit <id>] [--json]

Creates one bug with the status "open" and prints its id.

--note is read from standard input when it is not given, unless standard
input is a terminal, in which case add stops with an error.

--kind task stops with an error when the environment holds CONVERGE_ROLE. A
task records what a human user asked for, and an agent must never log one
unless a human user directed it.
EOF
}

usage_note() {
  cat >&2 <<'EOF'
Usage: cbugs note <id> [<text>] [--note <text>] [--title <text>]
                   [--cite <path>[:<id>]]... [--commit <id>] [--json]

Writes a revision that keeps the status. Valid on a bug in any status.

The note comes from the argument after the id, from --note, or from standard
input, in that order. When none is given and standard input is a terminal,
note stops with an error.
EOF
}

usage_status_verb() {
  local verb=$1 status=$2
  cat >&2 <<EOF
Usage: cbugs $verb <id> [--note <text>] [--title <text>]
                    [--cite <path>[:<id>]]... [--commit <id>] [--json]

Writes a revision with the status "$status".

--note is read from standard input when it is not given. When standard input
is a terminal, $verb writes an empty note instead of waiting.
EOF
}

usage_list() {
  cat >&2 <<'EOF'
Usage: cbugs list [--kind code|spec|task]... [--status open|closed|wontfix]...
                  [--panel-run <id>] [--json]

Prints the bugs of the project, newest revision first. Repeat --kind or
--status to show more than one value; several values of one option mean
their union. With no option, list shows every bug.

--panel-run <id> shows only the bugs that the named panel run created: the
run id of a review-panel agent is in the first revision of each bug it
logged.
EOF
}

usage_show() {
  cat >&2 <<'EOF'
Usage: cbugs show <id> [--json]

Prints one bug in full: its id, kind, current status, current title, and
every revision in order, with the citations that each revision wrote.
EOF
}

usage_search() {
  cat >&2 <<'EOF'
Usage: cbugs search <text> [--kind code|spec|task]... [--status open|closed|wontfix]...
                           [--panel-run <id>] [--json]

Prints the bugs whose title, in any revision, whose notes, or whose
citations contain the text. The search ignores the difference between
capital and small letters. Accepts the same options as list, in the same
order and form.
EOF
}

usage_reviewed() {
  cat >&2 <<'EOF'
Usage: cbugs reviewed add|pending [args]

  reviewed add      Record the commits that one review pass covered.
  reviewed pending  Print the commits that no pass has recorded yet.

Run 'cbugs reviewed add --help' for the options of add, and
'cbugs reviewed pending --help' for the options of pending.
EOF
}

usage_reviewed_add() {
  cat >&2 <<'EOF'
Usage: cbugs reviewed add [--iteration <N>] [--profile <profile>]
                          [--completed-at <timestamp>] [<commit>]... [--json]

Records the commits that one review pass of converge covered. The commits
come as arguments, or on standard input, one commit per line. The record
of one call is one transaction: a call that fails records nothing.

The command writes the full hash of the commit that git resolves from
each value. A value that names no commit of the repository is an error.

Every distinct resolved commit gets one new, immutable record, even when
a row already names it.

Prints one line with the number of records added, the number of input
commits that a row already named before the call, the profile, and the
completion timestamp.

The call stops with an error when the environment holds CONVERGE_ROLE:
the loop records the commits of a pass, and no agent of the loop records
one. An operator who runs the command by hand may record commits.

--iteration <N>       The worker iteration that the pass followed. A call
                      that gives none records none.
--profile <profile>   The harness:model[:effort] of the pass. Omitted,
                      the record holds an unknown profile.
--completed-at <ts>   The completion time, as YYYY-MM-DDTHH:MM:SSZ.
                      Omitted, the call uses the current UTC time, once
                      for every record it writes.
EOF
}

usage_reviewed_pending() {
  cat >&2 <<'EOF'
Usage: cbugs reviewed pending [--json]

Prints the commits that no row of the reviewed table names and that git
reaches from the HEAD of the repository, the newest first: one line for
each commit, with the full hash and the subject.

Prints nothing and exits with the status 0 when no commit is unreviewed,
and when the repository holds no commit.
EOF
}

# ------------------------------------------------------------------ platform
#
# The command runs under the same platform conditions as converge: bash 4 or
# later, and the GNU/Homebrew discovery pattern for a tool that Homebrew keeps
# off the normal PATH on macOS. hash_path (below) and reviewed add's
# --completed-at both need the GNU versions of md5sum and date that coreutils
# supplies; without them on PATH, hash_path silently falls back to cksum and
# derives a state directory that disagrees with converge's (CB-DB-2), and
# date -u -d misparses under the BSD date that macOS supplies.

for brew_prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
  [[ -n $brew_prefix ]] || continue
  for bin_dir in "$brew_prefix/opt/sqlite/bin" \
                 "$brew_prefix/opt/coreutils/libexec/gnubin" \
                 "$brew_prefix/opt/util-linux/bin"; do
    [[ -d $bin_dir ]] && PATH="$bin_dir:$PATH"
  done
done

need_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "cbugs: '$1' is not on PATH" >&2
    if [[ -n ${2:-} ]]; then
      echo "cbugs: on macOS, run 'brew install $2'" >&2
    fi
    exit 2
  fi
}
need_tool sqlite3 sqlite
need_tool jq jq
need_tool date coreutils
need_tool flock util-linux

# The BSD date that macOS supplies shares the name "date" but rejects -d, the
# GNU option that reviewed add's --completed-at validation depends on
# (CV-PLAT-5's rule applies here too: a name on PATH is not enough).
if ! date --version >/dev/null 2>&1; then
  echo "cbugs: this 'date' is not GNU date" >&2
  echo "cbugs: on macOS, run 'brew install coreutils'" >&2
  exit 2
fi

# The same rule applies to flock: the GNU/util-linux flock that the
# migration lock (CB-DB-2's cross-process guarantee) depends on accepts
# --version; a shim of the same name on PATH may not.
if ! flock --version >/dev/null 2>&1; then
  echo "cbugs: this 'flock' is not GNU flock" >&2
  echo "cbugs: on macOS, run 'brew install util-linux'" >&2
  exit 2
fi

# ------------------------------------------------------------------ appearance

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'
  YELLOW=$'\033[33m'; GREEN=$'\033[32m'; CYAN=$'\033[36m'; MAGENTA=$'\033[35m'
else
  BOLD=""; DIM=""; OFF=""; YELLOW=""; GREEN=""; CYAN=""; MAGENTA=""
fi

# is_number <text>   True when the text is a whole number.
is_number() {
  [[ $1 =~ ^[0-9]+$ ]]
}

# plural <count> <word>   Adds an "s" to the word when the count is not one.
plural() {
  if (($1 == 1)); then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi
}

# need_value <flag> <remaining-args-count>
need_value() {
  if (($2 < 2)); then
    echo "cbugs: $1 needs a value" >&2
    exit 2
  fi
}

# ------------------------------------------------------------- state and db
#
# cbugs derives the state directory from the absolute path of the run
# directory of the call -- CONVERGE_RUN_DIR when the environment holds it,
# else the current directory -- by the same rule that converge uses, so that
# a directory converge has run in gives the same state directory to both
# commands (CB-DB-2). When no run directory of the walk holds one, cbugs
# creates one, as CB-DB-7 gives. converge exports CONVERGE_RUN_DIR for
# every agent it starts, so an agent that changes its own working directory
# still reads and writes the bugs of its own run, and never the bugs of
# another run directory that it moved into.

hash_path() {
  if command -v md5sum >/dev/null 2>&1; then
    printf '%s' "$1" | md5sum | cut -c1-12
  else
    printf '%s' "$1" | cksum | tr -d ' ' | cut -c1-12
  fi
}

# state_for <dir>   Prints the state directory that converge would use for a
# run from <dir>, at the path of <dir>, by the rule of CB-DB-2: the name of
# the repository that contains <dir>, the path of <dir> within it, and a
# hash of the absolute path of <dir>. Every ancestor of the walk gets its
# own derivation, so the state directory of another repository never takes
# the bugs of this one (CB-DB-8.2).
state_for() {
  local dir=$1 repo sub=""
  if ! repo=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
    repo=$dir
  fi
  [[ $dir == "$repo" ]] || sub="${dir#"$repo"/}"
  printf '%s/%s' "${XDG_STATE_HOME:-${HOME:-}/.local/state}/converge" \
    "${repo##*/}${sub:+-${sub//\//-}}-$(hash_path "$dir")"
}

# create_state_dir   Creates the state directory of the run directory of the
# call. The command makes no directory of its own: it runs 'converge
# --init-state' as PATH names it, with the working directory of the child
# set to the run directory of the call (CB-DB-7.1). It discards the output
# of a creation that succeeds; when the creation fails, it stops with an
# error that names the cause, and prints no bug, whatever the verb asked
# for (CB-DB-7.2, CB-ERR-3).
create_state_dir() {
  local errfile status
  if ! command -v converge >/dev/null 2>&1; then
    echo "cbugs: cannot create the state directory: 'converge' is not on PATH" >&2
    exit 2
  fi
  if ! errfile=$(mktemp "${TMPDIR:-/tmp}/cbugs.XXXXXX"); then
    echo "cbugs: cannot make a temporary file; check TMPDIR" >&2
    exit 2
  fi
  (cd "$RUN_DIR" && converge --init-state) >/dev/null 2>"$errfile"
  status=$?
  if ((status != 0)); then
    echo "cbugs: cannot create the state directory: 'converge --init-state' failed" >&2
    while IFS= read -r line; do
      [[ -n $line ]] && echo "cbugs: $line" >&2
    done <"$errfile"
    rm -f "$errfile"
    exit 2
  fi
  rm -f "$errfile"
}

# --help needs no project state: it only prints usage. Detect it ahead of the
# state directory check, so 'cbugs --help' and 'cbugs <verb> --help' work in
# any directory, including one that is not a converge project.
#
# Skip the token after a value-taking option, so a literal '-h' or '--help'
# given as a --title, --note, --cite, --commit, or --status value is not
# mistaken for the flag.
HELP_REQUESTED=0
skip_next=0
for arg in "$@"; do
  if ((skip_next)); then
    skip_next=0
    continue
  fi
  case $arg in
    -h|--help) HELP_REQUESTED=1 ;;
    --title|--kind|--note|--cite|--commit|--status|--iteration|--profile|--completed-at) skip_next=1 ;;
  esac
done

if [[ -n ${CONVERGE_RUN_DIR:-} ]]; then
  if ((! HELP_REQUESTED)) && [[ ! -d $CONVERGE_RUN_DIR ]]; then
    echo "cbugs: CONVERGE_RUN_DIR '$CONVERGE_RUN_DIR' names no directory" >&2
    exit 2
  fi
  RUN_DIR=$CONVERGE_RUN_DIR
else
  RUN_DIR="$(pwd -P)"
fi
# Name the run directory by absolute path that pwd -P gives, as converge
# names it, so that one directory derives one state directory, however the
# caller spells its path (CB-DB-2). The walk below starts from the parent
# of it, by string, so the path must be in that form already.
if ((! HELP_REQUESTED)) && ! RUN_DIR=$(cd "$RUN_DIR" && pwd -P); then
  echo "cbugs: cannot reach the run directory '$RUN_DIR'" >&2
  exit 2
fi
if ((! HELP_REQUESTED)) && [[ -z ${XDG_STATE_HOME:-} && -z ${HOME:-} ]]; then
  echo "cbugs: set HOME or XDG_STATE_HOME; cbugs keeps its state there" >&2
  exit 2
fi

# State resolution. A call for help resolves no state directory and creates
# none (CB-DB-8.4); every other call resolves one, and a read resolves it
# exactly as a write does.
STATE_DIR=""
DB=""
if ((! HELP_REQUESTED)); then
  # Every call that answers reads the repository: the derivation of CB-DB-2
  # names the repository of the run directory, the walk of CB-DB-8 ends at
  # its root, and the write verbs read its HEAD. Without git the command
  # cannot tell a repository from a plain directory. It would then derive a
  # state directory whose name converge does not derive (CB-DB-2), or test
  # ancestors above the root of the repository (CB-DB-8.2), or record a
  # revision with no commit where the repository holds one (CB-PROV-4).
  # A necessary tool must name its absence, as CB-PLAT-2 gives: stop here,
  # before any answer, with the named-tool error.
  need_tool git git
  # The walk of CB-DB-8 ends with the root of the repository when the run
  # directory sits in one, and with the root of the file system when it
  # does not (CB-DB-8.2). When the run directory is itself the root of its
  # repository, no ancestor of the walk lies within it, and the walk tests
  # nothing: the state directory of another repository must never take the
  # bugs of this one (CB-DB-8.2).
  if REPO=$(git -C "$RUN_DIR" rev-parse --show-toplevel 2>/dev/null); then
    if [[ $REPO == "$RUN_DIR" ]]; then
      walk=0
    else
      walk=1
      limit=$REPO
    fi
  else
    REPO=$RUN_DIR
    walk=1
    limit=/
  fi
  own=$(state_for "$RUN_DIR")
  if [[ -d $own ]]; then
    # CB-DB-8: the state directory of the run directory, when it exists.
    STATE_DIR=$own
  else
    dir=${RUN_DIR%/*}; [[ -z $dir ]] && dir=/
    while ((walk)); do
      cand=$(state_for "$dir")
      if [[ -d $cand ]]; then
        # The one case of CB-DB-8.3: the call writes its bugs into the
        # database of the nearest ancestor that holds a state directory.
        STATE_DIR=$cand
        break
      fi
      [[ $dir == "$limit" ]] && break
      parent=${dir%/*}
      [[ -z $parent ]] && parent=/
      [[ $parent == "$dir" ]] && break
      dir=$parent
    done
    if [[ -z $STATE_DIR ]]; then
      # No run directory of the walk holds one: create the state directory
      # of the run directory of the call (CB-DB-7), for every verb.
      create_state_dir
      STATE_DIR=$own
    fi
  fi
  DB="$STATE_DIR/cbugs.db"
fi

# The temporary file takes the stderr of every sqlite call. A creation that
# fails names its cause in the same way (CB-ERR-2): fail here, before any
# answer, when no temporary file can be made.
if ! ERRFILE=$(mktemp "${TMPDIR:-/tmp}/cbugs.XXXXXX"); then
  echo "cbugs: cannot make a temporary file; check TMPDIR" >&2
  exit 2
fi
trap 'rm -f "$ERRFILE"' EXIT

# sqlite3_run <raw|json> <sql>
# Runs one script against the database, with a bounded wait when the database
# is busy. Prints what the script writes to stdout. Stops with an error, on
# stderr, when the script fails. A caller that reads the answer in a command
# substitution must propagate the failure with '|| exit 1': the exit status of
# the substitution is otherwise lost, and the verb would continue on empty
# data as if the call had answered (CB-ERR-2, CB-CONC-5).
sqlite3_run() {
  local mode=$1 sql=$2 out status
  local -a flags=(-bail -cmd ".timeout 10000")
  [[ $mode == json ]] && flags+=(-json)
  out=$(sqlite3 "${flags[@]}" "$DB" "$sql" 2>"$ERRFILE")
  status=$?
  if ((status != 0)); then
    echo "cbugs: database error" >&2
    while IFS= read -r line; do
      [[ -n $line ]] && echo "cbugs: $line" >&2
    done <"$ERRFILE"
    exit 1
  fi
  printf '%s' "$out"
}

# sql_quote <text>   Escapes text for embedding inside a single-quoted
# SQL string literal.
sql_quote() {
  printf '%s' "${1//\'/\'\'}"
}

# like_escape <text>   Escapes text for embedding inside a LIKE pattern that
# uses backslash as its escape character.
like_escape() {
  local out=$1
  out=${out//\\/\\\\}
  out=${out//%/\\%}
  out=${out//_/\\_}
  sql_quote "$out"
}

# The data model. This mirrors docs/cbugs-schema.sql. Nothing here is ever
# changed or removed: the newest revision of a bug is its current state, and
# a row of reviewed commits never changes.
DB_VERSION=6

# The current-state view, which both the schema and the migration rebuild.
BUG_CURRENT_VIEW_SQL=$(cat <<'SQL'
CREATE VIEW IF NOT EXISTS bug_current AS
SELECT
  b.id                                                              AS id,
  b.kind                                                            AS kind,
  r.status                                                          AS status,
  r.title                                                           AS title,
  r.id                                                              AS revision_id,
  (SELECT MIN(created_at) FROM revision WHERE bug_id = b.id)        AS created_at,
  r.created_at                                                      AS updated_at
FROM bug AS b
JOIN revision AS r
  ON r.id = (SELECT MAX(id) FROM revision WHERE bug_id = b.id);
SQL
)

SCHEMA_SQL=$(cat <<SQL
BEGIN IMMEDIATE;

CREATE TABLE IF NOT EXISTS bug (
  id   INTEGER PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('code', 'spec', 'task'))
);

CREATE TABLE IF NOT EXISTS revision (
  id            INTEGER PRIMARY KEY,
  bug_id        INTEGER NOT NULL REFERENCES bug (id),
  status        TEXT NOT NULL CHECK (status IN ('open', 'closed', 'wontfix')),
  title         TEXT NOT NULL CHECK (title <> ''),
  note          TEXT NOT NULL,
  role          TEXT,
  iteration     INTEGER,
  commit_id     TEXT,
  created_at    TEXT NOT NULL,
  panel_run     TEXT CHECK (panel_run <> ''),
  panel_profile TEXT CHECK (panel_profile <> '')
);

CREATE INDEX IF NOT EXISTS revision_bug ON revision (bug_id, id);

CREATE TABLE IF NOT EXISTS citation (
  id          INTEGER PRIMARY KEY,
  revision_id INTEGER NOT NULL REFERENCES revision (id),
  path        TEXT NOT NULL CHECK (path <> ''),
  req         TEXT CHECK (req <> '')
);

CREATE INDEX IF NOT EXISTS citation_revision ON citation (revision_id, id);

CREATE TABLE IF NOT EXISTS reviewed (
  id         INTEGER PRIMARY KEY,
  commit_id  TEXT NOT NULL,
  iteration  INTEGER,
  created_at TEXT NOT NULL,
  profile    TEXT CHECK (profile <> '')
);

CREATE INDEX IF NOT EXISTS reviewed_commit ON reviewed (commit_id);

$BUG_CURRENT_VIEW_SQL
PRAGMA user_version = $DB_VERSION;
COMMIT;
SQL
)

# The migration from version 2 to version 3. It renames the kind 'user' to
# 'task', and nothing else. The CHECK of the bug table must accept the new
# value, so the table is rebuilt around the copied rows; the copy carries
# every id across, and the revisions and the citations are untouched. One
# transaction: a failure leaves the database as it was, and the next call
# tries again. BEGIN IMMEDIATE makes two callers that find the same old
# database serialize: the second waits on the lock, then proceeds against
# the database that the first one migrated.
MIGRATE_V2_3_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
DROP VIEW IF EXISTS bug_current;
CREATE TABLE bug_migrate (
  id   INTEGER PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('code', 'spec', 'task'))
);
INSERT INTO bug_migrate (id, kind)
  SELECT id, CASE kind WHEN 'user' THEN 'task' ELSE kind END FROM bug;
DROP TABLE bug;
ALTER TABLE bug_migrate RENAME TO bug;
$BUG_CURRENT_VIEW_SQL
PRAGMA user_version = 3;
COMMIT;
SQL
)

# The migration from version 3 to version 4. It creates the table of
# reviewed commits, and nothing else: every bug, every revision, and every
# citation is the same after it as before it (CB-MIG-8). One transaction,
# like the previous step.
MIGRATE_V3_4_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
CREATE TABLE IF NOT EXISTS reviewed (
  id         INTEGER PRIMARY KEY,
  commit_id  TEXT NOT NULL UNIQUE,
  iteration  INTEGER,
  created_at TEXT NOT NULL
);
PRAGMA user_version = 4;
COMMIT;
SQL
)

# The migration from version 4 to version 5. It drops the uniqueness of
# commit_id, so more than one review record can name the same commit, and
# adds the optional profile column. Every existing review id, full commit
# hash, iteration, and created_at value is preserved unchanged; each old
# record gets a NULL profile, which means unknown. It touches no bug,
# revision, or citation. One transaction, like the previous steps.
MIGRATE_V4_5_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
CREATE TABLE reviewed_migrate (
  id         INTEGER PRIMARY KEY,
  commit_id  TEXT NOT NULL,
  iteration  INTEGER,
  created_at TEXT NOT NULL,
  profile    TEXT CHECK (profile <> '')
);
INSERT INTO reviewed_migrate (id, commit_id, iteration, created_at, profile)
  SELECT id, commit_id, iteration, created_at, NULL FROM reviewed;
DROP TABLE reviewed;
ALTER TABLE reviewed_migrate RENAME TO reviewed;
CREATE INDEX IF NOT EXISTS reviewed_commit ON reviewed (commit_id);
PRAGMA user_version = $DB_VERSION;
COMMIT;
SQL
)

# The migration from version 5 to version 6. It adds the two panel columns to
# the revision table, and nothing else. The values describe the panel run and
# the canonical agent profile that the caller brought, which the environment
# already carries; every existing revision keeps NULL, which means the
# revision names no panel run (RP-RUN-5's shared contract gained its storage
# here). Every bug, citation, and review record is preserved unchanged. One
# transaction, like the previous steps.
MIGRATE_V5_6_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
ALTER TABLE revision ADD COLUMN panel_run TEXT CHECK (panel_run <> '');
ALTER TABLE revision ADD COLUMN panel_profile TEXT CHECK (panel_profile <> '');
PRAGMA user_version = $DB_VERSION;
COMMIT;
SQL
)

# init_db   Prepares the database before the command answers the call. It
# creates the database on first use, migrates a version 2, 3, 4, or 5
# database one step at a time -- one transaction per step -- and stops
# with an error when the version is one that this command does not know.
#
# The migration steps run under a lock of their own (CB-MIG-5), not only
# under the BEGIN IMMEDIATE of each step's own transaction. The version 4
# to 5 step rebuilds the reviewed table from whatever shape it finds; that
# is safe to run once, but not safe to replay against a database that a
# second caller already carried to version 5 in the meantime, because it
# would overwrite a profile that a third caller wrote after the first
# migration committed. Serializing the whole migration means a caller that
# waited on the lock re-reads the version once it has the lock and, when
# another caller already finished, finds nothing left to do.
init_db() {
  local ver
  ver=$(sqlite3_run raw "PRAGMA user_version;") || exit 1
  if [[ -z $ver || $ver == 0 ]]; then
    sqlite3_run raw "$SCHEMA_SQL" >/dev/null
    return
  fi
  [[ $ver == "$DB_VERSION" ]] && return
  exec 9>"$STATE_DIR/cbugs.db.migrate.lock" || exit 1
  # CB-CONC-5: wait for the lock only up to a bounded time, the same bound
  # as the sqlite busy timeout below, and then fail instead of blocking
  # forever behind a caller that died holding it.
  if ! flock -w 10 9; then
    echo "cbugs: timed out waiting for the migration lock on $DB" >&2
    exit 1
  fi
  ver=$(sqlite3_run raw "PRAGMA user_version;") || exit 1
  while [[ $ver != "$DB_VERSION" ]]; do
      case $ver in
        2) sqlite3_run raw "$MIGRATE_V2_3_SQL" >/dev/null ;;
        3) sqlite3_run raw "$MIGRATE_V3_4_SQL" >/dev/null ;;
        4) sqlite3_run raw "$MIGRATE_V4_5_SQL" >/dev/null ;;
        5) sqlite3_run raw "$MIGRATE_V5_6_SQL" >/dev/null ;;
        *)
          echo "cbugs: $DB is database version $ver, but this command knows version $DB_VERSION and migrates only versions 2, 3, 4, and 5" >&2
          exit 1
          ;;
    esac
    ver=$(sqlite3_run raw "PRAGMA user_version;") || exit 1
  done
  flock -u 9
  exec 9>&-
}
((HELP_REQUESTED)) || init_db

# ------------------------------------------------------------------ provenance
#
# The bug tracker reads the role and the iteration from the environment that
# converge exports, and the commit from the repository, so that a caller
# cannot get them wrong and a prompt does not have to carry them.

ROLE_SQL="NULL"
ITERATION_SQL="NULL"
COMMIT_SQL="NULL"
PANEL_RUN_SQL="NULL"
PANEL_PROFILE_SQL="NULL"
CREATED_AT=""

# provenance <commit override, or "">
#
# The panel fields supplement the role and the iteration that the loop
# exports. A command that runs one panel run exports REVIEW_PANEL_RUN and
# REVIEW_PANEL_PROFILE into every agent that it starts (a reviewer, and the
# merge agent); each revision therefore names the panel run it belongs to
# and the canonical profile that wrote it (RP-RUN-2, RP-RUN-5). A caller
# that sets neither keeps the plain authorship rules: both fields stay
# NULL, and the command refuses nothing (CB-PROV-1 through CB-PROV-5 hold
# as before). An empty value counts as an absent one.
provenance() {
  local override=$1 commit=""
  if [[ -n ${CONVERGE_ROLE:-} ]]; then
    ROLE_SQL="'$(sql_quote "$CONVERGE_ROLE")'"
  else
    ROLE_SQL="NULL"
  fi
  if [[ -n ${CONVERGE_ITERATION:-} ]] && is_number "$CONVERGE_ITERATION"; then
    ITERATION_SQL="$CONVERGE_ITERATION"
  else
    ITERATION_SQL="NULL"
  fi
  if [[ -n ${REVIEW_PANEL_RUN:-} ]]; then
    PANEL_RUN_SQL="'$(sql_quote "$REVIEW_PANEL_RUN")'"
  else
    PANEL_RUN_SQL="NULL"
  fi
  if [[ -n ${REVIEW_PANEL_PROFILE:-} ]]; then
    PANEL_PROFILE_SQL="'$(sql_quote "$REVIEW_PANEL_PROFILE")'"
  else
    PANEL_PROFILE_SQL="NULL"
  fi
  if [[ -n $override ]]; then
    commit=$override
  else
    commit=$(git -C "$REPO" rev-parse --verify -q HEAD 2>/dev/null || true)
  fi
  if [[ -n $commit ]]; then
    COMMIT_SQL="'$(sql_quote "$commit")'"
  else
    COMMIT_SQL="NULL"
  fi
  CREATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
}

# require_bug <id>   Stops with an error when no bug has this id.
require_bug() {
  local found
  # A database error must not name itself "no bug with id": the failure of
  # the query is a failure, and the empty answer of a success is the miss.
  found=$(sqlite3_run raw "SELECT 1 FROM bug WHERE id = $1;") || exit 1
  [[ -n $found ]] || { echo "cbugs: no bug with id $1" >&2; exit 1; }
}

# parse_id <text>   Prints the text back when it is a bug id. Stops otherwise.
parse_id() {
  is_number "${1:-}" || { echo "cbugs: '${1:-}' is not a bug id" >&2; exit 2; }
  printf '%s' "$1"
}

# resolve_note <verb> <note given?> <note value>
# Prints the final note text. Reads standard input when no note was given.
# add and note stop with an error when standard input is a terminal; the
# status verbs write an empty note instead, because the status change is
# already the record.
resolve_note() {
  local verb=$1 given=$2 value=$3
  if ((given)); then
    printf '%s' "$value"
    return
  fi
  if [[ -t 0 ]]; then
    case $verb in
      add|note)
        echo "cbugs: $verb needs --note, or a note on standard input" >&2
        exit 2
        ;;
      *)
        printf ''
        return
        ;;
    esac
  fi
  cat
}

# ------------------------------------------------------------------- output

# row_line <id> <kind> <status> <title>   One aligned, colored listing line.
row_line() {
  local id=$1 kind=$2 status=$3 title=$4 color=$DIM kind_color=$DIM
  case $status in
    open) color=$YELLOW ;;
    closed) color=$GREEN ;;
    wontfix) color=$DIM ;;
  esac
  # A spec bug waits for the human user, and no agent will act on it, so it
  # earns a touch of color that a reader notices without it competing with
  # the status column. A code bug and a task stay subdued, and different
  # from each other, so a reader sees which rows are punchlist items.
  case $kind in
    spec) kind_color=$MAGENTA ;;
    task) kind_color=$CYAN ;;
    code) kind_color=$DIM ;;
  esac
  printf '%4s  %s%-4s%s  %s%-7s%s  %s\n' \
    "$id" "$kind_color" "$kind" "$OFF" "$color" "$status" "$OFF" "$title"
}

# print_listing <rows json array> <json flag>
# Prints a listing of bugs. Prints nothing, and exits 0, when there is no row.
print_listing() {
  local rows=$1 json=$2 n
  n=$(jq 'length' <<<"$rows")
  ((n > 0)) || exit 0
  if ((json)); then
    printf '%s\n' "$rows"
    return
  fi
  local id kind status title
  while IFS=$'\t' read -r id kind status title; do
    row_line "$id" "$kind" "$status" "$title"
  done < <(jq -r '.[] | [.id, .kind, .status, .title] | @tsv' <<<"$rows")
}

# print_bug <id> <json flag>   Prints one bug's current state, after a write.
print_bug() {
  local id=$1 json=$2 row
  row=$(sqlite3_run json "SELECT id, kind, status, title FROM bug_current WHERE id = $id;") || exit 1
  if ((json)); then
    jq -M '.[0]' <<<"$row"
    return
  fi
  local kind status title
  IFS=$'\t' read -r id kind status title < <(jq -r '.[0] | [.id, .kind, .status, .title] | @tsv' <<<"$row")
  row_line "$id" "$kind" "$status" "$title"
}

# where_clause <kinds[]> -- <statuses[]>   Builds the shared filter of
# list/search. Several values of one option mean their union, so a caller can
# ask for the open code bugs and the open tasks in one call.
where_clause() {
  local -a kinds=()
  local -a statuses=()
  local target=kinds
  while (($#)); do
    if [[ $1 == -- ]]; then
      target=statuses
    elif [[ $target == kinds ]]; then
      kinds+=("$1")
    else
      statuses+=("$1")
    fi
    shift
  done
  local -a clauses=()
  if ((${#kinds[@]})); then
    local list="" k
    for k in "${kinds[@]}"; do
      list+="${list:+,}'$(sql_quote "$k")'"
    done
    clauses+=("kind IN ($list)")
  fi
  if ((${#statuses[@]})); then
    local list="" s
    for s in "${statuses[@]}"; do
      list+="${list:+,}'$(sql_quote "$s")'"
    done
    clauses+=("status IN ($list)")
  fi
  local out="" c
  for c in ${clauses[@]+"${clauses[@]}"}; do
    out+="${out:+ AND }$c"
  done
  printf '%s' "$out"
}

# panel_clause <panel run id>   SQL that selects the bugs whose first revision
# the given panel run wrote: the first revision of a bug is its report, so
# its panel fields name the panel run that created the bug (RP-RUN-2). The
# caller embeds the id with sql_quote.
panel_clause() {
  printf '%s' "EXISTS (SELECT 1 FROM revision fp WHERE fp.bug_id = bc.id AND fp.id = (SELECT MIN(f2.id) FROM revision f2 WHERE f2.bug_id = bc.id) AND fp.panel_run = '$(sql_quote "$1")')"
}

# parse_panel_run <value>   Stops when the value is empty; a panel run id is
# the identity of the selection, and an empty one selects nothing.
parse_panel_run() {
  [[ -n $1 ]] || { echo "cbugs: --panel-run must name a panel run id" >&2; exit 2; }
  printf '%s' "$1"
}

# validate_kind <kind> [allow-empty]   Stops with an error unless the kind is
# code, spec, or task. With allow-empty set to 1, an empty kind passes, for a
# caller that checks "required" itself.
validate_kind() {
  local allow_empty=${2:-0}
  [[ -z $1 && $allow_empty == 1 ]] && return 0
  [[ $1 == code || $1 == spec || $1 == task ]] || {
    echo "cbugs: --kind must be 'code', 'spec', or 'task', got '$1'" >&2
    exit 2
  }
}

# title_is_one_line <verb> <text>   Stops with an error when the text holds a
# newline. CB-REV-1.2 gives the title one line that names the defect.
title_is_one_line() {
  [[ $2 != *$'\n'* ]] || {
    echo "cbugs $1: --title must be one line; it holds a newline" >&2
    exit 2
  }
}

# validate_status <status>   Stops with an error unless the status is valid.
validate_status() {
  [[ $1 == open || $1 == closed || $1 == wontfix ]] || {
    echo "cbugs: --status must be 'open', 'closed', or 'wontfix', got '$1'" >&2
    exit 2
  }
}

# --------------------------------------------------------------- citations
#
# A citation is validated when the option is parsed, so a bad value fails
# before the command writes anything. CITE_PATHS and CITE_REQS hold the
# values of the current call, in order given, with an identical (path, id)
# pair recorded once.

CITE_PATHS=()
CITE_REQS=()

# add_citation <path[:id]>   Validates one --cite value and records it.
add_citation() {
  local value=$1 path req="" has_colon=0 test_path i
  if [[ $value == *:* ]]; then
    has_colon=1
    path=${value%:*}
    req=${value##*:}
  else
    path=$value
  fi
  if [[ -z $path ]]; then
    echo "cbugs: --cite '$value' has an empty path" >&2
    exit 2
  fi
  if ((has_colon)) && [[ -z $req ]]; then
    echo "cbugs: --cite '$value' has an empty identifier after the colon" >&2
    exit 2
  fi
  test_path=$path
  [[ $path == /* ]] || test_path="$RUN_DIR/$path"
  # The citation must name a requirements document, and a document is a
  # file: a directory names no file, so it fails the same test as a path
  # that no one invented a document under (CB-CITE-7).
  if [[ ! -f $test_path ]]; then
    echo "cbugs: --cite path '$path' names no file" >&2
    exit 2
  fi
  for i in ${CITE_PATHS[@]+"${!CITE_PATHS[@]}"}; do
    [[ ${CITE_PATHS[$i]} == "$path" && ${CITE_REQS[$i]} == "$req" ]] && return 0
  done
  CITE_PATHS+=("$path")
  CITE_REQS+=("$req")
}

# citation_sql   SQL that inserts the recorded citations against the revision
# that the surrounding statement is about to write. BEGIN IMMEDIATE holds the
# write lock for the whole script, so "the newest revision" stays the one
# this call just inserted until this same script commits.
citation_sql() {
  local out="" i req_sql
  for i in ${CITE_PATHS[@]+"${!CITE_PATHS[@]}"}; do
    if [[ -n ${CITE_REQS[$i]} ]]; then
      req_sql="'$(sql_quote "${CITE_REQS[$i]}")'"
    else
      req_sql="NULL"
    fi
    out+="
INSERT INTO citation (revision_id, path, req)
SELECT id, '$(sql_quote "${CITE_PATHS[$i]}")', $req_sql FROM revision ORDER BY id DESC LIMIT 1;"
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------- add

verb_add() {
  local title="" title_set=0 kind="" note="" note_set=0 commit="" json=0
  while (($#)); do
    case $1 in
      --title) need_value "$1" $#; title=$2; title_set=1; shift 2 ;;
      --title=*) title=${1#*=}; title_set=1; shift ;;
      --kind) need_value "$1" $#; kind=$2; shift 2 ;;
      --kind=*) kind=${1#*=}; shift ;;
      --note) need_value "$1" $#; note=$2; note_set=1; shift 2 ;;
      --note=*) note=${1#*=}; note_set=1; shift ;;
      --cite) need_value "$1" $#; add_citation "$2"; shift 2 ;;
      --cite=*) add_citation "${1#*=}"; shift ;;
      --commit) need_value "$1" $#; commit=$2; shift 2 ;;
      --commit=*) commit=${1#*=}; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_add; exit 0 ;;
      *) echo "cbugs add: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  validate_kind "$kind" 1
  [[ -n $kind ]] || { echo "cbugs add: --kind is required" >&2; exit 2; }
  ((title_set)) || { echo "cbugs add: --title is required" >&2; exit 2; }
  [[ -n $title ]] || { echo "cbugs add: --title must not be empty" >&2; exit 2; }
  title_is_one_line add "$title"
  if [[ $kind == task && -n ${CONVERGE_ROLE:-} ]]; then
    echo "cbugs add: a task records a request from a human user; refused for role '$CONVERGE_ROLE'" >&2
    exit 1
  fi

  note=$(resolve_note add "$note_set" "$note") || exit $?
  provenance "$commit"

  # The citation inserts that citation_sql adds below run after the revision
  # insert, so last_insert_rowid() no longer names the revision once they have
  # run: it names the last citation instead, and looks up the wrong bug. Read
  # the id the same way citation_sql finds its revision -- ORDER BY id DESC,
  # not last_insert_rowid() -- and read it before COMMIT, while BEGIN
  # IMMEDIATE still holds the write lock, so no concurrent add can be newer.
  local id
  id=$(sqlite3_run raw "
BEGIN IMMEDIATE;
INSERT INTO bug (kind) VALUES ('$(sql_quote "$kind")');
INSERT INTO revision (bug_id, status, title, note, role, iteration, commit_id, created_at, panel_run, panel_profile)
VALUES (last_insert_rowid(), 'open', '$(sql_quote "$title")', '$(sql_quote "$note")', $ROLE_SQL, $ITERATION_SQL, $COMMIT_SQL, '$CREATED_AT', $PANEL_RUN_SQL, $PANEL_PROFILE_SQL);
$(citation_sql)
SELECT bug_id FROM revision ORDER BY id DESC LIMIT 1;
COMMIT;
") || exit 1
  if ((json)); then
    printf '{"id": %s}\n' "$id"
  else
    printf '%s\n' "$id"
  fi
}

# ------------------------------------------------------ note and the status verbs

# write_revision <id> <status expr> <note>   Writes one revision, keeping the
# title of the previous revision unless the caller gave a new one.
write_revision() {
  local id=$1 status_expr=$2 note=$3 title_expr="r.title"
  if [[ -n ${TITLE_OVERRIDE:-} ]]; then
    title_expr="'$(sql_quote "$TITLE_OVERRIDE")'"
  fi
  sqlite3_run raw "
BEGIN IMMEDIATE;
INSERT INTO revision (bug_id, status, title, note, role, iteration, commit_id, created_at, panel_run, panel_profile)
SELECT $id, $status_expr, $title_expr, '$(sql_quote "$note")', $ROLE_SQL, $ITERATION_SQL, $COMMIT_SQL, '$CREATED_AT', $PANEL_RUN_SQL, $PANEL_PROFILE_SQL
FROM revision r WHERE r.bug_id = $id ORDER BY r.id DESC LIMIT 1;
$(citation_sql)
COMMIT;
" >/dev/null
}

verb_note() {
  local id_arg="" note="" note_set=0 pos_note_set=0 commit="" json=0 title_set=0
  TITLE_OVERRIDE=""
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_note; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_note; exit 2; }
  id_arg=$1; shift
  if [[ $# -ge 1 && $1 != -* ]]; then
    note=$1; note_set=1; pos_note_set=1; shift
  fi
  while (($#)); do
    case $1 in
      --note) need_value "$1" $#; ((pos_note_set)) || { note=$2; note_set=1; }; shift 2 ;;
      --note=*) ((pos_note_set)) || { note=${1#*=}; note_set=1; }; shift ;;
      --title) need_value "$1" $#; TITLE_OVERRIDE=$2; title_set=1; shift 2 ;;
      --title=*) TITLE_OVERRIDE=${1#*=}; title_set=1; shift ;;
      --cite) need_value "$1" $#; add_citation "$2"; shift 2 ;;
      --cite=*) add_citation "${1#*=}"; shift ;;
      --commit) need_value "$1" $#; commit=$2; shift 2 ;;
      --commit=*) commit=${1#*=}; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_note; exit 0 ;;
      *) echo "cbugs note: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  ((title_set)) && [[ -z $TITLE_OVERRIDE ]] && { echo "cbugs note: --title must not be empty" >&2; exit 2; }
  ((title_set)) && title_is_one_line note "$TITLE_OVERRIDE"
  local id; id=$(parse_id "$id_arg") || exit $?
  require_bug "$id"
  note=$(resolve_note note "$note_set" "$note") || exit $?
  provenance "$commit"
  write_revision "$id" "r.status" "$note"
  print_bug "$id" "$json"
}

# verb_status_change <verb> <status> <args...>
verb_status_change() {
  local verb=$1 status=$2; shift 2
  local id_arg="" note="" note_set=0 commit="" json=0 title_set=0
  TITLE_OVERRIDE=""
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_status_verb "$verb" "$status"; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_status_verb "$verb" "$status"; exit 2; }
  id_arg=$1; shift
  while (($#)); do
    case $1 in
      --note) need_value "$1" $#; note=$2; note_set=1; shift 2 ;;
      --note=*) note=${1#*=}; note_set=1; shift ;;
      --title) need_value "$1" $#; TITLE_OVERRIDE=$2; title_set=1; shift 2 ;;
      --title=*) TITLE_OVERRIDE=${1#*=}; title_set=1; shift ;;
      --cite) need_value "$1" $#; add_citation "$2"; shift 2 ;;
      --cite=*) add_citation "${1#*=}"; shift ;;
      --commit) need_value "$1" $#; commit=$2; shift 2 ;;
      --commit=*) commit=${1#*=}; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_status_verb "$verb" "$status"; exit 0 ;;
      *) echo "cbugs $verb: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  ((title_set)) && [[ -z $TITLE_OVERRIDE ]] && { echo "cbugs $verb: --title must not be empty" >&2; exit 2; }
  ((title_set)) && title_is_one_line "$verb" "$TITLE_OVERRIDE"
  local id; id=$(parse_id "$id_arg") || exit $?
  require_bug "$id"
  note=$(resolve_note "$verb" "$note_set" "$note") || exit $?
  provenance "$commit"
  write_revision "$id" "'$status'" "$note"
  print_bug "$id" "$json"
}

# --------------------------------------------------------------- list, show, search

verb_list() {
  local json=0 panel_run=""
  local -a kinds=() statuses=()
  while (($#)); do
    case $1 in
      --kind) need_value "$1" $#; kinds+=("$2"); shift 2 ;;
      --kind=*) kinds+=("${1#*=}"); shift ;;
      --status) need_value "$1" $#; statuses+=("$2"); shift 2 ;;
      --status=*) statuses+=("${1#*=}"); shift ;;
      --panel-run) need_value "$1" $#; panel_run=$(parse_panel_run "$2"); shift 2 ;;
      --panel-run=*) panel_run=$(parse_panel_run "${1#*=}"); shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_list; exit 0 ;;
      *) echo "cbugs list: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local s
  for s in ${kinds[@]+"${kinds[@]}"}; do validate_kind "$s"; done
  for s in ${statuses[@]+"${statuses[@]}"}; do validate_status "$s"; done

  local where rows
  where=$(where_clause ${kinds[@]+"${kinds[@]}"} -- ${statuses[@]+"${statuses[@]}"})
  rows=$(sqlite3_run json "
SELECT id, kind, status, title FROM bug_current bc
${where:+WHERE $where}${panel_run:+$([ -n "$where" ] && printf ' AND ')$(panel_clause "$panel_run")}
ORDER BY revision_id DESC;
") || exit 1
  print_listing "$rows" "$json"
}

verb_show() {
  local id_arg="" json=0
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_show; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_show; exit 2; }
  id_arg=$1; shift
  while (($#)); do
    case $1 in
      --json) json=1; shift ;;
      -h|--help) usage_show; exit 0 ;;
      *) echo "cbugs show: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local id; id=$(parse_id "$id_arg") || exit $?
  require_bug "$id"

  local bug revs cites
  bug=$(sqlite3_run json "SELECT id, kind, status, title FROM bug_current WHERE id = $id;") || exit 1
  revs=$(sqlite3_run json "
SELECT id, status, title, note, role, iteration, commit_id, created_at, panel_run, panel_profile
FROM revision WHERE bug_id = $id ORDER BY id ASC;
") || exit 1
  cites=$(sqlite3_run json "
SELECT c.revision_id, c.path, c.req
FROM citation c JOIN revision r ON r.id = c.revision_id
WHERE r.bug_id = $id ORDER BY c.id ASC;
") || exit 1
  # sqlite3 -json prints nothing at all, not "[]", when a query matches no
  # row. A bug with no citation on any revision must still show its
  # revisions, so jq --argjson needs a valid empty array here.
  [[ -n $cites ]] || cites='[]'
  # Every revision carries the citations that it wrote, so a reader of the
  # JSON sees which requirement each role named, and when, the same way the
  # human form does.
  revs=$(jq --argjson cites "$cites" '
    map(. as $r | $r + {
      citations: [$cites[] | select(.revision_id == $r.id) | {path, req}]
    })
  ' <<<"$revs")
  if ((json)); then
    jq -M --argjson revisions "$revs" '.[0] + {revisions: $revisions}' <<<"$bug"
    return
  fi

  local bid kind status title
  IFS=$'\t' read -r bid kind status title < <(jq -r '.[0] | [.id, .kind, .status, .title] | @tsv' <<<"$bug")
  printf '%s#%s%s  %s%s%s  %s  %s\n' "$BOLD" "$bid" "$OFF" "$DIM" "$kind" "$OFF" "$status" "$title"
  printf '\n%srevisions%s\n' "$BOLD" "$OFF"
  local rid rstatus rtitle rnote rrole riter rcommit rcreated meta rcite
  local rpanelrun rpanelprofile
  while IFS=$'\t' read -r rid rstatus rtitle rrole riter rcommit rcreated rpanelrun rpanelprofile; do
    # A field that is null in the data comes through as "-", a placeholder
    # that no real role, iteration, or commit id ever equals. IFS-tab
    # splitting collapses a genuinely empty field, which would misalign
    # every field after it, so an empty placeholder is not an option here.
    meta="?"
    [[ $rrole == "-" ]] || meta="$rrole"
    [[ $riter == "-" ]] || meta+=" iter $riter"
    [[ $rcommit == "-" ]] || meta+=" @${rcommit:0:8}"
    # The panel fields name the panel run and the canonical profile of the
    # agent that wrote the revision (RP-RUN-2). A plain caller wrote none,
    # and shows neither.
    [[ $rpanelrun == "-" ]] || meta+=" panel run $rpanelrun"
    [[ $rpanelprofile == "-" ]] || meta+=" profile $rpanelprofile"
    printf '  %s%s%s  %s  %s%s%s\n' "$DIM" "$rcreated" "$OFF" "$rstatus" "$DIM" "$meta" "$OFF"
    printf '    %s\n' "$rtitle"
    rnote=$(jq -r --argjson i "$rid" '.[] | select(.id == $i) | .note' <<<"$revs")
    if [[ -n $rnote ]]; then
      while IFS= read -r line; do
        printf '      %s%s%s\n' "$DIM" "$line" "$OFF"
      done <<<"$rnote"
    fi
    while IFS= read -r rcite; do
      [[ -n $rcite ]] && printf '      %scite%s %s\n' "$DIM" "$OFF" "$rcite"
    done < <(jq -r --argjson i "$rid" \
      '.[] | select(.id == $i) | .citations[] | .path + (if .req then ":" + .req else "" end)' \
      <<<"$revs")
  done < <(jq -r '.[] | [.id, .status, .title, (.role // "-"), (.iteration // "-"), (.commit_id // "-"), .created_at, (.panel_run // "-"), (.panel_profile // "-")] | @tsv' <<<"$revs")
}

verb_search() {
  local text="" json=0 panel_run=""
  local -a kinds=() statuses=()
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_search; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_search; exit 2; }
  text=$1; shift
  while (($#)); do
    case $1 in
      --kind) need_value "$1" $#; kinds+=("$2"); shift 2 ;;
      --kind=*) kinds+=("${1#*=}"); shift ;;
      --status) need_value "$1" $#; statuses+=("$2"); shift 2 ;;
      --status=*) statuses+=("${1#*=}"); shift ;;
      --panel-run) need_value "$1" $#; panel_run=$(parse_panel_run "$2"); shift 2 ;;
      --panel-run=*) panel_run=$(parse_panel_run "${1#*=}"); shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_search; exit 0 ;;
      *) echo "cbugs search: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local s
  for s in ${kinds[@]+"${kinds[@]}"}; do validate_kind "$s"; done
  for s in ${statuses[@]+"${statuses[@]}"}; do validate_status "$s"; done

  local where pattern rows panel_extra=""
  [[ -z $panel_run ]] || panel_extra=" AND $(panel_clause "$panel_run")"
  where=$(where_clause ${kinds[@]+"${kinds[@]}"} -- ${statuses[@]+"${statuses[@]}"})
  pattern="%$(like_escape "$text")%"
  rows=$(sqlite3_run json "
SELECT id, kind, status, title FROM bug_current bc
WHERE ${where:+$where AND }EXISTS (
  SELECT 1 FROM revision rv
  WHERE rv.bug_id = bc.id
    AND (LOWER(rv.title) LIKE LOWER('$pattern') ESCAPE '\\'
      OR LOWER(rv.note) LIKE LOWER('$pattern') ESCAPE '\\'
      OR EXISTS (
        SELECT 1 FROM citation c
        WHERE c.revision_id = rv.id
          AND (LOWER(c.path) LIKE LOWER('$pattern') ESCAPE '\\'
            OR LOWER(COALESCE(c.req, '')) LIKE LOWER('$pattern') ESCAPE '\\')
      ))
)$panel_extra
ORDER BY revision_id DESC;
") || exit 1
  print_listing "$rows" "$json"
}

# ------------------------------------------------------------- reviewed verbs
#
# The database holds the commits that a review pass of converge covered, as
# CB-RVW-1 gives. The loop records them, and no agent records one: a call
# of reviewed add from an agent of the loop stops with an error. reviewed
# pending changes nothing, and every caller may run it.

# count_pending <json>   One shared reader for both forms: prints one line
# per unreviewed commit -- "<hash>\t<subject>" -- or nothing, and exits 0,
# when no commit is unreviewed or the repository holds no commit (CB-RVW-8).
# The command reads the repository at the time of the call: git rev-list
# walks HEAD now, and the rows of the reviewed table are the names that no
# pass recorded yet.
count_pending() {
  local -a pending=()
  local reachable="" row hash subject
  # No commit, or no reachable history: print nothing, exit 0.
  reachable=$(git -C "$REPO" rev-list HEAD 2>/dev/null || true)
  [[ -n $reachable ]] || return 0
  while IFS= read -r row; do
    [[ -n $row ]] && pending+=("$row")
  done <<<"$reachable"
  # A row names one commit, and nothing else can name the same one, so the
  # names land in a set keyed by the full hash.
  local -A named=()
  local rows_out
  rows_out=$(sqlite3_run raw "SELECT commit_id FROM reviewed;") || exit 1
  while IFS= read -r row; do
    [[ -n $row ]] && named[$row]=1
  done <<<"$rows_out"
  local -a unseen=()
  for row in ${pending[@]+"${pending[@]}"}; do
    [[ -n ${named[$row]:-} ]] || unseen+=("$row")
  done
  ((${#unseen[@]} > 0)) || return 0
  for hash in ${unseen[@]+"${unseen[@]}"}; do
    # Read the subject now, so the two columns describe the repository at
    # the same moment for every one of the lines.
    subject=$(git -C "$REPO" show -s --format=%s "$hash" 2>/dev/null || true)
    printf '%s\t%s\n' "$hash" "$subject"
  done
}

verb_reviewed_pending() {
  local json=0 line
  while (($#)); do
    case $1 in
      --json) json=1; shift ;;
      -h|--help) usage_reviewed_pending; exit 0 ;;
      *) echo "cbugs reviewed pending: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local -a lines=() elems=()
  local pending_out
  # The call substitution carries the status of count_pending, so a database
  # error stops the verb with a non-zero status (CB-ERR-2), and does not
  # leave an empty listing that holds the status 0 against CB-RVW-8.
  pending_out=$(count_pending) || exit 1
  if [[ -n $pending_out ]]; then
    mapfile -t lines <<<"$pending_out"
  fi
  ((${#lines[@]} > 0)) || exit 0
  if ((json)); then
    for line in ${lines[@]+"${lines[@]}"}; do
      hash=${line%%$'\t'*}
      subject=${line#*$'\t'}
      elems+=("$(jq -Mcn --arg c "$hash" --arg s "$subject" '{commit_id: $c, subject: $s}')")
    done
    printf '%s\n' "${elems[@]}" | jq -M -s .
    exit 0
  fi
  for line in ${lines[@]+"${lines[@]}"}; do
    printf '%s %s\n' "${line%%$'\t'*}" "${line#*$'\t'}"
  done
  exit 0
}

verb_reviewed_add() {
  local iter="" json=0 value profile="" profile_set=0 completed_at="" completed_at_set=0
  local -a commits=() named=() resolved=() absent=()
  while (($#)); do
    case $1 in
      --iteration) need_value "$1" $#; iter=$2; shift 2 ;;
      --iteration=*) iter=${1#*=}; shift ;;
      --profile)
        ((! profile_set)) || { echo "cbugs reviewed add: --profile given more than once" >&2; exit 2; }
        need_value "$1" $#; profile=$2; profile_set=1; shift 2
        ;;
      --profile=*)
        ((! profile_set)) || { echo "cbugs reviewed add: --profile given more than once" >&2; exit 2; }
        profile=${1#*=}; profile_set=1; shift
        ;;
      --completed-at)
        ((! completed_at_set)) || { echo "cbugs reviewed add: --completed-at given more than once" >&2; exit 2; }
        need_value "$1" $#; completed_at=$2; completed_at_set=1; shift 2
        ;;
      --completed-at=*)
        ((! completed_at_set)) || { echo "cbugs reviewed add: --completed-at given more than once" >&2; exit 2; }
        completed_at=${1#*=}; completed_at_set=1; shift
        ;;
      --json) json=1; shift ;;
      -h|--help) usage_reviewed_add; exit 0 ;;
      -*) echo "cbugs reviewed add: unexpected argument '$1'" >&2; exit 2 ;;
      *) commits+=("$1"); shift ;;
    esac
  done
  [[ -z $iter ]] || is_number "$iter" || {
    echo "cbugs reviewed add: --iteration needs a whole number, got '$iter'" >&2
    exit 2
  }
  # A supplied profile must be harness:model[:effort], where the harness is
  # claude or opencode and every field is nonempty with no colon, comma, or
  # whitespace; a slash is allowed. The command stores the caller's string
  # unchanged (CB-RVW-14). This runs before any commit is resolved, so an
  # invalid profile fails before any record is written.
  if ((profile_set)); then
    [[ $profile =~ ^(claude|opencode):[^:,[:space:]]+(:[^:,[:space:]]+)?$ ]] || {
      echo "cbugs reviewed add: --profile '$profile' must be claude:model[:effort] or opencode:model[:effort], with nonempty fields and no colon, comma, or whitespace" >&2
      exit 2
    }
  fi
  # A supplied completion time must be a valid UTC date and time in
  # YYYY-MM-DDTHH:MM:SSZ form (CB-RVW-15). Re-formatting the parsed value and
  # comparing it back catches a calendar date that does not exist, which GNU
  # date would otherwise silently normalize.
  if ((completed_at_set)); then
    local reformatted=""
    if [[ $completed_at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
      reformatted=$(date -u -d "$completed_at" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
    fi
    [[ -n $reformatted && $reformatted == "$completed_at" ]] || {
      echo "cbugs reviewed add: --completed-at '$completed_at' must be a valid UTC timestamp in YYYY-MM-DDTHH:MM:SSZ form" >&2
      exit 2
    }
  fi
  # The loop records the commits of a pass, and no agent of the loop records
  # one. The error names the role that the call read. reviewed pending
  # changes nothing, so every caller may run it (CB-RVW-7).
  if [[ -n ${CONVERGE_ROLE:-} ]]; then
    echo "cbugs reviewed add: the loop records the commits of a pass, and no agent of the loop records one; refused for role '$CONVERGE_ROLE'" >&2
    exit 1
  fi
  # The values come as arguments, or one per line on standard input (CB-RVW-6).
  # A call that names the commits as arguments reads no standard input: an
  # operator who runs the call on a terminal must not wait for EOF, in the
  # way that CB-WRITE-3 gives for the note of the write verbs.
  if ((0 == ${#commits[@]})); then
    if [[ -t 0 ]]; then
      echo "cbugs reviewed add: name the commits to record, as arguments or on standard input, one per line" >&2
      exit 2
    fi
    while IFS=$' \t\r' read -r value || [[ -n $value ]]; do
      [[ -n $value ]] && commits+=("$value")
    done
  fi
  # One commit is one value: the same value twice, or two values that name
  # the same commit, add one row and count once.
  local -A seen=()
  for value in ${commits[@]+"${commits[@]}"}; do
    [[ -n ${seen[$value]:-} ]] || { seen[$value]=1; named+=("$value"); }
  done
  ((0 < ${#named[@]})) || {
    echo "cbugs reviewed add: name the commits to record, as arguments or on standard input, one per line" >&2
    exit 2
  }
  # Resolve every value before the transaction writes anything, so a call
  # that names an unknown commit records nothing (CB-RVW-10). The messages
  # name the value the caller gave, so resolution keeps each candidate in a
  # second variable.
  local -A resolved_seen=() candidate
  for value in ${named[@]+"${named[@]}"}; do
    candidate=$(git -C "$REPO" rev-parse --verify "${value}^{commit}" 2>/dev/null) || {
      echo "cbugs reviewed add: '$value' names no commit of the repository" >&2
      exit 2
    }
    [[ -n ${resolved_seen[$candidate]:-} ]] || {
      resolved_seen[$candidate]=1
      resolved+=("$candidate")
    }
  done
  CREATED_AT=$completed_at
  ((completed_at_set)) || CREATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  # One transaction for the whole call (CB-RVW-13). The EXISTS probes run
  # inside it, so the printed counts describe the database under the write
  # lock, and no concurrent call can slip between "already covered" and the
  # insert. Every distinct resolved commit gets one new, immutable record in
  # this call, even when a row already names it (CB-RVW-12). A temp table
  # holds the candidates: SQLite gives a VALUES table no alias to name its
  # column with, and both statements below read the same names.
  local values_sql="" out hash profile_sql=NULL
  ((! profile_set)) || profile_sql="'$(sql_quote "$profile")'"
  for hash in ${resolved[@]+"${resolved[@]}"}; do
    values_sql+="${values_sql:+,}('$(sql_quote "$hash")')"
  done
  out=$(sqlite3_run raw "
BEGIN IMMEDIATE;
DROP TABLE IF EXISTS temp.reviewed_add;
CREATE TEMP TABLE reviewed_add (c TEXT NOT NULL);
INSERT INTO reviewed_add (c) VALUES $values_sql;
SELECT EXISTS(SELECT 1 FROM reviewed WHERE commit_id = reviewed_add.c) FROM reviewed_add;
INSERT INTO reviewed (commit_id, iteration, created_at, profile)
SELECT c, ${iter:-NULL}, '$CREATED_AT', $profile_sql FROM reviewed_add;
COMMIT;
") || exit 1
  # Every commit answers one probe line: whether a row already named it
  # before this call. added counts every new record this call wrote, which
  # is one per distinct resolved commit; already counts input commits that
  # had any record before the call (CB-RVW-17).
  local already=0 n=${#resolved[@]} i
  local -a probe_rows=()
  mapfile -t probe_rows <<<"$out"
  for ((i = 0; i < n; i++)); do
    [[ ${probe_rows[$i]} == 1 ]] && ((++already))
  done
  if ((json)); then
    local -a profile_arg=(--arg profile "" --argjson has_profile false)
    ((! profile_set)) || profile_arg=(--arg profile "$profile" --argjson has_profile true)
    jq -Mcn --argjson added "$n" --argjson already "$already" --arg created_at "$CREATED_AT" \
      "${profile_arg[@]}" \
      '{added: $added, already: $already, profile: (if $has_profile then $profile else null end), created_at: $created_at}'
  else
    printf 'added %s, %s that a row already named, profile %s, completed at %s\n' \
      "$(plural "$n" commit)" "$(plural "$already" commit)" "${profile:-unknown}" "$CREATED_AT"
  fi
}

# verb_summary   Prints what a caller most probably wants when it runs cbugs
# with no argument: the ten open bugs with the newest revision, in every
# kind, then a short footer naming the other verbs. Takes no option, has no
# --json form, and always exits 0.
verb_summary() {
  local rows total n
  rows=$(sqlite3_run json "
SELECT id, kind, status, title FROM bug_current
WHERE status = 'open' ORDER BY revision_id DESC LIMIT 10;
") || exit 1
  [[ -n $rows ]] || rows='[]'
  n=$(jq 'length' <<<"$rows")
  total=$(sqlite3_run raw "SELECT COUNT(*) FROM bug_current WHERE status = 'open';") || exit 1
  is_number "$total" || total=0

  if ((n > 0)); then
    local id kind status title
    while IFS=$'\t' read -r id kind status title; do
      row_line "$id" "$kind" "$status" "$title"
    done < <(jq -r '.[] | [.id, .kind, .status, .title] | @tsv' <<<"$rows")
  else
    printf '%sno bug is open%s\n' "$DIM" "$OFF"
  fi

  if ((total > n)); then
    local rest=$((total - n)) word=bugs
    ((rest == 1)) && word=bug
    printf '%s%s more open %s; see cbugs list --status open%s\n' \
      "$DIM" "$rest" "$word" "$OFF"
  fi
  printf '%sVerbs: add, list, show, search, note, close, dismiss, reopen, reviewed add, reviewed pending.%s\n' "$DIM" "$OFF"
  printf '%sRun %scbugs --help%s%s for the options of each.%s\n' "$DIM" "$BOLD" "$OFF" "$DIM" "$OFF"
}

# ------------------------------------------------------------------- dispatch

if (($# == 0)); then
  verb_summary
  exit 0
fi
VERB=$1; shift
case $VERB in
  -h|--help) usage; exit 0 ;;
  add) verb_add "$@" ;;
  note) verb_note "$@" ;;
  close) verb_status_change close closed "$@" ;;
  dismiss) verb_status_change dismiss wontfix "$@" ;;
  reopen) verb_status_change reopen open "$@" ;;
  list) verb_list "$@" ;;
  show) verb_show "$@" ;;
  search) verb_search "$@" ;;
  reviewed)
    # The reviewed verb holds two sub-verbs (CB-RVW-5): a bare 'reviewed'
    # names no verb on its own and must say which two exist. Both sub-verbs
    # read the repository (CB-RVW-8, CB-RVW-10), so a call that answers must
    # find git on PATH: without it, pending would print nothing under a
    # silence that reads as an answer (CB-PLAT-2). But 'reviewed add --help'
    # and 'reviewed pending --help' must work without git too (CB-INV-7), the
    # same as every other verb's --help, so the check is skipped when the
    # top-level scan already found -h/--help among the arguments.
    case ${1:-} in
      add) shift; ((HELP_REQUESTED)) || need_tool git git; verb_reviewed_add "$@" ;;
      pending) shift; ((HELP_REQUESTED)) || need_tool git git; verb_reviewed_pending "$@" ;;
      -h|--help) usage_reviewed; exit 0 ;;
      "")
        echo "cbugs reviewed: name a sub-verb: 'reviewed add' or 'reviewed pending'" >&2
        exit 2
        ;;
      *)
        echo "cbugs reviewed: no such sub-verb 'reviewed ${1:-}'; use 'reviewed add' or 'reviewed pending'" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    # No verb is a whole number, so a bare id can never collide with one. A
    # reader who saw the id in a listing can type it alone.
    if is_number "$VERB"; then
      verb_show "$VERB" "$@"
    else
      echo "cbugs: no such verb '$VERB'" >&2
      usage
      exit 2
    fi
    ;;
esac
