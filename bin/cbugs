#!/usr/bin/env bash
# Bug tracker for one converge project.
#
# See docs/cbugs-requirements.md for the required behavior and
# docs/cbugs-schema.sql for the data model that this script keeps in sync.
set -uo pipefail

# The script uses bash 4.3 syntax: fill_vis needs nameref syntax. macOS
# supplies bash 3.2. This test must stay above the first use of that syntax,
# because bash parses a script as it runs.
if ((BASH_VERSINFO[0] < 4)) || \
  ((BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3)); then
  echo "cbugs: bash ${BASH_VERSION} is too old; bash 4.3 or later is needed" >&2
  echo "cbugs: on macOS, run 'brew install bash'" >&2
  exit 2
fi

usage() {
  cat >&2 <<'EOF'
Usage: cbugs <verb> [options]

Verbs:
  add      Log a new bug.
  list     List bugs.
  show     Show one bug in full, with its revisions.
  search   Find bugs by text in titles, notes, or citations.
  note     Add a note to a bug, without changing its status.
  close    Mark a bug closed: the defect is gone.
  dismiss  Mark a bug wontfix: no one will act on it.
  reopen   Mark a bug open again.
  reviewed Record the commits that a review pass covered (add), or print
           the commits that no pass has recorded yet (pending).

Run 'cbugs <verb> --help' for the options of one verb.
Every verb accepts --json.

'cbugs <id>' is the same as 'cbugs show <id>'.
Run 'cbugs' with no argument for a summary of the open bugs.
EOF
}

usage_add() {
  cat >&2 <<'EOF'
Usage: cbugs add --kind code|spec|task --title <text> [--note <text>]
                  [--cite <path>[:<id>]]... [--commit <id>] [--json]

Creates one bug with the status "open" and prints its id.

--note is read from standard input when it is not given, unless standard
input is a terminal, in which case add stops with an error.

--kind task stops with an error when the environment holds CONVERGE_ROLE. A
task records what a human user asked for, and an agent must never log one
unless a human user directed it.
EOF
}

usage_note() {
  cat >&2 <<'EOF'
Usage: cbugs note <id> [<text>] [--note <text>] [--title <text>]
                   [--cite <path>[:<id>]]... [--commit <id>] [--json]

Writes a revision that keeps the status. Valid on a bug in any status.

The note comes from the argument after the id, from --note, or from standard
input, in that order. When none is given and standard input is a terminal,
note stops with an error.
EOF
}

usage_status_verb() {
  local verb=$1 status=$2
  cat >&2 <<EOF
Usage: cbugs $verb <id> [--note <text>] [--title <text>]
                    [--cite <path>[:<id>]]... [--commit <id>] [--json]

Writes a revision with the status "$status".

--note is read from standard input when it is not given. When standard input
is a terminal, $verb writes an empty note instead of waiting.
EOF
}

usage_list() {
  cat >&2 <<'EOF'
Usage: cbugs list [--kind code|spec|task]... [--status open|closed|wontfix]...
                  [--visibility visible|hidden|all] [--panel-run <id>] [--json]

Prints the bugs of the project, newest revision first. Repeat --kind or
--status to show more than one value; several values of one option mean
their union. With no option, list shows every visible bug, and each row
holds the bug's current state: the newest revision that the current
repository HEAD reaches.

--visibility hidden shows only the bugs that no visible revision supplies;
it shows each one's newest stored values with a hidden mark, and does not
read them as current. --visibility all shows both, each row ordered by the
revision that supplies it.

--panel-run <id> shows only the bugs that the named panel run created; it
returns every bug of that run and marks the hidden ones, so a run's own
finding selection cannot lose a bug at a later HEAD. The run id of a
review-panel agent is in the first revision of each bug it logged.
EOF
}

usage_show() {
  cat >&2 <<'EOF'
Usage: cbugs show <id> [--json]

Prints one bug in full: its id, kind, current status and title, and every
revision in order, with the citations that each revision wrote. The
current revision is the newest one that the current repository HEAD can
reach, and each revision names whether it is visible at that HEAD. A bug
whose revisions the HEAD cannot reach reads as hidden, and no revision of
it reads as current.
EOF
}

usage_search() {
  cat >&2 <<'EOF'
Usage: cbugs search <text> [--kind code|spec|task]... [--status open|closed|wontfix]...
                            [--panel-run <id>] [--json]

Prints the visible bugs whose title, notes, or citations, in a visible
revision, contain the text. The search ignores the difference between
capital and small letters. Accepts the kind and status options and the
same order and row form as list. It takes no --visibility option: the
audit interface is 'cbugs list --visibility hidden|all'.
EOF
}

usage_reviewed() {
  cat >&2 <<'EOF'
Usage: cbugs reviewed add|pending [args]

  reviewed add      Record the commits that one review pass covered.
  reviewed pending  Print the commits that no pass has recorded yet.

Run 'cbugs reviewed add --help' for the options of add, and
'cbugs reviewed pending --help' for the options of pending.
EOF
}

usage_reviewed_add() {
  cat >&2 <<'EOF'
Usage: cbugs reviewed add [--iteration <N>] [--profile <profile>]
                          [--completed-at <timestamp>] [<commit>]... [--json]

Records the commits that one review pass of converge covered. The commits
come as arguments, or on standard input, one commit per line. The record
of one call is one transaction: a call that fails records nothing.

The command writes the full hash of the commit that git resolves from
each value. A value that names no commit of the repository is an error.

Every distinct resolved commit gets one new, immutable record, even when
a row already names it.

Prints one line with the number of records added, the number of input
commits that a row already named before the call, the profile, and the
completion timestamp.

The call stops with an error when the environment holds CONVERGE_ROLE:
the loop records the commits of a pass, and no agent of the loop records
one. An operator who runs the command by hand may record commits.

--iteration <N>       The worker iteration that the pass followed. A call
                      that gives none records none.
--profile <profile>   The harness:model[:effort] of the pass. Omitted,
                      the record holds an unknown profile.
--completed-at <ts>   The completion time, as YYYY-MM-DDTHH:MM:SSZ.
                      Omitted, the call uses the current UTC time, once
                      for every record it writes.
EOF
}

usage_reviewed_pending() {
  cat >&2 <<'EOF'
Usage: cbugs reviewed pending [--json]

Prints the unreviewed commits, the newest first: one line for each commit,
with the full hash and the subject. A commit is relevant when it changes one
or more paths in the run directory; the command reads it as relevant when the
repository HEAD reaches it and no row of the reviewed table names it. A call
from the root of the repository makes every reachable commit relevant.

Prints nothing and exits with the status 0 when no commit is unreviewed, and
when the repository holds no relevant commit.
EOF
}

# ------------------------------------------------------------------ platform
#
# The command runs under the same platform conditions as converge: bash 4 or
# later, and the GNU/Homebrew discovery pattern for a tool that Homebrew keeps
# off the normal PATH on macOS. hash_path (below) and reviewed add's
# --completed-at both need the GNU versions of md5sum and date that coreutils
# supplies; without them on PATH, hash_path silently falls back to cksum and
# derives a state directory that disagrees with converge's (CB-DB-2), and
# date -u -d misparses under the BSD date that macOS supplies.

for brew_prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
  [[ -n $brew_prefix ]] || continue
  for bin_dir in "$brew_prefix/opt/coreutils/libexec/gnubin" \
                 "$brew_prefix/opt/util-linux/bin"; do
    [[ -d $bin_dir ]] && PATH="$bin_dir:$PATH"
  done
done
# Homebrew's SQLite formula supplies sqlite3, but its bin directory can also
# contain Homebrew's Bash 3.2 executable. Since the script's Bash 4 check has
# already run, putting that directory on PATH would make the later
# `converge --init-state` child re-exec cbugs with an unsupported Bash. Keep
# PATH-resolved tools on the supported GNU path and invoke the Homebrew SQLite
# binary by its discovered location instead.
SQLITE3_BIN="$(command -v sqlite3 2>/dev/null || true)"
for brew_prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
  [[ -n $brew_prefix ]] || continue
  candidate="$brew_prefix/opt/sqlite/bin/sqlite3"
  if [[ -x $candidate ]]; then
    SQLITE3_BIN=$candidate
    break
  fi
done

# Help is self-contained. Detect it before checking runtime tools so usage
# remains available even when the database and locking tools are absent.
EARLY_HELP=0
skip_next=0
for arg in "$@"; do
  if ((skip_next)); then skip_next=0; continue; fi
  case $arg in
    -h|--help) EARLY_HELP=1 ;;
    --title|--kind|--note|--cite|--commit|--status|--iteration|--profile|--completed-at|--panel-run) skip_next=1 ;;
  esac
done

need_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "cbugs: '$1' is not on PATH" >&2
    if [[ -n ${2:-} ]]; then
      echo "cbugs: on macOS, run 'brew install $2'" >&2
    fi
    exit 2
  fi
}
if ((! EARLY_HELP)); then
  if [[ -z $SQLITE3_BIN ]]; then
    echo "cbugs: 'sqlite3' is not on PATH" >&2
    echo "cbugs: on macOS, run 'brew install sqlite'" >&2
    exit 2
  fi
  need_tool jq jq
  need_tool date coreutils
  need_tool flock util-linux
fi

# The BSD date that macOS supplies shares the name "date" but rejects -d, the
# GNU option that reviewed add's --completed-at validation depends on
# (CV-PLAT-5's rule applies here too: a name on PATH is not enough).
if ((! EARLY_HELP)) && ! date --version >/dev/null 2>&1; then
  echo "cbugs: this 'date' is not GNU date" >&2
  echo "cbugs: on macOS, run 'brew install coreutils'" >&2
  exit 2
fi

# The same rule applies to flock: the GNU/util-linux flock that the
# migration lock (CB-DB-2's cross-process guarantee) depends on accepts
# --version; a shim of the same name on PATH may not.
if ((! EARLY_HELP)) && ! flock --version >/dev/null 2>&1; then
  echo "cbugs: this 'flock' is not GNU flock" >&2
  echo "cbugs: on macOS, run 'brew install util-linux'" >&2
  exit 2
fi

# ------------------------------------------------------------------ appearance

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'
  YELLOW=$'\033[33m'; GREEN=$'\033[32m'; CYAN=$'\033[36m'; MAGENTA=$'\033[35m'
else
  BOLD=""; DIM=""; OFF=""; YELLOW=""; GREEN=""; CYAN=""; MAGENTA=""
fi

# is_number <text>   True when the text is a whole number.
is_number() {
  [[ $1 =~ ^[0-9]+$ ]]
}

# plural <count> <word>   Adds an "s" to the word when the count is not one.
plural() {
  if (($1 == 1)); then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi
}

# need_value <flag> <remaining-args-count>
need_value() {
  if (($2 < 2)); then
    echo "cbugs: $1 needs a value" >&2
    exit 2
  fi
}

# ------------------------------------------------------------- state and db
#
# cbugs derives the state directory from the absolute path of the run
# directory of the call -- CONVERGE_RUN_DIR when the environment holds it,
# else the current directory -- by the same rule that converge uses, so that
# a directory converge has run in gives the same state directory to both
# commands (CB-DB-2). When no run directory of the walk holds one, cbugs
# creates one, as CB-DB-7 gives. converge exports CONVERGE_RUN_DIR for
# every agent it starts, so an agent that changes its own working directory
# still reads and writes the bugs of its own run, and never the bugs of
# another run directory that it moved into.

hash_path() {
  if command -v md5sum >/dev/null 2>&1; then
    printf '%s' "$1" | md5sum | cut -c1-12
  else
    printf '%s' "$1" | cksum | tr -d ' ' | cut -c1-12
  fi
}

# state_for <dir>   Prints the state directory that converge would use for a
# run from <dir>, at the path of <dir>, by the rule of CB-DB-2: the name of
# the repository that contains <dir>, the path of <dir> within it, and a
# hash of the absolute path of <dir>. Every ancestor of the walk gets its
# own derivation, so the state directory of another repository never takes
# the bugs of this one (CB-DB-8.2).
state_for() {
  local dir=$1 repo sub=""
  if ! repo=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
    repo=$dir
  fi
  [[ $dir == "$repo" ]] || sub="${dir#"$repo"/}"
  printf '%s/%s' "${XDG_STATE_HOME:-${HOME:-}/.local/state}/converge" \
    "${repo##*/}${sub:+-${sub//\//-}}-$(hash_path "$dir")"
}

# create_state_dir   Creates the state directory of the run directory of the
# call. The command makes no directory of its own: it runs 'converge
# --init-state' as PATH names it, with the working directory of the child
# set to the run directory of the call (CB-DB-7.1). It discards the output
# of a creation that succeeds; when the creation fails, it stops with an
# error that names the cause, and prints no bug, whatever the verb asked
# for (CB-DB-7.2, CB-ERR-3).
create_state_dir() {
  local errfile status
  if ! command -v converge >/dev/null 2>&1; then
    echo "cbugs: cannot create the state directory: 'converge' is not on PATH" >&2
    exit 2
  fi
  if ! errfile=$(mktemp "${TMPDIR:-/tmp}/cbugs.XXXXXX"); then
    echo "cbugs: cannot make a temporary file; check TMPDIR" >&2
    exit 2
  fi
  (cd "$RUN_DIR" && converge --init-state) >/dev/null 2>"$errfile"
  status=$?
  if ((status != 0)); then
    echo "cbugs: cannot create the state directory: 'converge --init-state' failed" >&2
    while IFS= read -r line; do
      [[ -n $line ]] && echo "cbugs: $line" >&2
    done <"$errfile"
    rm -f "$errfile"
    exit 2
  fi
  rm -f "$errfile"
}

# --help needs no project state: it only prints usage. Detect it ahead of the
# state directory check, so 'cbugs --help' and 'cbugs <verb> --help' work in
# any directory, including one that is not a converge project.
#
# Skip the token after a value-taking option, so a literal '-h' or '--help'
# given as a --title, --note, --cite, --commit, --status, or --panel-run
# value is not mistaken for the flag.
HELP_REQUESTED=0
skip_next=0
for arg in "$@"; do
  if ((skip_next)); then
    skip_next=0
    continue
  fi
  case $arg in
    -h|--help) HELP_REQUESTED=1 ;;
    --title|--kind|--note|--cite|--commit|--status|--iteration|--profile|--completed-at|--panel-run) skip_next=1 ;;
  esac
done

if [[ ${CONVERGE_RUN_DIR+x} ]]; then
  if ((! HELP_REQUESTED)) && [[ ! -d $CONVERGE_RUN_DIR ]]; then
    echo "cbugs: CONVERGE_RUN_DIR '$CONVERGE_RUN_DIR' names no directory" >&2
    exit 2
  fi
  RUN_DIR=$CONVERGE_RUN_DIR
else
  RUN_DIR="$(pwd -P)"
fi
# Name the run directory by absolute path that pwd -P gives, as converge
# names it, so that one directory derives one state directory, however the
# caller spells its path (CB-DB-2). The walk below starts from the parent
# of it, by string, so the path must be in that form already.
if ((! HELP_REQUESTED)) && ! RUN_DIR=$(cd "$RUN_DIR" && pwd -P); then
  echo "cbugs: cannot reach the run directory '$RUN_DIR'" >&2
  exit 2
fi
if ((! HELP_REQUESTED)) && [[ -z ${XDG_STATE_HOME:-} && -z ${HOME:-} ]]; then
  echo "cbugs: set HOME or XDG_STATE_HOME; cbugs keeps its state there" >&2
  exit 2
fi

# State resolution. A call for help resolves no state directory and creates
# none (CB-DB-8.4); every other call resolves one, and a read resolves it
# exactly as a write does.
STATE_DIR=""
DB=""
if ((! HELP_REQUESTED)); then
  # Every call that answers reads the repository: the derivation of CB-DB-2
  # names the repository of the run directory, the walk of CB-DB-8 ends at
  # its root, and the write verbs read its HEAD. Without git the command
  # cannot tell a repository from a plain directory. It would then derive a
  # state directory whose name converge does not derive (CB-DB-2), or test
  # ancestors above the root of the repository (CB-DB-8.2), or record a
  # revision with no commit where the repository holds one (CB-PROV-4).
  # A necessary tool must name its absence, as CB-PLAT-2 gives: stop here,
  # before any answer, with the named-tool error.
  need_tool git git
  # The walk of CB-DB-8 ends with the root of the repository when the run
  # directory sits in one, and with the root of the file system when it
  # does not (CB-DB-8.2). When the run directory is itself the root of its
  # repository, no ancestor of the walk lies within it, and the walk tests
  # nothing: the state directory of another repository must never take the
  # bugs of this one (CB-DB-8.2).
  if REPO=$(git -C "$RUN_DIR" rev-parse --show-toplevel 2>/dev/null); then
    if [[ $REPO == "$RUN_DIR" ]]; then
      walk=0
    else
      walk=1
      limit=$REPO
    fi
  else
    REPO=$RUN_DIR
    walk=1
    limit=/
  fi
  own=$(state_for "$RUN_DIR")
  if [[ -d $own ]]; then
    # CB-DB-8: the state directory of the run directory, when it exists.
    STATE_DIR=$own
  else
    dir=${RUN_DIR%/*}; [[ -z $dir ]] && dir=/
    while ((walk)); do
      cand=$(state_for "$dir")
      if [[ -d $cand ]]; then
        # The one case of CB-DB-8.3: the call writes its bugs into the
        # database of the nearest ancestor that holds a state directory.
        STATE_DIR=$cand
        break
      fi
      [[ $dir == "$limit" ]] && break
      parent=${dir%/*}
      [[ -z $parent ]] && parent=/
      [[ $parent == "$dir" ]] && break
      dir=$parent
    done
    if [[ -z $STATE_DIR ]]; then
      # No run directory of the walk holds one: create the state directory
      # of the run directory of the call (CB-DB-7), for every verb.
      create_state_dir
      STATE_DIR=$own
    fi
  fi
  DB="$STATE_DIR/cbugs.db"
fi

# The temporary file takes the stderr of every sqlite call. A creation that
# fails names its cause in the same way (CB-ERR-2): fail here, before any
# answer, when no temporary file can be made.
ERRFILE=""
if ((! HELP_REQUESTED)); then
  if ! ERRFILE=$(mktemp "${TMPDIR:-/tmp}/cbugs.XXXXXX"); then
    echo "cbugs: cannot make a temporary file; check TMPDIR" >&2
    exit 2
  fi
  trap 'rm -f "$ERRFILE"' EXIT
fi

# sqlite3_run <raw|json> <sql>
# Runs one script against the database, with a bounded wait when the database
# is busy. Prints what the script writes to stdout. Stops with an error, on
# stderr, when the script fails. A caller that reads the answer in a command
# substitution must propagate the failure with '|| exit 1': the exit status of
# the substitution is otherwise lost, and the verb would continue on empty
# data as if the call had answered (CB-ERR-2, CB-CONC-5).
sqlite3_run() {
  local mode=$1 sql=$2 out status
  local -a flags=(-bail -cmd ".timeout 10000")
  [[ $mode == json ]] && flags+=(-json)
  # The script rides standard input, not an argument: a query that carries
  # the visible commits of a long history in a temporary table would outgrow
  # the single-argument size that the kernel accepts.
  out=$("$SQLITE3_BIN" "${flags[@]}" "$DB" 2>"$ERRFILE" <<<"$sql")
  status=$?
  if ((status != 0)); then
    echo "cbugs: database error" >&2
    while IFS= read -r line; do
      [[ -n $line ]] && echo "cbugs: $line" >&2
    done <"$ERRFILE"
    exit 1
  fi
  printf '%s' "$out"
}

# sql_quote <text>   Escapes text for embedding inside a single-quoted
# SQL string literal.
sql_quote() {
  printf '%s' "${1//\'/\'\'}"
}

# like_escape <text>   Escapes text for embedding inside a LIKE pattern that
# uses backslash as its escape character.
like_escape() {
  local out=$1
  out=${out//\\/\\\\}
  out=${out//%/\\%}
  out=${out//_/\\_}
  sql_quote "$out"
}

# The data model. This mirrors docs/cbugs-schema.sql. Nothing here is ever
# changed or removed: current state comes from the revisions through the
# visibility rules at the repository HEAD of the call (CB-PRIN-6, CB-VIS-1
# through CB-VIS-8), and a row of reviewed commits never changes.
DB_VERSION=8

SCHEMA_SQL=$(cat <<SQL
BEGIN IMMEDIATE;

CREATE TABLE IF NOT EXISTS bug (
  id   INTEGER PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('code', 'spec', 'task'))
);

CREATE TABLE IF NOT EXISTS revision (
  id            INTEGER PRIMARY KEY,
  bug_id        INTEGER NOT NULL REFERENCES bug (id),
  status        TEXT NOT NULL CHECK (status IN ('open', 'closed', 'wontfix')),
  title         TEXT NOT NULL CHECK (title <> ''),
  note          TEXT NOT NULL,
  role          TEXT,
  iteration     INTEGER,
  commit_id     TEXT,
  created_at    TEXT NOT NULL,
  panel_run     TEXT CHECK (panel_run <> ''),
  panel_profile TEXT CHECK (panel_profile <> ''),
  panel_invocation TEXT CHECK (panel_invocation <> '')
);

CREATE INDEX IF NOT EXISTS revision_bug ON revision (bug_id, id);

CREATE TABLE IF NOT EXISTS citation (
  id          INTEGER PRIMARY KEY,
  revision_id INTEGER NOT NULL REFERENCES revision (id),
  path        TEXT NOT NULL CHECK (path <> ''),
  req         TEXT CHECK (req <> '')
);

CREATE INDEX IF NOT EXISTS citation_revision ON citation (revision_id, id);

CREATE TABLE IF NOT EXISTS reviewed (
  id         INTEGER PRIMARY KEY,
  commit_id  TEXT NOT NULL,
  iteration  INTEGER,
  created_at TEXT NOT NULL,
  profile    TEXT CHECK (profile <> '')
);

CREATE INDEX IF NOT EXISTS reviewed_commit ON reviewed (commit_id);

PRAGMA user_version = $DB_VERSION;
COMMIT;
SQL
)

# The migration from version 2 to version 3. It renames the kind 'user' to
# 'task', and nothing else. The CHECK of the bug table must accept the new
# value, so the table is rebuilt around the copied rows; the copy carries
# every id across, and the revisions and the citations are untouched. One
# transaction: a failure leaves the database as it was, and the next call
# tries again. BEGIN IMMEDIATE makes two callers that find the same old
# database serialize: the second waits on the lock, then proceeds against
# the database that the first one migrated.
MIGRATE_V2_3_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
DROP VIEW IF EXISTS bug_current;
CREATE TABLE bug_migrate (
  id   INTEGER PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('code', 'spec', 'task'))
);
INSERT INTO bug_migrate (id, kind)
  SELECT id, CASE kind WHEN 'user' THEN 'task' ELSE kind END FROM bug;
DROP TABLE bug;
ALTER TABLE bug_migrate RENAME TO bug;
PRAGMA user_version = 3;
COMMIT;
SQL
)

# The migration from version 3 to version 4. It creates the table of
# reviewed commits, and nothing else: every bug, every revision, and every
# citation is the same after it as before it (CB-MIG-8). One transaction,
# like the previous step.
MIGRATE_V3_4_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
CREATE TABLE IF NOT EXISTS reviewed (
  id         INTEGER PRIMARY KEY,
  commit_id  TEXT NOT NULL UNIQUE,
  iteration  INTEGER,
  created_at TEXT NOT NULL
);
PRAGMA user_version = 4;
COMMIT;
SQL
)

# The migration from version 4 to version 5. It drops the uniqueness of
# commit_id, so more than one review record can name the same commit, and
# adds the optional profile column. Every existing review id, full commit
# hash, iteration, and created_at value is preserved unchanged; each old
# record gets a NULL profile, which means unknown. It touches no bug,
# revision, or citation. One transaction, like the previous steps. Each
# step records only the version that the step itself reaches, and not the
# whole DB_VERSION: init_db migrates one step at a time, and a step that
# claimed the last version would end the loop while later steps are still
# missing.
MIGRATE_V4_5_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
CREATE TABLE reviewed_migrate (
  id         INTEGER PRIMARY KEY,
  commit_id  TEXT NOT NULL,
  iteration  INTEGER,
  created_at TEXT NOT NULL,
  profile    TEXT CHECK (profile <> '')
);
INSERT INTO reviewed_migrate (id, commit_id, iteration, created_at, profile)
  SELECT id, commit_id, iteration, created_at, NULL FROM reviewed;
DROP TABLE reviewed;
ALTER TABLE reviewed_migrate RENAME TO reviewed;
CREATE INDEX IF NOT EXISTS reviewed_commit ON reviewed (commit_id);
PRAGMA user_version = 5;
COMMIT;
SQL
)

# The migration from version 5 to version 6. It adds the two panel columns to
# the revision table, and nothing else. The values describe the panel run and
# the canonical agent profile that the caller brought, which the environment
# already carries; every existing revision keeps NULL, which means the
# revision names no panel run (RP-RUN-5's shared contract gained its storage
# here). Every bug, citation, and review record is preserved unchanged. One
# transaction, like the previous steps.
MIGRATE_V5_6_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
ALTER TABLE revision ADD COLUMN panel_run TEXT CHECK (panel_run <> '');
ALTER TABLE revision ADD COLUMN panel_profile TEXT CHECK (panel_profile <> '');
PRAGMA user_version = 6;
COMMIT;
SQL
)

# The migration from version 6 to version 7. It adds one panel column to the
# revision table, and nothing else. The value names the invocation of a panel
# run that wrote the revision, which the environment carries next to the panel
# run and the profile (RP-RUN-2); every existing revision keeps NULL, and
# every bug, citation, and review record is preserved unchanged. One
# transaction, like the previous steps.
MIGRATE_V6_7_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
ALTER TABLE revision ADD COLUMN panel_invocation TEXT CHECK (panel_invocation <> '');
PRAGMA user_version = 7;
COMMIT;
SQL
)

# The migration from version 7 to version 8. It removes the global
# bug_current view, and nothing else (CB-MIG-16): current state becomes the
# read-time relation of CB-VIS-1 through CB-VIS-8, which the queries of the
# command compute per call from the repository HEAD. The view is a
# definition, and no bug, revision, citation, reviewed record, panel value,
# id, commit, or time lives in it, so every stored row survives unchanged.
# One transaction, like the previous steps.
MIGRATE_V7_8_SQL=$(cat <<SQL
BEGIN IMMEDIATE;
DROP VIEW IF EXISTS bug_current;
PRAGMA user_version = 8;
COMMIT;
SQL
)

# init_db   Prepares the database before the command answers the call. It
# creates the database on first use, migrates a version 2, 3, 4, 5, 6, or 7
# database in one transaction -- one transaction for the complete path -- and stops
# with an error when the version is one that this command does not know.
#
# The migration steps run under a lock of their own (CB-MIG-5), not only
# under the BEGIN IMMEDIATE of each step's own transaction. The version 4
# to 5 step rebuilds the reviewed table from whatever shape it finds; that
# is safe to run once, but not safe to replay against a database that a
# second caller already carried to version 5 in the meantime, because it
# would overwrite a profile that a third caller wrote after the first
# migration committed. Serializing the whole migration means a caller that
# waited on the lock re-reads the version once it has the lock and, when
# another caller already finished, finds nothing left to do.
init_db() {
  local ver
  if [[ ! -e $DB ]]; then
    sqlite3_run raw "$SCHEMA_SQL" >/dev/null
    return
  fi
  ver=$(sqlite3_run raw "PRAGMA user_version;") || exit 1
  [[ $ver == "$DB_VERSION" ]] && return
  case $ver in
    2|3|4|5|6|7) ;;
    *)
      echo "cbugs: $DB is database version $ver, but this command knows version $DB_VERSION and migrates only versions 2, 3, 4, 5, 6, and 7" >&2
      exit 1
      ;;
  esac
  exec 9>"$STATE_DIR/cbugs.db.migrate.lock" || exit 1
  # CB-CONC-5: wait for the lock only up to a bounded time, the same bound
  # as the sqlite busy timeout below, and then fail instead of blocking
  # forever behind a caller that died holding it.
  if ! flock -w 10 9; then
    echo "cbugs: timed out waiting for the migration lock on $DB" >&2
    exit 1
  fi
  ver=$(sqlite3_run raw "PRAGMA user_version;") || exit 1
  local migration_sql='BEGIN IMMEDIATE;' step
  while ((ver < DB_VERSION)); do
    case $ver in
      2) step=$MIGRATE_V2_3_SQL ;;
      3) step=$MIGRATE_V3_4_SQL ;;
      4) step=$MIGRATE_V4_5_SQL ;;
      5) step=$MIGRATE_V5_6_SQL ;;
      6) step=$MIGRATE_V6_7_SQL ;;
      7) step=$MIGRATE_V7_8_SQL ;;
      *)
        echo "cbugs: $DB is database version $ver, but this command knows version $DB_VERSION and migrates only versions 2, 3, 4, 5, 6, and 7" >&2
        exit 1
        ;;
    esac
    step=${step#*$'\n'}
    step=${step%$'\nCOMMIT;'*}
    migration_sql+=$'\n'"$step"
    ((ver += 1))
  done
  migration_sql+=$'\nCOMMIT;'
  sqlite3_run raw "$migration_sql" >/dev/null || exit 1
  flock -u 9
  exec 9>&-
}
((HELP_REQUESTED)) || init_db

# ------------------------------------------------------------------ provenance
#
# The bug tracker reads the role and the iteration from the environment that
# converge exports, and the commit from the repository, so that a caller
# cannot get them wrong and a prompt does not have to carry them.

ROLE_SQL="NULL"
ITERATION_SQL="NULL"
COMMIT_SQL="NULL"
PANEL_RUN_SQL="NULL"
PANEL_PROFILE_SQL="NULL"
PANEL_INVOCATION_SQL="NULL"
CREATED_AT=""

# ------------------------------------------------------- visibility at a commit
#
# Current state is a read-time relation (CB-PRIN-6, CB-VIS-1 through
# CB-VIS-8). A revision is visible when it has no commit, or when the
# commit that the call resolves reaches its stored commit. Each call
# resolves the repository HEAD once and the write commit once, and every
# visibility query of the call derives its answer from those two sets.
#
# CB-VIS-4 holds the resolution to one per call: git rev-list walks the
# history once for the HEAD set, at the start of the call, and not again.
# The write verbs resolve --commit once in provenance, and the version 4
# to 5 rule of CB-PROV-7 gives the source: that resolution replaces HEAD
# for both the stored provenance and the visible source revision.
#
# A failed read, an empty history, and a repository with no commit cannot
# decide reachability, so every revision stays visible (CB-VIS-1,
# CB-VIS-6, CB-VIS-8). The command hides a revision only when the
# available history that walks cleanly proves that the resolved commit
# does not reach it.

HEAD_ID=""
declare -a HEAD_VIS=()
VIS_HEAD=all
declare -a WRITE_VIS=()
VIS_WRITE=all
WRITE_ID=""

# fill_vis <set array name> <flag variable name> <commit>
#   One rev-list walk. Fills the array with the full hashes that the commit
#   reaches, and the flag with 'set'; a commit with no history, a failed
#   walk, and a commit with no history to walk leave the flag at 'all'.
#   The sets are module arrays, so the name arguments pass through eval --
#   bash 4 parsers must take this file, and namerefs are a bash 4.3 syntax.
fill_vis() {
  local setname=$1 flagname=$2 commit=$3 reachable status h shallow_file
  [[ -n $commit ]] || { eval "$setname=(); $flagname=all"; return 0; }
  # A shallow repository can still contain complete history for the commit
  # being examined, even when another branch has a shallow boundary. Only a
  # boundary encountered by this walk makes non-reachability undecidable.
  reachable=$(git -C "$REPO" rev-list "$commit" 2>/dev/null)
  status=$?
  if ((status != 0)) || [[ -z $reachable ]]; then
    eval "$setname=(); $flagname=all"
    return 0
  fi
  if [[ $(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null || echo false) == true ]]; then
    shallow_file=$(git -C "$REPO" rev-parse --git-path shallow 2>/dev/null || true)
    [[ $shallow_file == /* ]] || shallow_file="$REPO/$shallow_file"
    if [[ -r $shallow_file ]]; then
      while IFS= read -r h; do
        if [[ -n $h && $'\n'$reachable$'\n' == *$'\n'"$h"$'\n'* ]]; then
          eval "$setname=(); $flagname=all"
          return 0
        fi
      done < "$shallow_file"
    fi
  fi
  local -a hashes=()
  while IFS= read -r h; do
    [[ -n $h ]] && hashes+=("$h")
  done <<<"$reachable"
  eval "$setname=(\"\${hashes[@]}\"); $flagname=set"
}

# vis_capture_head   Resolves the repository HEAD once for the call and
# captures the commits that it reaches. A call that reads visibility uses
# this set for every read (CB-VIS-4). Called once, at load, for every call
# that answers.
vis_capture_head() {
  HEAD_ID=$(git -C "$REPO" rev-parse --verify -q HEAD 2>/dev/null) || HEAD_ID=""
  fill_vis HEAD_VIS VIS_HEAD "$HEAD_ID"
}

# vis_capture_write <resolved write commit>   Captures the commits that the
# write commit reaches (CB-PROV-7). Called once per call, from provenance.
vis_capture_write() {
  WRITE_ID=$1
  fill_vis WRITE_VIS VIS_WRITE "$WRITE_ID"
}

# vis_prelude <head|write>   SQL that fills a temporary table with the
# resolved hashes of one set. The caller prefixes one query with this
# prelude; the table then lives for that one query in its own connection.
vis_prelude() {
  local which=$1 h chunk="" out count=0 table
  case $which in
    head) table=temp.visible_head ;;
    write) table=temp.visible_write ;;
    *) return 0 ;;
  esac
  out="CREATE TEMP TABLE $table (c TEXT PRIMARY KEY);"
  local -a ids=()
  [[ $which == head ]] && ids=(${HEAD_VIS[@]+"${HEAD_VIS[@]}"})
  [[ $which == write ]] && ids=(${WRITE_VIS[@]+"${WRITE_VIS[@]}"})
  if ((${#ids[@]} > 0)); then
    for h in "${ids[@]}"; do
      chunk+="${chunk:+,}('$h')"
      if ((++count == 500)); then
        out+="
INSERT OR IGNORE INTO $table VALUES $chunk;"
        chunk=""
        count=0
      fi
    done
    if [[ -n $chunk ]]; then
      out+="
INSERT OR IGNORE INTO $table VALUES $chunk;"
    fi
  fi
  printf '%s' "$out"
}

# vis_pred <head|write> <column reference>   The SQL predicate that matches
# the visible revisions of one set: a revision with no commit is visible
# everywhere (CB-VIS-1), and a revision with a commit is visible when the
# set names it (CB-VIS-2). When the set could not decide reachability, the
# predicate accepts every revision (CB-VIS-6, CB-VIS-8).
vis_pred() {
  local which=$1 colref=$2 table
  case $which in
    head)
      [[ $VIS_HEAD == all ]] && { printf '1'; return; }
      table=temp.visible_head ;;
    write)
      [[ $VIS_WRITE == all ]] && { printf '1'; return; }
      table=temp.visible_write ;;
    *) printf '1'; return ;;
  esac
  printf '(%s.commit_id IS NULL OR %s.commit_id IN (SELECT c FROM %s))' "$colref" "$colref" "$table"
}

# One resolution of the repository HEAD per call (CB-VIS-4): every
# visibility-aware read of this call runs against the same set, captured
# once, here, for every call that answers.
(( HELP_REQUESTED )) || vis_capture_head

# provenance <commit override, or "">
#
# The panel fields supplement the role and the iteration that the loop
# exports. A command that runs one panel run exports REVIEW_PANEL_RUN and
# REVIEW_PANEL_PROFILE into every agent that it starts (a reviewer, and the
# merge agent); each revision therefore names the panel run it belongs to
# and the canonical profile that wrote it (RP-RUN-2, RP-RUN-5). The same
# command exports REVIEW_PANEL_INVOCATION, which names the one invocation
# the agent belongs to inside the panel run, so two invocations of one run
# stay distinguishable however they write (RP-RUN-2). A caller
# that sets none of them keeps the plain authorship rules: both fields stay
# NULL, and the command refuses nothing (CB-PROV-1 through CB-PROV-5 hold
# as before). An empty value counts as an absent one.
provenance() {
  local override=$1 explicit=${2:-0} commit=""
  if [[ -n ${CONVERGE_ROLE:-} ]]; then
    ROLE_SQL="'$(sql_quote "$CONVERGE_ROLE")'"
  else
    ROLE_SQL="NULL"
  fi
  if [[ -n ${CONVERGE_ITERATION:-} ]] && is_number "$CONVERGE_ITERATION"; then
    ITERATION_SQL="$CONVERGE_ITERATION"
  else
    ITERATION_SQL="NULL"
  fi
  if [[ -n ${REVIEW_PANEL_RUN:-} ]]; then
    PANEL_RUN_SQL="'$(sql_quote "$REVIEW_PANEL_RUN")'"
  else
    PANEL_RUN_SQL="NULL"
  fi
  if [[ -n ${REVIEW_PANEL_PROFILE:-} ]]; then
    PANEL_PROFILE_SQL="'$(sql_quote "$REVIEW_PANEL_PROFILE")'"
  else
    PANEL_PROFILE_SQL="NULL"
  fi
  if [[ -n ${REVIEW_PANEL_INVOCATION:-} ]]; then
    PANEL_INVOCATION_SQL="'$(sql_quote "$REVIEW_PANEL_INVOCATION")'"
  else
    PANEL_INVOCATION_SQL="NULL"
  fi
  # The write commit (CB-PROV-4 through CB-PROV-7). An explicit --commit
  # value must resolve to exactly one commit of the repository before the
  # verb writes anything (CB-PROV-6, CB-ERR-3), and the command stores its
  # full object id. A call whose write commit resolves elsewhere than HEAD
  # carries its own visibility set for the source revision (CB-PROV-7,
  # CB-REV-10); a call with no HEAD records none and cannot decide
  # reachability (CB-PROV-5, CB-VIS-8).
  if ((explicit)); then
    if [[ -z $override ]] || ! commit=$(git -C "$REPO" rev-parse --verify -q "$override^{commit}" 2>/dev/null); then
      echo "cbugs: --commit '${override}' does not name exactly one commit of the repository" >&2
      exit 1
    fi
    WRITE_ID=$commit
    COMMIT_SQL="'$(sql_quote "$commit")'"
  else
    # Use the HEAD already resolved for this call. In particular, do not
    # resolve it again after a verb has read a note from standard input:
    # visibility reads and default write provenance must share one snapshot.
    commit=$HEAD_ID
    WRITE_ID=$commit
    if [[ -n $commit ]]; then
      COMMIT_SQL="'$(sql_quote "$commit")'"
    else
      COMMIT_SQL="NULL"
    fi
  fi
  vis_capture_write "$WRITE_ID"
  CREATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
}

# require_bug <id>   Stops with an error when no bug has this id.
require_bug() {
  local found
  # A database error must not name itself "no bug with id": the failure of
  # the query is a failure, and the empty answer of a success is the miss.
  found=$(sqlite3_run raw "SELECT 1 FROM bug WHERE id = $1;") || exit 1
  [[ -n $found ]] || { echo "cbugs: no bug with id $1" >&2; exit 1; }
}

# parse_id <text>   Prints the text back when it is a bug id. Stops otherwise.
parse_id() {
  is_number "${1:-}" || { echo "cbugs: '${1:-}' is not a bug id" >&2; exit 2; }
  printf '%s' "$1"
}

# resolve_note <verb> <note given?> <note value>
# Prints the final note text. Reads standard input when no note was given.
# add and note stop with an error when standard input is a terminal; the
# status verbs write an empty note instead, because the status change is
# already the record.
resolve_note() {
  local verb=$1 given=$2 value=$3
  if ((given)); then
    printf '%s' "$value"
    return
  fi
  if [[ -t 0 ]]; then
    case $verb in
      add|note)
        echo "cbugs: $verb needs --note, or a note on standard input" >&2
        exit 2
        ;;
      *)
        printf ''
        return
        ;;
    esac
  fi
  cat
}

# ------------------------------------------------------------------- output

# row_line <id> <kind> <status> <title> [hidden]   One aligned, colored
# listing line. A fifth argument marks the row with 'hidden': an audit row
# whose stored values must not read as current at repository HEAD
# (CB-LIST-9, CB-SHOW-5).
row_line() {
  local id=$1 kind=$2 status=$3 title=$4 hidden=${5:-} color=$DIM kind_color=$DIM mark=""
  case $status in
    open) color=$YELLOW ;;
    closed) color=$GREEN ;;
    wontfix) color=$DIM ;;
  esac
  # A spec bug waits for the human user, and no agent will act on it, so it
  # earns a touch of color that a reader notices without it competing with
  # the status column. A code bug and a task stay subdued, and different
  # from each other, so a reader sees which rows are punchlist items.
  case $kind in
    spec) kind_color=$MAGENTA ;;
    task) kind_color=$CYAN ;;
    code) kind_color=$DIM ;;
  esac
  # A hidden row shows stored values that may not read as current (CB-LIST-9):
  # the trailing mark says that the row is an audit row.
  case $hidden in
    1|true) mark="  ${DIM}hidden${OFF}" ;;
  esac
  printf '%4s  %s%-4s%s  %s%-7s%s  %s%s\n' \
    "$id" "$kind_color" "$kind" "$OFF" "$color" "$status" "$OFF" "$title" "$mark"
}

# print_listing <rows json array> <json flag>
# Prints a listing of bugs. Prints nothing, and exits 0, when there is no row.
print_listing() {
  local rows=$1 json=$2 n
  n=$(jq 'length' <<<"$rows")
  ((n > 0)) || exit 0
  if ((json)); then
    printf '%s\n' "$rows"
    return
  fi
  local id kind status title hidden
  while IFS=$'\t' read -r id kind status title hidden; do
    row_line "$id" "$kind" "$status" "$title" "$hidden"
  done < <(jq -r '.[] | [.id, .kind, .status, .title, (.hidden // false)] | @tsv' <<<"$rows")
}

# current_rows_sql <visible|hidden|all> <extra where> [limit]   The shared
# current-state query. Current state is a read-time relation (CB-PRIN-6):
# for each bug, the newest revision visible at the captured HEAD supplies
# status and title (CB-VIS-1 through CB-VIS-4); a bug with no visible
# revision is hidden, and its newest stored revision supplies the audit
# values with the hidden mark (CB-LIST-7 through CB-LIST-9). Rows are
# ordered by the revision that supplies each row, newest first (CB-LIST-8).
# <extra> filters the wrapped row columns: id, kind, status, title, hidden.
# <limit> caps the result after the order. The caller prefixes the query
# with the captured-head prelude that this function writes first.
current_rows_sql() {
  local vis=$1 extra=$2 limit=${3:-}
  [[ $VIS_HEAD == all ]] || printf '%s\n' "$(vis_prelude head)"
  printf '%s;' "$(current_inner_sql "$vis" "$extra" "$limit")"
}

# current_inner_sql <visible|hidden|all> <extra where> [limit]   The
# current-state query without the prelude. A caller that wraps the query in
# another one, such as a COUNT, embeds the prelude first, outside the wrap.
current_inner_sql() {
  local vis=$1 extra=$2 limit=${3:-} headpred
  headpred=$(vis_pred head r2)
  local inner="FROM bug b
LEFT JOIN revision c ON c.id = (SELECT MAX(r2.id) FROM revision r2 WHERE r2.bug_id = b.id AND ($headpred))
LEFT JOIN revision s ON s.id = (SELECT MAX(r3.id) FROM revision r3 WHERE r3.bug_id = b.id)"
  case $vis in
    visible) inner+="
WHERE c.id IS NOT NULL" ;;
    hidden) inner+="
WHERE c.id IS NULL" ;;
  esac
  local wrapped="SELECT id, kind, status, title, hidden, revision_key
FROM (
  SELECT b.id AS id, b.kind AS kind,
       CASE WHEN c.id IS NOT NULL THEN c.status ELSE s.status END AS status,
       CASE WHEN c.id IS NOT NULL THEN c.title ELSE s.title END AS title,
       (c.id IS NULL) AS hidden,
       COALESCE(c.id, s.id) AS revision_key
  $inner
) AS t
${extra:+WHERE $extra
}ORDER BY revision_key DESC${limit:+ LIMIT $limit}"
  printf '%s' "$wrapped"
}

# print_bug <id> <json flag>   Prints one bug's current state after a write.
print_bug() {
  local id=$1 json=$2 rows row
  rows=$(sqlite3_run json "$(vis_prelude head)
SELECT b.id, b.kind,
       CASE WHEN c.id IS NOT NULL THEN c.status ELSE s.status END AS status,
       CASE WHEN c.id IS NOT NULL THEN c.title ELSE s.title END AS title,
       (c.id IS NULL) AS hidden
FROM bug b
LEFT JOIN revision c ON c.id = (SELECT MAX(r2.id) FROM revision r2 WHERE r2.bug_id = b.id AND ($(vis_pred head r2)))
LEFT JOIN revision s ON s.id = (SELECT MAX(r3.id) FROM revision r3 WHERE r3.bug_id = b.id)
WHERE b.id = $id;") || exit 1
  case $json in
    0) ;;
    *) jq -M '.[0]' <<<"$rows"; return ;;
  esac
  # A numeric 0 is truthy to jq, so the comparison must name the value,
  # and not lean on jq's exit status of a bare read.
  if (( $(jq -r '.[0].hidden' <<<"$rows") )); then
    local kind stored_status stored_title
    id=$(jq -r '.[0].id' <<<"$rows")
    kind=$(jq -r '.[0].kind' <<<"$rows")
    # A hidden bug earns no current status or title: print the mark alone,
    # so no stored value reads as current (CB-SHOW-5).
    printf '%4s  %s%-4s%s  %s%-7s%s  %s%s\n' "$id" "$DIM" "$kind" "$OFF" "$DIM" "hidden" "$OFF" "" ""
    return
  fi
  local id kind status title
  IFS=$'\t' read -r id kind status title < <(jq -r '.[0] | [.id, .kind, .status, .title] | @tsv' <<<"$rows")
  row_line "$id" "$kind" "$status" "$title"
}

# where_clause <kinds[]> -- <statuses[]>   Builds the shared filter of
# list/search. Several values of one option mean their union, so a caller can
# ask for the open code bugs and the open tasks in one call.
where_clause() {
  local -a kinds=()
  local -a statuses=()
  local target=kinds
  while (($#)); do
    if [[ $1 == -- ]]; then
      target=statuses
    elif [[ $target == kinds ]]; then
      kinds+=("$1")
    else
      statuses+=("$1")
    fi
    shift
  done
  local -a clauses=()
  if ((${#kinds[@]})); then
    local list="" k
    for k in "${kinds[@]}"; do
      list+="${list:+,}'$(sql_quote "$k")'"
    done
    clauses+=("kind IN ($list)")
  fi
  if ((${#statuses[@]})); then
    local list="" s
    for s in "${statuses[@]}"; do
      list+="${list:+,}'$(sql_quote "$s")'"
    done
    clauses+=("status IN ($list)")
  fi
  local out="" c
  for c in ${clauses[@]+"${clauses[@]}"}; do
    out+="${out:+ AND }$c"
  done
  printf '%s' "$out"
}

# panel_clause <bug id expression> <panel run id>   SQL that selects the bugs
# whose first revision the given panel run wrote: the first revision of a
# bug is its report, so its panel fields name the panel run that created
# the bug (RP-RUN-2). The caller embeds the id expression that the
# surrounding query defines for the bug id.
panel_clause() {
  printf '%s' "EXISTS (SELECT 1 FROM revision fp WHERE fp.bug_id = $1 AND fp.id = (SELECT MIN(f2.id) FROM revision f2 WHERE f2.bug_id = $1) AND fp.panel_run = '$(sql_quote "$2")')"
}

# parse_panel_run <value>   Stops when the value is empty; a panel run id is
# the identity of the selection, and an empty one selects nothing.
parse_panel_run() {
  [[ -n $1 ]] || { echo "cbugs: --panel-run must name a panel run id" >&2; exit 2; }
  printf '%s' "$1"
}

# validate_kind <kind> [allow-empty]   Stops with an error unless the kind is
# code, spec, or task. With allow-empty set to 1, an empty kind passes, for a
# caller that checks "required" itself.
validate_kind() {
  local allow_empty=${2:-0}
  [[ -z $1 && $allow_empty == 1 ]] && return 0
  [[ $1 == code || $1 == spec || $1 == task ]] || {
    echo "cbugs: --kind must be 'code', 'spec', or 'task', got '$1'" >&2
    exit 2
  }
}

# title_is_one_line <verb> <text>   Stops with an error when the text holds a
# newline. CB-REV-1.2 gives the title one line that names the defect.
title_is_one_line() {
  [[ $2 != *$'\n'* ]] || {
    echo "cbugs $1: --title must be one line; it holds a newline" >&2
    exit 2
  }
}

# validate_status <status>   Stops with an error unless the status is valid.
validate_status() {
  [[ $1 == open || $1 == closed || $1 == wontfix ]] || {
    echo "cbugs: --status must be 'open', 'closed', or 'wontfix', got '$1'" >&2
    exit 2
  }
}

# --------------------------------------------------------------- citations
#
# A citation is validated when the option is parsed, so a bad value fails
# before the command writes anything. CITE_PATHS and CITE_REQS hold the
# values of the current call, in order given, with an identical (path, id)
# pair recorded once.

CITE_PATHS=()
CITE_REQS=()

# add_citation <path[:id]>   Validates one --cite value and records it.
add_citation() {
  local value=$1 path req="" has_colon=0 test_path i
  if [[ $value == *:* ]]; then
    has_colon=1
    path=${value%:*}
    req=${value##*:}
  else
    path=$value
  fi
  if [[ -z $path ]]; then
    echo "cbugs: --cite '$value' has an empty path" >&2
    exit 2
  fi
  if ((has_colon)) && [[ -z $req ]]; then
    echo "cbugs: --cite '$value' has an empty identifier after the colon" >&2
    exit 2
  fi
  test_path=$path
  [[ $path == /* ]] || test_path="$RUN_DIR/$path"
  # The citation must name a requirements document, and a document is a
  # file: a directory names no file, so it fails the same test as a path
  # that no one invented a document under (CB-CITE-7).
  if [[ ! -f $test_path ]]; then
    echo "cbugs: --cite path '$path' names no file" >&2
    exit 2
  fi
  for i in ${CITE_PATHS[@]+"${!CITE_PATHS[@]}"}; do
    [[ ${CITE_PATHS[$i]} == "$path" && ${CITE_REQS[$i]} == "$req" ]] && return 0
  done
  CITE_PATHS+=("$path")
  CITE_REQS+=("$req")
}

# citation_sql   SQL that inserts the recorded citations against the revision
# that the surrounding statement is about to write. BEGIN IMMEDIATE holds the
# write lock for the whole script, so "the newest revision" stays the one
# this call just inserted until this same script commits.
citation_sql() {
  local out="" i req_sql
  for i in ${CITE_PATHS[@]+"${!CITE_PATHS[@]}"}; do
    if [[ -n ${CITE_REQS[$i]} ]]; then
      req_sql="'$(sql_quote "${CITE_REQS[$i]}")'"
    else
      req_sql="NULL"
    fi
    out+="
INSERT INTO citation (revision_id, path, req)
SELECT id, '$(sql_quote "${CITE_PATHS[$i]}")', $req_sql FROM revision ORDER BY id DESC LIMIT 1;"
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------- add

verb_add() {
  local title="" title_set=0 kind="" note="" note_set=0 commit="" commit_set=0 json=0
  while (($#)); do
    case $1 in
      --title) need_value "$1" $#; title=$2; title_set=1; shift 2 ;;
      --title=*) title=${1#*=}; title_set=1; shift ;;
      --kind) need_value "$1" $#; kind=$2; shift 2 ;;
      --kind=*) kind=${1#*=}; shift ;;
      --note) need_value "$1" $#; note=$2; note_set=1; shift 2 ;;
      --note=*) note=${1#*=}; note_set=1; shift ;;
      --cite) need_value "$1" $#; add_citation "$2"; shift 2 ;;
      --cite=*) add_citation "${1#*=}"; shift ;;
      --commit) need_value "$1" $#; commit=$2; commit_set=1; shift 2 ;;
      --commit=*) commit=${1#*=}; commit_set=1; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_add; exit 0 ;;
      *) echo "cbugs add: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  validate_kind "$kind" 1
  [[ -n $kind ]] || { echo "cbugs add: --kind is required" >&2; exit 2; }
  ((title_set)) || { echo "cbugs add: --title is required" >&2; exit 2; }
  [[ -n $title ]] || { echo "cbugs add: --title must not be empty" >&2; exit 2; }
  title_is_one_line add "$title"
  if [[ $kind == task && ${CONVERGE_ROLE+x} ]]; then
    echo "cbugs add: a task records a request from a human user; refused for role '$CONVERGE_ROLE'" >&2
    exit 1
  fi

  note=$(resolve_note add "$note_set" "$note") || exit $?
  provenance "$commit" "$commit_set"

  # The citation inserts that citation_sql adds below run after the revision
  # insert, so last_insert_rowid() no longer names the revision once they have
  # run: it names the last citation instead, and looks up the wrong bug. Read
  # the id the same way citation_sql finds its revision -- ORDER BY id DESC,
  # not last_insert_rowid() -- and read it before COMMIT, while BEGIN
  # IMMEDIATE still holds the write lock, so no concurrent add can be newer.
  local id
  id=$(sqlite3_run raw "
BEGIN IMMEDIATE;
INSERT INTO bug (kind) VALUES ('$(sql_quote "$kind")');
INSERT INTO revision (bug_id, status, title, note, role, iteration, commit_id, created_at, panel_run, panel_profile, panel_invocation)
VALUES (last_insert_rowid(), 'open', '$(sql_quote "$title")', '$(sql_quote "$note")', $ROLE_SQL, $ITERATION_SQL, $COMMIT_SQL, '$CREATED_AT', $PANEL_RUN_SQL, $PANEL_PROFILE_SQL, $PANEL_INVOCATION_SQL);
$(citation_sql)
SELECT bug_id FROM revision ORDER BY id DESC LIMIT 1;
COMMIT;
") || exit 1
  if ((json)); then
    printf '{"id": %s}\n' "$id"
  else
    printf '%s\n' "$id"
  fi
}

# ------------------------------------------------------ note and the status verbs

# write_revision <id> <status expr> <note>   Writes one revision. The caller
# changes only what it asks to change: a status verb gives the status
# literal, a note gives 'r.status' to keep the source status. Every other
# full-state value of the new revision comes from the newest revision
# visible at the resolved write commit (CB-REV-10, CB-PROV-7); when no
# revision of the bug is visible at that commit, from the newest stored
# revision. The new revision re-anchors the bug at the write commit.
write_revision() {
  local id=$1 status_expr=$2 note=$3
  local status_val title_val
  # The copy source. temp.visible_write holds the commits that the write
  # commit reaches (provenance), so the source revision is the newest
  # revision of this bug whose commit it reaches, seen when the verb began
  # the transaction and no caller can insert a newer one inside it.
  local source_pred
  source_pred=$(vis_pred write r)
  local source_where
  source_where="r.bug_id = $id AND ($source_pred)"
  if [[ -n ${TITLE_OVERRIDE:-} ]]; then
    title_val="'$(sql_quote "$TITLE_OVERRIDE")'"
  else
    title_val="COALESCE((SELECT r.title FROM revision r WHERE $source_where ORDER BY r.id DESC LIMIT 1), (SELECT r.title FROM revision r WHERE r.bug_id = $id ORDER BY r.id DESC LIMIT 1))"
  fi
  if [[ $status_expr == 'r.status' ]]; then
    status_val="COALESCE((SELECT r.status FROM revision r WHERE $source_where ORDER BY r.id DESC LIMIT 1), (SELECT r.status FROM revision r WHERE r.bug_id = $id ORDER BY r.id DESC LIMIT 1))"
  else
    status_val="$status_expr"
  fi
  local prelude=""
  [[ $VIS_WRITE == all ]] || prelude="$(vis_prelude write)
"
  sqlite3_run raw "${prelude}
BEGIN IMMEDIATE;
INSERT INTO revision (bug_id, status, title, note, role, iteration, commit_id, created_at, panel_run, panel_profile, panel_invocation)
VALUES ($id, $status_val, $title_val, '$(sql_quote "$note")', $ROLE_SQL, $ITERATION_SQL, $COMMIT_SQL, '$CREATED_AT', $PANEL_RUN_SQL, $PANEL_PROFILE_SQL, $PANEL_INVOCATION_SQL);
$(citation_sql)
COMMIT;
" >/dev/null
}

verb_note() {
  local id_arg="" note="" note_set=0 pos_note_set=0 commit="" commit_set=0 json=0 title_set=0
  TITLE_OVERRIDE=""
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_note; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_note; exit 2; }
  id_arg=$1; shift
  if [[ $# -ge 1 && $1 != -* ]]; then
    note=$1; note_set=1; pos_note_set=1; shift
  fi
  while (($#)); do
    case $1 in
      --note) need_value "$1" $#; ((pos_note_set)) || { note=$2; note_set=1; }; shift 2 ;;
      --note=*) ((pos_note_set)) || { note=${1#*=}; note_set=1; }; shift ;;
      --title) need_value "$1" $#; TITLE_OVERRIDE=$2; title_set=1; shift 2 ;;
      --title=*) TITLE_OVERRIDE=${1#*=}; title_set=1; shift ;;
      --cite) need_value "$1" $#; add_citation "$2"; shift 2 ;;
      --cite=*) add_citation "${1#*=}"; shift ;;
      --commit) need_value "$1" $#; commit=$2; commit_set=1; shift 2 ;;
      --commit=*) commit=${1#*=}; commit_set=1; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_note; exit 0 ;;
      *) echo "cbugs note: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  ((title_set)) && [[ -z $TITLE_OVERRIDE ]] && { echo "cbugs note: --title must not be empty" >&2; exit 2; }
  ((title_set)) && title_is_one_line note "$TITLE_OVERRIDE"
  local id; id=$(parse_id "$id_arg") || exit $?
  require_bug "$id"
  note=$(resolve_note note "$note_set" "$note") || exit $?
  provenance "$commit" "$commit_set"
  write_revision "$id" "r.status" "$note"
  print_bug "$id" "$json"
}

# verb_status_change <verb> <status> <args...>
verb_status_change() {
  local verb=$1 status=$2; shift 2
  local id_arg="" note="" note_set=0 commit="" commit_set=0 json=0 title_set=0
  TITLE_OVERRIDE=""
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_status_verb "$verb" "$status"; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_status_verb "$verb" "$status"; exit 2; }
  id_arg=$1; shift
  while (($#)); do
    case $1 in
      --note) need_value "$1" $#; note=$2; note_set=1; shift 2 ;;
      --note=*) note=${1#*=}; note_set=1; shift ;;
      --title) need_value "$1" $#; TITLE_OVERRIDE=$2; title_set=1; shift 2 ;;
      --title=*) TITLE_OVERRIDE=${1#*=}; title_set=1; shift ;;
      --cite) need_value "$1" $#; add_citation "$2"; shift 2 ;;
      --cite=*) add_citation "${1#*=}"; shift ;;
      --commit) need_value "$1" $#; commit=$2; commit_set=1; shift 2 ;;
      --commit=*) commit=${1#*=}; commit_set=1; shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_status_verb "$verb" "$status"; exit 0 ;;
      *) echo "cbugs $verb: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  ((title_set)) && [[ -z $TITLE_OVERRIDE ]] && { echo "cbugs $verb: --title must not be empty" >&2; exit 2; }
  ((title_set)) && title_is_one_line "$verb" "$TITLE_OVERRIDE"
  local id; id=$(parse_id "$id_arg") || exit $?
  require_bug "$id"
  if [[ $verb == reopen ]]; then
    local current_status
    current_status=$(sqlite3_run raw "$(vis_prelude head)
SELECT CASE WHEN c.id IS NOT NULL THEN c.status ELSE s.status END
FROM bug b
LEFT JOIN revision c ON c.id = (SELECT MAX(r2.id) FROM revision r2 WHERE r2.bug_id = b.id AND ($(vis_pred head r2)))
LEFT JOIN revision s ON s.id = (SELECT MAX(r3.id) FROM revision r3 WHERE r3.bug_id = b.id)
WHERE b.id = $id;") || exit 1
    case $current_status in
      open|closed|wontfix) ;;
      *) echo "cbugs reopen: bug #$id has invalid status '$current_status'" >&2; exit 2 ;;
    esac
  fi
  note=$(resolve_note "$verb" "$note_set" "$note") || exit $?
  provenance "$commit" "$commit_set"
  write_revision "$id" "'$status'" "$note"
  print_bug "$id" "$json"
}

# --------------------------------------------------------------- list, show, search

verb_list() {
  local json=0 panel_run="" visibility=visible visibility_set=0
  local -a kinds=() statuses=()
  while (($#)); do
    case $1 in
      --kind) need_value "$1" $#; kinds+=("$2"); shift 2 ;;
      --kind=*) kinds+=("${1#*=}"); shift ;;
      --status) need_value "$1" $#; statuses+=("$2"); shift 2 ;;
      --status=*) statuses+=("${1#*=}"); shift ;;
      --visibility)
        ((visibility_set)) && { echo "cbugs list: --visibility occurs more than once" >&2; exit 2; }
        need_value "$1" $#; visibility=$2; visibility_set=1; shift 2 ;;
      --visibility=*)
        ((visibility_set)) && { echo "cbugs list: --visibility occurs more than once" >&2; exit 2; }
        visibility=${1#*=}; visibility_set=1; shift ;;
      --panel-run) need_value "$1" $#; panel_run=$(parse_panel_run "$2"); shift 2 ;;
      --panel-run=*) panel_run=$(parse_panel_run "${1#*=}"); shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_list; exit 0 ;;
      *) echo "cbugs list: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local s
  for s in ${kinds[@]+"${kinds[@]}"}; do validate_kind "$s"; done
  for s in ${statuses[@]+"${statuses[@]}"}; do validate_status "$s"; done
  # CB-LIST-2.3: at most one --visibility, whose value selects the audit
  # interface. The normal listing is the visible one.
  case $visibility in
    visible|hidden|all) ;;
    *) echo "cbugs: --visibility must be 'visible', 'hidden', or 'all', got '$visibility'" >&2; exit 2 ;;
  esac
  # A --panel-run selection is the attribution list of one panel run
  # (RP-RUN-6): every bug that the run created, hidden ones included and
  # marked, so the controller selects new bugs by ids and not by a
  # visible-only list. A visible-only selection would drop a panel bug at
  # a later HEAD and break RP-OUT-10.
  [[ -n $panel_run && $visibility == visible ]] && visibility=all
  local rows extra
  extra=$(where_clause ${kinds[@]+"${kinds[@]}"} -- ${statuses[@]+"${statuses[@]}"})
  [[ -z $panel_run ]] || extra="${extra:+$extra AND }$(panel_clause t.id "$panel_run")"
  rows=$(sqlite3_run json "$(current_rows_sql "$visibility" "$extra")") || exit 1
  print_listing "$rows" "$json"
}

verb_show() {
  local id_arg="" json=0
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_show; exit 0; }
  [[ $# -ge 1 && $1 != -* ]] || { usage_show; exit 2; }
  id_arg=$1; shift
  while (($#)); do
    case $1 in
      --json) json=1; shift ;;
      -h|--help) usage_show; exit 0 ;;
      *) echo "cbugs show: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local id; id=$(parse_id "$id_arg") || exit $?
  require_bug "$id"

  local bug revs cites prelude=""
  [[ $VIS_HEAD == all ]] || prelude="$(vis_prelude head)
"
  # The bug's current state at the captured HEAD (CB-SHOW-5): the newest
  # visible revision, with the current revision id to mark it, and the
  # hidden flag when no revision is visible.
  bug=$(sqlite3_run json "${prelude}SELECT b.id, b.kind,
       CASE WHEN c.id IS NOT NULL THEN c.status ELSE NULL END AS status,
       CASE WHEN c.id IS NOT NULL THEN c.title ELSE NULL END AS title,
       (c.id IS NULL) AS hidden,
       c.id AS current_revision
FROM bug b
LEFT JOIN revision c ON c.id = (SELECT MAX(r2.id) FROM revision r2 WHERE r2.bug_id = b.id AND ($(vis_pred head r2)))
WHERE b.id = $id;") || exit 1
  # Every stored revision in order, each with its own visibility at the
  # captured HEAD (CB-SHOW-7): a revision with no commit is visible at
  # every HEAD, and a revision with a commit is visible when the set of
  # HEAD names it.
  revs=$(sqlite3_run json "${prelude}SELECT r.id, r.status, r.title, r.note, r.role, r.iteration, r.commit_id, r.created_at, r.panel_run, r.panel_profile, r.panel_invocation,
       ($(vis_pred head r)) AS visible
FROM revision r WHERE r.bug_id = $id ORDER BY r.id ASC;") || exit 1
  cites=$(sqlite3_run json "
SELECT c.revision_id, c.path, c.req
FROM citation c JOIN revision r ON r.id = c.revision_id
WHERE r.bug_id = $id ORDER BY c.id ASC;
") || exit 1
  # sqlite3 -json prints nothing at all, not "[]", when a query matches no
  # row. A bug with no citation on any revision must still show its
  # revisions, so jq --argjson needs a valid empty array here.
  [[ -n $cites ]] || cites='[]'
  # Every revision carries the citations that it wrote, so a reader of the
  # JSON sees which requirement each role named, and when, the same way the
  # human form does. The current flag rides along: the reader sees which
  # revision gives the current state at repository HEAD (CB-SHOW-5), and
  # every revision names why (CB-SHOW-7).
  revs=$(jq -M --argjson cites "$cites" --argjson current_revision "$(jq -r '.[0].current_revision' <<<"$bug")" '
    map(. as $r | $r + {
      citations: [$cites[] | select(.revision_id == $r.id) | {path, req}],
      current: ($r.id == $current_revision)
    })
  ' <<<"$revs")
  if ((json)); then
    jq -M --argjson revisions "$revs" '.[0] + {revisions: $revisions}' <<<"$bug"
    return
  fi

  local bid kind status title hidden
  # Individual jq reads, not one @tsv row: bash read treats consecutive
  # separators of a single-character IFS as one, so the empty status and
  # title of a hidden bug's row would shift every later field.
  bid=$(jq -r '.[0].id' <<<"$bug")
  kind=$(jq -r '.[0].kind' <<<"$bug")
  status=$(jq -r '.[0].status // empty' <<<"$bug")
  title=$(jq -r '.[0].title // empty' <<<"$bug")
  hidden=$(jq -r '.[0].hidden' <<<"$bug")
  if [[ $hidden == 1 || $hidden == true ]]; then
    # A hidden bug shows no revision as current at repository HEAD
    # (CB-SHOW-5): the header carries the hidden mark, and no status or
    # title rides with it.
    printf '%s#%s%s  %s%s%s  %shidden%s\n' "$BOLD" "$bid" "$OFF" "$DIM" "$kind" "$OFF" "$DIM" "$OFF"
  else
    printf '%s#%s%s  %s%s%s  %s  %s\n' "$BOLD" "$bid" "$OFF" "$DIM" "$kind" "$OFF" "$status" "$title"
  fi
  printf '\n%srevisions%s\n' "$BOLD" "$OFF"
  local rid rstatus rtitle rnote rrole riter rcommit rcreated meta rcite revision rtag
  local rpanelrun rpanelprofile rpanelinv rvisible
  while IFS= read -r revision; do
    rid=$(jq -r '.id' <<<"$revision")
    rstatus=$(jq -r '.status' <<<"$revision")
    rtitle=$(jq -r '.title' <<<"$revision")
    rrole=$(jq -r '.role // "-"' <<<"$revision")
    riter=$(jq -r '.iteration // "-"' <<<"$revision")
    rcommit=$(jq -r '.commit_id // "-"' <<<"$revision")
    rcreated=$(jq -r '.created_at' <<<"$revision")
    rpanelrun=$(jq -r '.panel_run // "-"' <<<"$revision")
    rpanelprofile=$(jq -r '.panel_profile // "-"' <<<"$revision")
    rpanelinv=$(jq -r '.panel_invocation // "-"' <<<"$revision")
    rvisible=$(jq -r '.visible' <<<"$revision")
    meta="?"
    [[ $rrole == "-" ]] || meta="$rrole"
    [[ $riter == "-" ]] || meta+=" iter $riter"
    [[ $rcommit == "-" ]] || meta+=" @${rcommit:0:8}"
    [[ $rpanelrun == "-" ]] || meta+=" panel run $rpanelrun"
    [[ $rpanelprofile == "-" ]] || meta+=" profile $rpanelprofile"
    [[ $rpanelinv == "-" ]] || meta+=" invocation $rpanelinv"
    # The visibility tag says why a revision does or does not give the
    # current state (CB-SHOW-7), and the current mark names the one that
    # does (CB-SHOW-5).
    if [[ $rvisible == 1 || $rvisible == true ]]; then
      if [[ $(jq -r '.current' <<<"$revision") == 1 || $(jq -r '.current' <<<"$revision") == true ]]; then
        rtag="${DIM} [current]${OFF}"
      else
        rtag="${DIM} [visible]${OFF}"
      fi
    else
      rtag="${DIM} [hidden]${OFF}"
    fi
    printf '  %s%s%s  %s  %s%s%s%s\n' "$DIM" "$rcreated" "$OFF" "$rstatus" "$DIM" "$meta" "$OFF" "$rtag"
    printf '    %s\n' "$rtitle"
    rnote=$(jq -r '.note' <<<"$revision")
    if [[ -n $rnote ]]; then
      while IFS= read -r line; do
        printf '      %s%s%s\n' "$DIM" "$line" "$OFF"
      done <<<"$rnote"
    fi
    while IFS= read -r rcite; do
      [[ -n $rcite ]] && printf '      %scite%s %s\n' "$DIM" "$OFF" "$rcite"
    done < <(jq -r '.citations[] | .path + (if .req then ":" + .req else "" end)' <<<"$revision")
  done < <(jq -c '.[]' <<<"$revs")
}

verb_search() {
  local text="" json=0 panel_run=""
  local -a kinds=() statuses=()
  [[ ${1:-} == -h || ${1:-} == --help ]] && { usage_search; exit 0; }
  need_tool python3 python
  [[ $# -ge 1 && $1 != -* ]] || { usage_search; exit 2; }
  text=$1; shift
  while (($#)); do
    case $1 in
      --kind) need_value "$1" $#; kinds+=("$2"); shift 2 ;;
      --kind=*) kinds+=("${1#*=}"); shift ;;
      --status) need_value "$1" $#; statuses+=("$2"); shift 2 ;;
      --status=*) statuses+=("${1#*=}"); shift ;;
      --visibility|--visibility=*)
        echo "cbugs search: --visibility is not a search option; audit history is 'cbugs list --visibility hidden|all'" >&2
        exit 2 ;;
      --panel-run) need_value "$1" $#; panel_run=$(parse_panel_run "$2"); shift 2 ;;
      --panel-run=*) panel_run=$(parse_panel_run "${1#*=}"); shift ;;
      --json) json=1; shift ;;
      -h|--help) usage_search; exit 0 ;;
      *) echo "cbugs search: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local s
  for s in ${kinds[@]+"${kinds[@]}"}; do validate_kind "$s"; done
  for s in ${statuses[@]+"${statuses[@]}"}; do validate_status "$s"; done

  # CB-SEARCH-5: the matched bugs are the visible ones, and only the text of
  # a visible revision can match; a match in a hidden revision makes no bug
  # match. The rows keep the visible-list row form: each row holds the
  # current state of the bug, in the order of the current revisions
  # (CB-SEARCH-6). CB-SEARCH-2: the casefold comparison happens in the
  # matcher below, on the visible revisions only.
  local prelude="" visrv
  [[ $VIS_HEAD == all ]] || prelude="$(vis_prelude head)
"
  visrv=$(vis_pred head rv)
  local where extra panel_extra=""
  [[ -z $panel_run ]] || panel_extra=" AND $(panel_clause b.id "$panel_run")"
  where=$(where_clause ${kinds[@]+"${kinds[@]}"} -- ${statuses[@]+"${statuses[@]}"})
  # The filter sits inside the current-row subquery, where both revision
  # aliases have status columns. Apply status to the selected current state.
  where=${where//status IN/CASE WHEN c.id IS NOT NULL THEN c.status ELSE s.status END IN}
  rows=$(sqlite3_run json "${prelude} SELECT json_object(
   'id', t.id, 'kind', t.kind, 'status', t.status, 'title', t.title,
   'revisions', (SELECT json_group_array(json_object(
     'title', rv.title, 'note', rv.note,
     'citations', (SELECT json_group_array(json_object(
       'path', cx.path, 'req', cx.req
     )) FROM citation cx WHERE cx.revision_id = rv.id)
   )) FROM revision rv WHERE rv.bug_id = t.id AND ($visrv))
 ) AS value
 FROM (
   SELECT b.id AS id, b.kind AS kind,
       CASE WHEN c.id IS NOT NULL THEN c.status ELSE s.status END AS status,
       CASE WHEN c.id IS NOT NULL THEN c.title ELSE s.title END AS title,
       c.id AS cur_id
   FROM bug b
   LEFT JOIN revision c ON c.id = (SELECT MAX(r2.id) FROM revision r2 WHERE r2.bug_id = b.id AND ($(vis_pred head r2)))
   LEFT JOIN revision s ON s.id = (SELECT MAX(r3.id) FROM revision r3 WHERE r3.bug_id = b.id)
   WHERE c.id IS NOT NULL${where:+ AND $where}$panel_extra
 ) AS t
 ORDER BY t.cur_id DESC;
 ") || exit 1
  rows=$(python3 -c '
import json, sys
needle = sys.argv[1].casefold()
result = []
for record in json.load(sys.stdin):
    bug = json.loads(record["value"])
    texts = []
    for revision in bug.pop("revisions"):
        texts.extend((revision.get("title") or "", revision.get("note") or ""))
        for citation in revision.get("citations") or []:
            texts.extend((citation.get("path") or "", citation.get("req") or ""))
    if any(needle in t.casefold() for t in texts):
        result.append(bug)
print(json.dumps(result, ensure_ascii=False))
' "$text" <<<"${rows:-[]}") || {
    # A python3 that exits non-zero -- absent-but-shimmed, a broken
    # interpreter, or a crash on the input -- names no answer. An empty
    # listing would read as the normal empty answer of CB-OUT-6, so stop
    # and say why; the interpreter's own stderr already reached the caller.
    echo "cbugs: search failed: python3 exited with status $?" >&2
    exit 1
  }
  print_listing "$rows" "$json"

}

# ------------------------------------------------------------- reviewed verbs
#
# The database holds the commits that a review pass of converge covered, as
# CB-RVW-1 gives. The loop records them, and no agent records one: a call
# of reviewed add from an agent of the loop stops with an error. reviewed
# pending changes nothing, and every caller may run it.

# count_pending <json>   One shared reader for both forms: prints one line
# per unreviewed commit -- "<hash>\t<subject>" -- or nothing, and exits 0,
# when no commit is unreviewed and the considered history holds no relevant
# commit (CB-RVW-8). A relevant commit changes one or more paths in the run
# directory, and every commit that the repository HEAD reaches is relevant
# when the run directory is the root of the repository. The considered
# history holds the 1,000 newest relevant commits, and not the older ones,
# whatever rows exist for them (CB-RVW-8). The command reads the repository
# at the time of the call: git rev-list walks HEAD now, and the rows of the
# reviewed table are the names that no pass recorded yet.
count_pending() {
  local -a pending=()
  local reachable="" row hash subject rel
  # A newly initialized repository has a symbolic HEAD but no commit to
  # walk. It has no relevant commits yet, which is an empty successful result
  # under CB-RVW-8; a broken or unreadable existing history still errors.
  if ! git -C "$REPO" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    if git -C "$REPO" symbolic-ref -q HEAD >/dev/null 2>&1; then
      return 0
    fi
    echo "cbugs: cannot read repository history" >&2
    return 1
  fi
  # The commits of a run directory that sits beside the root are the ones
  # that change a path under it. A commit that touches no such path is not
  # pending, however near the root of the repository it sits. --max-count
  # cuts the walk at the 1,000 newest relevant commits, older than the
  # 1,000th relevant commit nothing is considered.
  if [[ $REPO == "$RUN_DIR" ]]; then
    if ! reachable=$(git -C "$REPO" rev-list --max-count=1000 HEAD 2>"$ERRFILE"); then
      echo "cbugs: cannot read repository history" >&2
      while IFS= read -r row; do
        [[ -n $row ]] && echo "cbugs: $row" >&2
      done <"$ERRFILE"
      return 1
    fi
  else
    rel=${RUN_DIR#"$REPO"/}
    if ! reachable=$(git -C "$REPO" rev-list --max-count=1000 HEAD -- ":(top,literal)$rel" 2>"$ERRFILE"); then
      echo "cbugs: cannot read repository history" >&2
      while IFS= read -r row; do
        [[ -n $row ]] && echo "cbugs: $row" >&2
      done <"$ERRFILE"
      return 1
    fi
  fi
  # No commit, no reachable history, or no relevant commit: print nothing,
  # exit 0.
  [[ -n $reachable ]] || return 0
  while IFS= read -r row; do
    [[ -n $row ]] && pending+=("$row")
  done <<<"$reachable"
  # A row names one commit, and nothing else can name the same one, so the
  # names land in a set keyed by the full hash.
  local -A named=()
  local rows_out
  rows_out=$(sqlite3_run raw "SELECT commit_id FROM reviewed;") || exit 1
  while IFS= read -r row; do
    [[ -n $row ]] && named[$row]=1
  done <<<"$rows_out"
  local -a unseen=()
  for row in ${pending[@]+"${pending[@]}"}; do
    [[ -n ${named[$row]:-} ]] || unseen+=("$row")
  done
  ((${#unseen[@]} > 0)) || return 0
  # One batched git call reads every subject, so the pending list stops
  # meaning one git process per commit. The call names the same records the
  # rev-list above named, and a failed read stops the verb as a repository
  # read failure rather than printing rows with empty subjects.
  local -A subject_of=()
  local batch_out
  if ! batch_out=$(
      printf '%s\n' "${unseen[@]}" |
        git -C "$REPO" log --stdin --no-walk=unsorted --format='%H%x09%s' 2>"$ERRFILE"); then
    echo "cbugs: cannot read repository history" >&2
    while IFS= read -r row; do
      [[ -n $row ]] && echo "cbugs: $row" >&2
    done <"$ERRFILE"
    return 1
  fi
  while IFS= read -r row; do
    [[ -n $row ]] || continue
    hash=${row%%$'\t'*}
    subject_of[$hash]=${row#*$'\t'}
  done <<<"$batch_out"
  for hash in ${unseen[@]+"${unseen[@]}"}; do
    printf '%s\t%s\n' "$hash" "${subject_of[$hash]:-}"
  done
}

verb_reviewed_pending() {
  local json=0 line
  while (($#)); do
    case $1 in
      --json) json=1; shift ;;
      -h|--help) usage_reviewed_pending; exit 0 ;;
      *) echo "cbugs reviewed pending: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  local -a lines=() elems=()
  local pending_out
  # The call substitution carries the status of count_pending, so a database
  # error stops the verb with a non-zero status (CB-ERR-2), and does not
  # leave an empty listing that holds the status 0 against CB-RVW-8.
  pending_out=$(count_pending) || exit 1
  if [[ -n $pending_out ]]; then
    mapfile -t lines <<<"$pending_out"
  fi
  ((${#lines[@]} > 0)) || exit 0
  if ((json)); then
    for line in ${lines[@]+"${lines[@]}"}; do
      hash=${line%%$'\t'*}
      subject=${line#*$'\t'}
      elems+=("$(jq -Mcn --arg c "$hash" --arg s "$subject" '{commit_id: $c, subject: $s}')")
    done
    printf '%s\n' "${elems[@]}" | jq -M -s .
    exit 0
  fi
  for line in ${lines[@]+"${lines[@]}"}; do
    printf '%s %s\n' "${line%%$'\t'*}" "${line#*$'\t'}"
  done
  exit 0
}

verb_reviewed_add() {
  local iter="" json=0 value profile="" profile_set=0 completed_at="" completed_at_set=0
  local -a commits=() named=() resolved=() absent=()
  while (($#)); do
    case $1 in
      --iteration) need_value "$1" $#; iter=$2; shift 2 ;;
      --iteration=*) iter=${1#*=}; shift ;;
      --profile)
        ((! profile_set)) || { echo "cbugs reviewed add: --profile given more than once" >&2; exit 2; }
        need_value "$1" $#; profile=$2; profile_set=1; shift 2
        ;;
      --profile=*)
        ((! profile_set)) || { echo "cbugs reviewed add: --profile given more than once" >&2; exit 2; }
        profile=${1#*=}; profile_set=1; shift
        ;;
      --completed-at)
        ((! completed_at_set)) || { echo "cbugs reviewed add: --completed-at given more than once" >&2; exit 2; }
        need_value "$1" $#; completed_at=$2; completed_at_set=1; shift 2
        ;;
      --completed-at=*)
        ((! completed_at_set)) || { echo "cbugs reviewed add: --completed-at given more than once" >&2; exit 2; }
        completed_at=${1#*=}; completed_at_set=1; shift
        ;;
      --json) json=1; shift ;;
      -h|--help) usage_reviewed_add; exit 0 ;;
      -*) echo "cbugs reviewed add: unexpected argument '$1'" >&2; exit 2 ;;
      *) commits+=("$1"); shift ;;
    esac
  done
  [[ -z $iter ]] || is_number "$iter" || {
    echo "cbugs reviewed add: --iteration needs a whole number, got '$iter'" >&2
    exit 2
  }
  # A supplied profile must be harness:model[:effort], where the harness is
  # claude, opencode, or codex and every field is nonempty with no colon, comma, or
  # whitespace; a slash is allowed. The command stores the caller's string
  # unchanged (CB-RVW-19). This runs before any commit is resolved, so an
  # invalid profile fails before any record is written.
  if ((profile_set)); then
    [[ $profile =~ ^(claude|opencode|codex):[^:,[:space:]]+(:[^:,[:space:]]+)?$ ]] || {
      echo "cbugs reviewed add: --profile '$profile' must be claude:model[:effort], opencode:model[:effort], or codex:model[:effort], with nonempty fields and no colon, comma, or whitespace" >&2
      exit 2
    }
  fi
  # A supplied completion time must be a valid UTC date and time in
  # YYYY-MM-DDTHH:MM:SSZ form (CB-RVW-15). Re-formatting the parsed value and
  # comparing it back catches a calendar date that does not exist, which GNU
  # date would otherwise silently normalize.
  if ((completed_at_set)); then
    local reformatted=""
    if [[ $completed_at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
      reformatted=$(date -u -d "$completed_at" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
    fi
    [[ -n $reformatted && $reformatted == "$completed_at" ]] || {
      echo "cbugs reviewed add: --completed-at '$completed_at' must be a valid UTC timestamp in YYYY-MM-DDTHH:MM:SSZ form" >&2
      exit 2
    }
  fi
  # The loop records the commits of a pass, and no agent of the loop records
  # one. The error names the role that the call read. reviewed pending
  # changes nothing, so every caller may run it (CB-RVW-7).
  if [[ ${CONVERGE_ROLE+x} ]]; then
    echo "cbugs reviewed add: the loop records the commits of a pass, and no agent of the loop records one; refused for role '$CONVERGE_ROLE'" >&2
    exit 1
  fi
  # The values come as arguments, or one per line on standard input (CB-RVW-6).
  # A call that names the commits as arguments reads no standard input: an
  # operator who runs the call on a terminal must not wait for EOF, in the
  # way that CB-WRITE-3 gives for the note of the write verbs.
  if ((0 == ${#commits[@]})); then
    if [[ -t 0 ]]; then
      echo "cbugs reviewed add: name the commits to record, as arguments or on standard input, one per line" >&2
      exit 2
    fi
    while IFS= read -r value || [[ -n $value ]]; do
      commits+=("$value")
    done
  fi
  # One commit is one value: the same value twice, or two values that name
  # the same commit, add one row and count once. An empty value names no
  # commit of the repository (CB-RVW-10), and it must say so before the
  # subscripted dedup read below: an empty key fails the expansion of both
  # the guard and the assignment, and a failed assignment expansion aborts
  # the whole script inside the loop, with no message that names the cause
  # (bug 42).
  local -A seen=()
  for value in ${commits[@]+"${commits[@]}"}; do
    [[ -n $value ]] || {
      echo "cbugs reviewed add: '$value' names no commit of the repository" >&2
      exit 2
    }
    [[ -n ${seen[$value]:-} ]] || { seen[$value]=1; named+=("$value"); }
  done
  ((0 < ${#named[@]})) || {
    echo "cbugs reviewed add: name the commits to record, as arguments or on standard input, one per line" >&2
    exit 2
  }
  # Resolve every value before the transaction writes anything, so a call
  # that names an unknown commit records nothing (CB-RVW-10). The messages
  # name the value the caller gave, so resolution keeps each candidate in a
  # second variable.
  local -A resolved_seen=() candidate
  for value in ${named[@]+"${named[@]}"}; do
    candidate=$(git -C "$REPO" rev-parse --verify "${value}^{commit}" 2>/dev/null) || {
      echo "cbugs reviewed add: '$value' names no commit of the repository" >&2
      exit 2
    }
    [[ -n ${resolved_seen[$candidate]:-} ]] || {
      resolved_seen[$candidate]=1
      resolved+=("$candidate")
    }
  done
  CREATED_AT=$completed_at
  ((completed_at_set)) || CREATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  # One transaction for the whole call (CB-RVW-13). The EXISTS probes run
  # inside it, so the printed counts describe the database under the write
  # lock, and no concurrent call can slip between "already covered" and the
  # insert. Every distinct resolved commit gets one new, immutable record in
  # this call, even when a row already names it (CB-RVW-12). A temp table
  # holds the candidates: SQLite gives a VALUES table no alias to name its
  # column with, and both statements below read the same names.
  local values_sql="" out hash profile_sql=NULL
  ((! profile_set)) || profile_sql="'$(sql_quote "$profile")'"
  for hash in ${resolved[@]+"${resolved[@]}"}; do
    values_sql+="${values_sql:+,}('$(sql_quote "$hash")')"
  done
  out=$(sqlite3_run raw "
BEGIN IMMEDIATE;
DROP TABLE IF EXISTS temp.reviewed_add;
CREATE TEMP TABLE reviewed_add (c TEXT NOT NULL);
INSERT INTO reviewed_add (c) VALUES $values_sql;
SELECT EXISTS(SELECT 1 FROM reviewed WHERE commit_id = reviewed_add.c) FROM reviewed_add;
INSERT INTO reviewed (commit_id, iteration, created_at, profile)
SELECT c, ${iter:-NULL}, '$CREATED_AT', $profile_sql FROM reviewed_add;
COMMIT;
") || exit 1
  # Every commit answers one probe line: whether a row already named it
  # before this call. added counts every new record this call wrote, which
  # is one per distinct resolved commit; already counts input commits that
  # had any record before the call (CB-RVW-17).
  local already=0 n=${#resolved[@]} i
  local -a probe_rows=()
  mapfile -t probe_rows <<<"$out"
  for ((i = 0; i < n; i++)); do
    [[ ${probe_rows[$i]} == 1 ]] && ((++already))
  done
  if ((json)); then
    local -a profile_arg=(--arg profile "" --argjson has_profile false)
    ((! profile_set)) || profile_arg=(--arg profile "$profile" --argjson has_profile true)
    jq -Mcn --argjson added "$n" --argjson already "$already" --arg created_at "$CREATED_AT" \
      "${profile_arg[@]}" \
      '{added: $added, already: $already, profile: (if $has_profile then $profile else null end), created_at: $created_at}'
  else
    printf 'added %s, %s that a row already named, profile %s, completed at %s\n' \
      "$(plural "$n" commit)" "$(plural "$already" commit)" "${profile:-unknown}" "$CREATED_AT"
  fi
}

# verb_summary   Prints what a caller most probably wants when it runs cbugs
# with no argument: the ten open visible bugs with the newest current
# revision, in every kind, then a short footer naming the other verbs and,
# when hidden bugs exist, the audit line (CB-SUM-8, CB-SUM-9). Current
# state comes from the newest revision visible at the captured HEAD
# (CB-VIS-1 through CB-VIS-8); all counts exclude hidden bugs. Takes no
# option, has no --json form, and always exits 0.
verb_summary() {
  local rows total hidden_pre hidden_total n
  rows=$(sqlite3_run json "$(current_rows_sql visible "status = 'open'" 10)") || exit 1
  [[ -n $rows ]] || rows='[]'
  n=$(jq 'length' <<<"$rows")
  # "status = 'open'" filtered the last LIMIT of the wrapped rows: the total
  # count must run over every open visible bug, not just the shown ones.
  local count_pre=""
  [[ $VIS_HEAD == all ]] || count_pre="$(vis_prelude head)
"
  total=$(sqlite3_run raw "${count_pre}SELECT COUNT(*) FROM ($(current_inner_sql visible "status = 'open'"));") || exit 1
  total=${total:-0}
  is_number "$total" || total=0
  # A hidden bug stays out of every count above (CB-SUM-8), but the footer
  # must name it and its audit command when one exists (CB-SUM-9).
  hidden_pre=""
  [[ $VIS_HEAD == all ]] || hidden_pre="$(vis_prelude head)
"
  hidden_total=$(sqlite3_run raw "${hidden_pre}SELECT COUNT(*) FROM bug b
LEFT JOIN revision c ON c.id = (SELECT MAX(r2.id) FROM revision r2 WHERE r2.bug_id = b.id AND ($(vis_pred head r2)))
WHERE c.id IS NULL;") || exit 1
  hidden_total=${hidden_total:-0}
  is_number "$hidden_total" || hidden_total=0

  if ((n > 0)); then
    local id kind status title hidden
    while IFS=$'\t' read -r id kind status title hidden; do
      row_line "$id" "$kind" "$status" "$title" "$hidden"
    done < <(jq -r '.[] | [.id, .kind, .status, .title, (.hidden // false)] | @tsv' <<<"$rows")
  else
    printf '%sno bug is open%s\n' "$DIM" "$OFF"
  fi

  if ((total > n)); then
    local rest=$((total - n)) word=bugs
    ((rest == 1)) && word=bug
    printf '%s%s more open %s; see cbugs list --status open%s\n' \
      "$DIM" "$rest" "$word" "$OFF"
  fi
  if ((hidden_total > 0)); then
    local hword=bugs
    ((hidden_total == 1)) && hword=bug
    printf '%s%s hidden %s stored without a visible revision; see cbugs list --visibility hidden%s\n' \
      "$DIM" "$hidden_total" "$hword" "$OFF"
  fi
  printf '%sVerbs: add, list, show, search, note, close, dismiss, reopen, reviewed add, reviewed pending.%s\n' "$DIM" "$OFF"
  printf '%sRun %scbugs --help%s%s for the options of each.%s\n' "$DIM" "$BOLD" "$OFF" "$DIM" "$OFF"
}

# ------------------------------------------------------------------- dispatch

if (($# == 0)); then
  verb_summary
  exit 0
fi
VERB=$1; shift
case $VERB in
  -h|--help) usage; exit 0 ;;
  add) verb_add "$@" ;;
  note) verb_note "$@" ;;
  close) verb_status_change close closed "$@" ;;
  dismiss) verb_status_change dismiss wontfix "$@" ;;
  reopen) verb_status_change reopen open "$@" ;;
  list) verb_list "$@" ;;
  show) verb_show "$@" ;;
  search) verb_search "$@" ;;
  reviewed)
    # The reviewed verb holds two sub-verbs (CB-RVW-5): a bare 'reviewed'
    # names no verb on its own and must say which two exist. Both sub-verbs
    # read the repository (CB-RVW-8, CB-RVW-10), so a call that answers must
    # find git on PATH: without it, pending would print nothing under a
    # silence that reads as an answer (CB-PLAT-2). But 'reviewed add --help'
    # and 'reviewed pending --help' must work without git too (CB-INV-7), the
    # same as every other verb's --help, so the check is skipped when the
    # top-level scan already found -h/--help among the arguments.
    case ${1:-} in
      add) shift; ((HELP_REQUESTED)) || need_tool git git; verb_reviewed_add "$@" ;;
      pending) shift; ((HELP_REQUESTED)) || need_tool git git; verb_reviewed_pending "$@" ;;
      -h|--help) usage_reviewed; exit 0 ;;
      "")
        echo "cbugs reviewed: name a sub-verb: 'reviewed add' or 'reviewed pending'" >&2
        exit 2
        ;;
      *)
        echo "cbugs reviewed: no such sub-verb 'reviewed ${1:-}'; use 'reviewed add' or 'reviewed pending'" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    # No verb is a whole number, so a bare id can never collide with one. A
    # reader who saw the id in a listing can type it alone.
    if is_number "$VERB"; then
      verb_show "$VERB" "$@"
    else
      echo "cbugs: no such verb '$VERB'" >&2
      usage
      exit 2
    fi
    ;;
esac
